<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Signage CMS - Canvas Editor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@700;900&family=Inter:wght@400;500;600;700&family=Open+Sans:wght@400;700&family=Bebas+Neue&family=Bangers&family=Luckiest+Guy&family=Titan+One&family=Carter+One&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .input-field {
            background: #0f172a;
            border: 1px solid #334155;
            color: white;
            padding: 0.5rem;
            border-radius: 0.375rem;
            width: 100%;
            outline: none;
            font-size: 0.875rem;
        }

        .input-field:focus {
            border-color: #3b82f6;
        }

        .select-field {
            background: #0f172a;
            border: 1px solid #334155;
            color: white;
            padding: 0.5rem;
            border-radius: 0.375rem;
            width: 100%;
            outline: none;
            font-size: 0.875rem;
        }

        input[type=range] {
            accent-color: #3b82f6;
            width: 100%;
        }

        .component-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid #334155;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: border-color 0.2s;
        }

        .component-card.active-card {
            border-color: #3b82f6;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
        }

        /* Live Preview CSS */
        .tv-mockup {
            background-color: #050505;
            background-image: radial-gradient(circle at 50% 60%, #1a1a1a 0%, #000000 100%);
            border: 2px solid #334155;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            font-family: 'Oswald', sans-serif;
            overflow: hidden;
        }

        .mock-light {
            position: absolute;
            top: -50%;
            left: 50%;
            width: 800px;
            height: 2000px;
            background: linear-gradient(90deg, transparent, rgba(255, 199, 44, 0.05), transparent);
            transform: rotate(35deg) translateX(-50%);
            z-index: 1;
            pointer-events: none;
        }

        .mock-glow {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -40%);
            width: 1200px;
            height: 800px;
            border-radius: 50%;
            filter: blur(120px);
            background: rgba(218, 41, 28, 0.4);
            z-index: 2;
            pointer-events: none;
        }

        .mock-badge {
            font-size: 2.5rem;
            padding: 8px 30px;
            border-radius: 8px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: 900;
        }

        .mock-title {
            font-size: 8rem;
            line-height: 0.9;
            text-transform: uppercase;
            margin: 0;
            background: linear-gradient(to bottom, #ffffff, #d4d4d4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 900;
        }

        .mock-desc {
            font-size: 3rem;
            font-weight: 700;
            color: #DA291C;
            margin-top: 15px;
        }

        .mock-price {
            position: absolute;
            bottom: 80px;
            left: 150px;
            width: 300px;
            height: 300px;
            background: #FFC72C;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 8px solid #DA291C;
            z-index: 50;
            transform: rotate(-10deg);
            color: #111;
            pointer-events: none;
        }

        .mock-price span {
            font-size: 10rem;
            font-weight: 900;
            line-height: 0.8;
            margin-top: 20px;
        }

        .preview-item {
            cursor: grab;
            transition: outline 0.1s;
        }

        .preview-item:active {
            cursor: grabbing;
        }

        .preview-item.active-item {
            outline: 6px dashed #3b82f6;
            outline-offset: 10px;
            border-radius: 20px;
        }

        /* Continuous Animations */
        @keyframes anim-float {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        @keyframes anim-pulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }
        }

        @keyframes anim-spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        @keyframes anim-breathe {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.02);
            }
        }

        @keyframes anim-swing {
            20% {
                transform: rotate(15deg);
            }

            40% {
                transform: rotate(-10deg);
            }

            60% {
                transform: rotate(5deg);
            }

            80% {
                transform: rotate(-5deg);
            }

            100% {
                transform: rotate(0deg);
            }
        }

        @keyframes anim-heartbeat {

            0%,
            28%,
            70% {
                transform: scale(1);
            }

            14%,
            42% {
                transform: scale(1.15);
            }
        }

        @keyframes anim-glow {

            0%,
            100% {
                filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.2)) brightness(1);
            }

            50% {
                filter: drop-shadow(0 0 20px rgba(255, 255, 255, 0.8)) brightness(1.2);
            }
        }

        @keyframes anim-wobble {

            0%,
            100% {
                transform: translateX(0%);
            }

            15% {
                transform: translateX(-10%) rotate(-5deg);
            }

            30% {
                transform: translateX(8%) rotate(3deg);
            }

            45% {
                transform: translateX(-6%) rotate(-3deg);
            }

            60% {
                transform: translateX(4%) rotate(2deg);
            }

            75% {
                transform: translateX(-2%) rotate(-1deg);
            }
        }

        @keyframes anim-bounce-slow {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-30px);
            }
        }

        @keyframes anim-float-x {

            0%,
            100% {
                transform: translateX(0);
            }

            50% {
                transform: translateX(20px);
            }
        }

        @keyframes anim-flip {
            0% {
                transform: perspective(400px) rotateY(0);
            }

            100% {
                transform: perspective(400px) rotateY(360deg);
            }
        }

        @keyframes anim-shake {

            0%,
            100% {
                transform: translateX(0);
            }

            10%,
            30%,
            50%,
            70%,
            90% {
                transform: translateX(-5px);
            }

            20%,
            40%,
            60%,
            80% {
                transform: translateX(5px);
            }
        }

        .anim-float {
            animation: anim-float 4s ease-in-out infinite !important;
        }

        .anim-pulse {
            animation: anim-pulse 2s ease-in-out infinite !important;
        }

        .anim-spin {
            animation: anim-spin 10s linear infinite !important;
        }

        .anim-breathe {
            animation: anim-breathe 6s ease-in-out infinite !important;
        }

        .anim-swing {
            animation: anim-swing 4s ease-in-out infinite !important;
            transform-origin: top center;
        }

        .anim-heartbeat {
            animation: anim-heartbeat 2.5s ease-in-out infinite !important;
        }

        .anim-glow {
            animation: anim-glow 3s ease-in-out infinite !important;
        }

        .anim-wobble {
            animation: anim-wobble 4s ease-in-out infinite !important;
        }

        .anim-bounce-slow {
            animation: anim-bounce-slow 3s ease-in-out infinite !important;
        }

        .anim-float-x {
            animation: anim-float-x 4s ease-in-out infinite !important;
        }

        .anim-flip {
            animation: anim-flip 5s linear infinite !important;
        }

        .anim-shake {
            animation: anim-shake 6s ease-in-out infinite !important;
        }

        .anim-spin-fast {
            animation: anim-spin 2s linear infinite !important;
        }

        .anim-spin-reverse {
            animation: anim-spin 10s linear infinite reverse !important;
        }

        .tv-mockup {
            transform: scale(0.45);
        }

        .mockup-wrapper {
            width: 864px;
            height: 486px;
        }

        .mockup-wrapper:fullscreen,
        .mockup-wrapper:-webkit-full-screen,
        .fake-fullscreen {
            width: 100vw !important;
            height: 100vh !important;
            display: flex;
            align-items: center;
            justify-content: center;
            background: black;
            border: none;
            border-radius: 0;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            z-index: 99999 !important;
        }

        .mockup-wrapper:fullscreen .tv-mockup,
        .mockup-wrapper:-webkit-full-screen .tv-mockup,
        .fake-fullscreen .tv-mockup {
            transform: scale(min(calc(100vw / 1920), calc(100vh / 1080))) !important;
            transform-origin: center center !important;
            left: 50% !important;
            top: 50% !important;
            margin-left: -960px !important;
            /* half of 1920 */
            margin-top: -540px !important;
            /* half of 1080 */
        }

        .exit-fs-btn {
            display: none;
        }

        .mockup-wrapper:fullscreen .exit-fs-btn,
        .mockup-wrapper:-webkit-full-screen .exit-fs-btn,
        .fake-fullscreen .exit-fs-btn,
        .editor-fullscreen .exit-fs-btn {
            display: flex !important;
            align-items: center;
            justify-content: center;
        }

        @media (max-width: 768px) {
            .mockup-wrapper {
                width: 345px !important;
                height: 194px !important;
                margin: 0 auto;
            }

            .tv-mockup {
                transform: scale(0.18) !important;
            }

            .main-layout {
                flex-direction: column !important;
                overflow: auto !important;
            }

            .dashboard-sidebar {
                width: 100% !important;
                border-right: none !important;
                border-bottom: 1px solid #334155;
            }

            .dashboard-sidebar .tab-container {
                display: flex;
                overflow-x: auto;
            }

            .dashboard-sidebar button {
                white-space: nowrap;
                flex-shrink: 0;
                padding: 10px 15px !important;
                border-left: none !important;
                border-bottom: 4px solid transparent;
            }

            .dashboard-sidebar button.active-tab {
                border-bottom-color: #3b82f6 !important;
                background: rgba(30, 41, 59, 0.5);
            }

            .dashboard-sidebar .cat-header {
                display: none;
            }

            .content-area {
                padding: 1rem !important;
                overflow-y: visible !important;
            }

            .controls-panel {
                flex-direction: column-reverse !important;
            }

            .mockup-wrapper-container {
                margin: 0 auto 1.5rem auto;
                width: 100%;
                display: flex;
                justify-content: center;
            }

            .formule-header-inputs {
                flex-direction: column;
                gap: 10px !important;
            }

            .formule-header-inputs>div {
                width: 100% !important;
            }

            .navbar-text {
                display: none;
            }
        }

        @keyframes highlight-wiggle {
            0% {
                filter: brightness(1);
                transform: scale(1);
            }

            50% {
                filter: brightness(1.5);
                transform: scale(1.15);
                box-shadow: 0 0 40px rgba(255, 255, 255, 0.8);
            }

            100% {
                filter: brightness(1);
                transform: scale(1);
            }
        }

        .highlight-wiggle {
            animation: highlight-wiggle 0.5s ease-in-out !important;
            z-index: 9999 !important;
        }

        /* Pause for infinite animations */
        .editor-paused .anim-float,
        .editor-paused .anim-pulse,
        .editor-paused .anim-spin,
        .editor-paused .anim-bounce,
        .editor-paused .anim-wiggle {
            animation-play-state: paused !important;
        }

        /* Fullscreen Editor Mode */
        .editor-fullscreen nav,
        .editor-fullscreen .dashboard-sidebar {
            display: none !important;
        }
        .editor-fullscreen .main-layout {
            flex-direction: column;
            width: 100vw;
            height: 100vh;
        }
        .editor-fullscreen .mockup-wrapper {
            position: fixed !important;
            top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            z-index: 10;
            margin: 0 !important;
            border-radius: 0 !important;
            background: #000;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .editor-fullscreen .tv-mockup {
            position: relative !important;
            top: auto !important;
            left: auto !important;
            transform-origin: center center !important;
        }

        /* Libérer le position: fixed des conteneurs parents */
        .editor-fullscreen .glass-panel,
        .editor-fullscreen .backdrop-blur-md {
            backdrop-filter: none !important;
            filter: none !important;
            transform: none !important;
        }
        
        .editor-fullscreen .sticky {
            position: static !important;
        }
        
        .editor-fullscreen .z-40 {
            z-index: auto !important;
        }

        .editor-fullscreen .tv-mockup[style*="1920px"] {
            transform: scale(var(--fs-scale-1920, 1)) !important;
        }

        .editor-fullscreen .tv-mockup[style*="1080px; height: 1920px"],
        .editor-fullscreen .tv-mockup[style*="height: 1920px"] {
            transform: scale(var(--fs-scale-1080, 1)) !important;
        }
        .editor-fullscreen .fs-floating-panel {
            position: fixed !important;
            z-index: 100 !important;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            background: rgba(15, 23, 42, 0.9) !important;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: auto !important;
            min-width: 300px;
            min-height: 200px;
            max-width: 90vw;
            max-height: 90vh;
        }
        .fs-drag-handle {
            cursor: move;
        }
    </style>
    <script src="/effects.js?v=3"></script>
    <script>
        function updateFsScale() {
            const scale1920 = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
            const scale1080 = Math.min(window.innerWidth / 1080, window.innerHeight / 1920);
            document.documentElement.style.setProperty('--fs-scale-1920', scale1920);
            document.documentElement.style.setProperty('--fs-scale-1080', scale1080);
        }
        window.addEventListener('resize', updateFsScale);
        window.addEventListener('DOMContentLoaded', updateFsScale);
        updateFsScale();
    </script>
</head>

<body>
    <div id="app" class="min-h-screen flex flex-col relative" :class="{'editor-fullscreen': isFullscreenEditor}">

        <!-- Floating Scroll to Preview Button (Only visible on mobile) -->
        <button @click="scrollToPreview()" v-if="currentTab === 'tv2'"
            class="fixed bottom-6 right-6 z-[100] bg-blue-600 hover:bg-blue-500 text-white rounded-full px-6 py-4 shadow-[0_0_20px_rgba(59,130,246,0.6)] flex items-center gap-3 font-bold transition-transform hover:scale-105 xl:hidden">
            <i class="fa-solid fa-desktop text-xl"></i> Voir L'Écran
        </button>
        <!-- Navbar -->
        <nav class="glass-panel sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-paintbrush text-blue-500 text-2xl"></i>
                <h1 class="text-xl font-bold">Menu CMS - WYSIWYG Editor</h1>

                <div class="ml-4 flex items-center gap-2 border-l border-slate-700 pl-4">
                    <label class="text-sm text-slate-300">Client / Projet:</label>
                    <select v-model="currentProject" @change="fetchData"
                        class="bg-slate-800 border border-slate-600 text-white rounded px-2 py-1 outline-none focus:border-indigo-500">
                        <option v-for="p in Object.keys(projects)" :value="p">{{ p }}</option>
                    </select>
                    <button @click="promptNewProject"
                        class="bg-indigo-600 hover:bg-indigo-500 px-3 py-1 rounded text-white font-bold transition whitespace-nowrap"
                        title="Créer un nouveau projet pour un client"><i class="fa fa-plus"></i> Nouveau
                        Client</button>
                    <button v-if="currentProject !== 'default'" @click="deleteProject"
                        class="bg-red-900/80 hover:bg-red-600 border border-red-700 px-3 py-1 rounded text-red-200 hover:text-white transition whitespace-nowrap"
                        title="Supprimer ce client"><i class="fa fa-trash"></i></button>

                    <label class="text-sm text-slate-300 ml-2">Écran:</label>
                    <select v-model="currentTvId" @change="fetchData"
                        class="bg-slate-800 border border-slate-600 text-white rounded px-2 py-1 outline-none focus:border-blue-500">
                        <option v-for="n in (projects[currentProject] || 1)" :value="n">Télévision {{ n }}</option>
                    </select>

                    <button @click="toggleOrientation"
                        class="ml-2 bg-slate-800 hover:bg-slate-700 border border-slate-600 px-3 py-1 rounded text-sm transition flex items-center gap-2"
                        :class="{'border-blue-500 text-blue-400': menuData?.orientation === 'vertical'}">
                        <i class="fa-solid"
                            :class="menuData?.orientation === 'vertical' ? 'fa-mobile-screen' : 'fa-tv'"></i>
                        {{ menuData?.orientation === 'vertical' ? 'Vertical' : 'Horizontal' }}
                    </button>

                    <button @click="isEditorPaused = !isEditorPaused"
                        class="ml-2 px-3 py-1 rounded text-sm transition flex items-center gap-2 border"
                        :class="isEditorPaused ? 'bg-orange-600 hover:bg-orange-500 border-orange-500 text-white' : 'bg-slate-800 hover:bg-slate-700 border-slate-600'">
                        <i class="fa-solid" :class="isEditorPaused ? 'fa-play' : 'fa-pause'"></i>
                    </button>

                    <a :href="'viewer.html?project=' + currentProject + '&tv=' + currentTvId" target="_blank"
                        class="ml-2 bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1 rounded text-sm transition flex items-center gap-2">
                        <i class="fa-solid fa-play"></i> Lancer TV
                    </a>

                    <button @click="toggleEditorFullscreen"
                        class="ml-2 bg-slate-200 hover:bg-white text-slate-900 font-bold px-3 py-1 rounded text-sm transition flex items-center gap-2"
                        title="Basculer en Plein Écran (Éditeur)">
                        <i class="fa-solid fa-expand"></i> Plein Écran
                    </button>

                    <button @click="copyTvLink"
                        class="ml-1 bg-slate-700 hover:bg-slate-600 border border-slate-600 text-white px-3 py-1 rounded text-sm transition flex items-center gap-2"
                        title="Copier le lien pour le client">
                        <i class="fa-solid fa-link"></i> Copier Lien
                    </button>

                    <a :href="'preview_all.html?project=' + currentProject" target="_blank"
                        class="ml-2 bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded text-sm transition flex items-center gap-2">
                        <i class="fa-solid fa-border-all"></i> Voir Tout (Global)
                    </a>
                </div>
            </div>
            <div class="flex gap-2 navbar-btns">
                <button @click="processImages"
                    class="bg-purple-600 hover:bg-purple-700 px-3 md:px-4 py-2 rounded-lg font-medium transition flex items-center gap-2">
                    <i class="fa-solid fa-robot"></i> <span class="navbar-text">Nettoyer Images (IA)</span>
                </button>
                <button @click="saveData"
                    class="bg-blue-600 hover:bg-blue-700 px-3 md:px-4 py-2 rounded-lg font-medium transition flex items-center gap-2">
                    <i class="fa-solid fa-save"></i> <span class="navbar-text">Sauvegarder</span>
                </button>
            </div>
        </nav>

        <div class="flex flex-1 overflow-hidden main-layout" v-if="menuData">
            <!-- Sidebar -->
            <div :class="isSidebarOpen ? 'w-64' : 'w-16'"
                class="glass-panel border-r border-slate-700 flex flex-col z-40 dashboard-sidebar transition-all duration-300 relative shrink-0">

                <!-- Toggle Button -->
                <button @click="isSidebarOpen = !isSidebarOpen"
                    class="absolute -right-3 top-6 w-6 h-6 bg-blue-600 rounded-full flex items-center justify-center text-white text-xs z-50 hover:bg-blue-500 shadow border border-slate-700"
                    title="Réduire/Agrandir le menu">
                    <i class="fa-solid" :class="isSidebarOpen ? 'fa-chevron-left' : 'fa-chevron-right'"></i>
                </button>

                <div class="tab-container overflow-hidden whitespace-nowrap">
                    <div v-if="isSidebarOpen"
                        class="p-4 text-sm font-semibold text-slate-400 uppercase tracking-wider cat-header">IA &
                        Création</div>
                    <div v-else class="h-10 border-b border-slate-700/50 mb-2"></div>

                    <button @click="currentTab = 'ia'"
                        :class="{'bg-slate-800 border-l-4 border-purple-500 active-tab': currentTab === 'ia', 'px-6': isSidebarOpen, 'px-0 justify-center': !isSidebarOpen}"
                        class="w-full py-4 text-left hover:bg-slate-800 transition flex items-center gap-3 font-bold text-purple-400">
                        <i class="fa-solid fa-wand-magic-sparkles" :class="{'text-xl': !isSidebarOpen}"></i>
                        <span v-show="isSidebarOpen">Infographiste IA</span>
                    </button>

                    <div v-if="isSidebarOpen"
                        class="p-4 mt-4 text-sm font-semibold text-slate-400 uppercase tracking-wider cat-header">Écrans
                    </div>
                    <div v-else class="h-8 border-b border-slate-700/50 mb-2 mt-2"></div>

                    <button @click="currentTab = 'tv2'"
                        :class="{'bg-slate-800 border-l-4 border-blue-500 active-tab': currentTab === 'tv2', 'px-6': isSidebarOpen, 'px-0 justify-center': !isSidebarOpen}"
                        class="w-full py-4 text-left hover:bg-slate-800 transition flex items-center gap-3">
                        <i class="fa-solid fa-layer-group" :class="{'text-xl': !isSidebarOpen}"></i>
                        <span v-show="isSidebarOpen">Éditeur des Écrans</span>
                    </button>
                    <button @click="currentTab = 'promos'"
                        :class="{'bg-slate-800 border-l-4 border-blue-500 active-tab': currentTab === 'promos', 'px-6': isSidebarOpen, 'px-0 justify-center': !isSidebarOpen}"
                        class="w-full py-4 text-left hover:bg-slate-800 transition flex items-center gap-3">
                        <i class="fa-solid fa-bullhorn" :class="{'text-xl': !isSidebarOpen}"></i>
                        <span v-show="isSidebarOpen">Promos (Vid/Img)</span>
                    </button>

                    <div v-if="isSidebarOpen"
                        class="p-4 mt-4 text-sm font-semibold text-slate-400 uppercase tracking-wider cat-header">
                        Configuration</div>
                    <div v-else class="h-8 border-b border-slate-700/50 mb-2 mt-2"></div>

                    <button @click="currentTab = 'assets'"
                        :class="{'bg-slate-800 border-l-4 border-blue-500 active-tab': currentTab === 'assets', 'px-6': isSidebarOpen, 'px-0 justify-center': !isSidebarOpen}"
                        class="w-full py-4 text-left hover:bg-slate-800 transition flex items-center gap-3">
                        <i class="fa-solid fa-box-open" :class="{'text-xl': !isSidebarOpen}"></i>
                        <span v-show="isSidebarOpen">Bibliothèque (Assets)</span>
                    </button>
                </div>
            </div>

            <!-- Content Area -->
            <div class="flex-1 p-8 overflow-y-auto content-area">
                <div v-if="notification" :class="[
                    'p-4 mb-6 rounded-lg border',
                    notification.type === 'success' ? 'bg-green-900/50 text-green-400 border-green-800' : 
                    notification.type === 'info' ? 'bg-blue-900/50 text-blue-400 border-blue-800' : 
                    'bg-red-900/50 text-red-400 border-red-800'
                ]">
                    {{ notification.message }}
                </div>

                <!-- TV 2 Formules (Canvas Editor) -->
                <div v-if="currentTab === 'tv2'">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-2xl font-bold">Éditeur Canvas & Animations</h2>
                        <div class="flex items-center gap-4">
                            <div
                                class="text-sm text-slate-400 bg-slate-800 px-4 py-2 rounded-lg border border-slate-700">
                                <i class="fa-solid fa-keyboard text-emerald-400 mr-2"></i> Appuyez sur <b>Espace</b>
                                pour tester l'animation.
                            </div>
                            <button @click="showTemplateModal = true"
                                class="bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white px-4 py-2 rounded-lg font-bold shadow-lg transition-all flex items-center gap-2">
                                <i class="fa-solid fa-magic"></i> Nouveau Écran (9walab)
                            </button>
                        </div>
                    </div>

                    <div class="space-y-12">
                        <div v-for="(formule, fKey, index) in menuData.formules" :key="fKey"
                            class="glass-panel p-6 rounded-xl border border-slate-700 relative"
                            @mouseenter="activeFormuleKey = fKey">
                            <!-- Info header Compact -->
                            <div
                                class="flex flex-wrap items-center gap-3 mb-4 pb-3 border-b border-slate-700 bg-slate-900/50 p-2 rounded-lg shadow-inner">
                                <input v-model="formule.name"
                                    class="bg-slate-800 border border-slate-600 text-white px-2 py-1 rounded text-sm w-40 font-bold focus:border-blue-500 outline-none"
                                    title="Nom de l'écran">

                                <div class="flex items-center gap-2 border-l border-slate-700 pl-3">
                                    <span class="text-[10px] text-slate-400 uppercase font-bold">TV:</span>
                                    <input type="text" v-model="formule.tv" placeholder="Toutes"
                                        class="bg-slate-800 border border-slate-600 text-white px-2 py-1 rounded text-xs w-16 text-center outline-none">
                                </div>


                                <div class="flex items-center gap-2 border-l border-slate-700 pl-3">
                                    <span class="text-[10px] text-slate-400 uppercase font-bold">Temps:</span>
                                    <input type="number" v-model="formule.duration"
                                        class="bg-slate-800 border border-slate-600 text-blue-400 font-bold px-2 py-1 rounded text-xs w-14 outline-none"
                                        title="Secondes">
                                </div>


                                <div class="flex items-center gap-2 border-l border-slate-700 pl-3">
                                    <span class="text-[10px] text-slate-400 uppercase font-bold text-amber-400"><i
                                            class="fa-solid fa-wand-magic-sparkles"></i> Effet Animé:</span>
                                    <select v-model="formule.bgEffect" @change="applyEffect(fKey)"
                                        class="bg-slate-800 border border-amber-600/50 text-amber-400 font-bold px-2 py-1 rounded text-xs outline-none focus:border-amber-400 transition-colors">
                                        <option value="none" :selected="!formule.bgEffect">Aucun</option>
                                        <option value="fire">🔥 Grill (Feu & Étincelles)</option>
                                        <option value="sparks">✨ Étincelles Magiques</option>
                                        <option value="smoke">💨 Fumée (Premium)</option>
                                        <option value="steam">♨️ Vapeur (Makla skhouna)</option>
                                        <option value="snow">❄️ Neige (Snow) - Boissons froides</option>
                                        <option value="bubbles">🫧 Bulles (Bubbles) - Soda/Eau</option>
                                        <option value="confetti">🎉 Confettis - Fêtes & Promos</option>
                                        <option value="stars">⭐ Étoiles - Nuit & Premium</option>
                                        <option value="beams">💫 Faisceaux Lumineux</option>
                                        <option value="neon">⚡ Néon Cyberpunk</option>
                                        <option value="chalk">⬛ Sboura (Chalk Dust)</option>
                                    </select>
                                </div>

                                <button @click="deleteFormule(fKey)"
                                    class="bg-red-900/80 hover:bg-red-600 text-red-200 hover:text-white px-3 py-1 rounded text-xs transition-colors border border-red-700 ml-auto flex items-center gap-2"
                                    title="Supprimer cet écran">
                                    <i class="fa-solid fa-trash"></i> <span class="hidden xl:inline">Supprimer</span>
                                </button>
                            </div>

                            <!-- FORCE ROW ALWAYS, PREVIEW FIRST, CONTROLS SECOND -->
                            <div class="flex flex-row gap-6 controls-panel w-full overflow-hidden">
                                <!-- Controles (Droite - Fixe) -->
                                <div class="w-[450px] flex-shrink-0 order-2 h-fit pb-12 relative"
                                    :class="{'fs-floating-panel': isFullscreenEditor}"
                                    @mousedown="activeSelectionType = 'props'"
                                    v-show="!isFullscreenEditor || showFsProps"
                                    :style="isFullscreenEditor ? { left: fsPanels.props.x + 'px', top: fsPanels.props.y + 'px', width: fsPanels.props.w + 'px', height: fsPanels.props.h + 'px', right: 'auto', bottom: 'auto' } : {}">
                                    
                                    <!-- Free Transform Box -->
                                    <div v-if="isFullscreenEditor && activeSelectionType === 'props' && isFreeTransformMode" class="absolute inset-0 pointer-events-none" style="border: 2px solid #8b5cf6; z-index: 9999;">
                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -left-2 cursor-nwse-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'nw', 'props')"></div>
                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -right-2 cursor-nesw-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'ne', 'props')"></div>
                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -left-2 cursor-nesw-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'sw', 'props')"></div>
                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -right-2 cursor-nwse-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'se', 'props')"></div>
                                        <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -left-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'w', 'props')"></div>
                                        <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -right-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'e', 'props')"></div>
                                        <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -top-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'n', 'props')"></div>
                                        <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -bottom-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 's', 'props')"></div>
                                    </div>

                                    <div v-if="isFullscreenEditor" class="fs-drag-handle bg-slate-800 p-2 mb-2 text-center text-xs text-white rounded font-bold" @mousedown.prevent.stop="startFsDrag($event, 'props')">
                                        <i class="fa-solid fa-grip-lines"></i> Propriétés (Glisser)
                                    </div>
                                    <!-- Assistant IA Contextuel -->
                                    <div
                                        class="mb-6 bg-gradient-to-br from-purple-900/50 to-pink-900/30 p-3 rounded-lg border border-purple-500/30 shadow-[0_0_15px_rgba(168,85,247,0.1)] relative overflow-hidden">
                                        <div class="flex items-center gap-2 mb-2">
                                            <i class="fa-solid fa-wand-magic-sparkles text-purple-400"></i>
                                            <h4 class="font-bold text-purple-300 text-xs uppercase tracking-wider">
                                                Assistant IA (Édition)</h4>
                                        </div>
                                        <div class="flex gap-2">
                                            <input type="text" v-model="formule.aiPrompt"
                                                @keyup.enter="askAIAssistant(fKey, formule)"
                                                placeholder="Demandez à l'IA (ex: anime le burger, fond bleu...)"
                                                class="bg-slate-900/80 border border-slate-600 text-white px-3 py-2 rounded text-xs flex-1 focus:border-purple-500 outline-none placeholder-slate-500">
                                            <button @click="askAIAssistant(fKey, formule)"
                                                class="bg-purple-600 hover:bg-purple-500 text-white px-3 py-2 rounded transition-colors shadow-lg"
                                                :disabled="formule.isGeneratingIA">
                                                <i class="fa-solid fa-paper-plane" v-if="!formule.isGeneratingIA"></i>
                                                <i class="fa-solid fa-spinner fa-spin" v-else></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="flex justify-between items-center mb-4">
                                        <h4 class="font-bold text-emerald-400 uppercase text-sm tracking-wider">
                                            Composants</h3>
                                            <div class="flex space-x-2">
                                                <button @click="addComponent(formule, fKey)"
                                                    class="bg-emerald-600 hover:bg-emerald-700 px-3 py-1 rounded text-sm"><i
                                                        class="fa fa-plus"></i> Image</button>
                                                <button @click="addTextComponent(formule, fKey)"
                                                    class="bg-indigo-600 hover:bg-indigo-700 px-3 py-1 rounded text-sm"><i
                                                        class="fa fa-font"></i> Texte</button>
                                                <button @click="addShapeComponent(formule, fKey)"
                                                    class="bg-pink-600 hover:bg-pink-700 px-3 py-1 rounded text-sm"><i
                                                        class="fa fa-shapes"></i> Forme</button>

                                                <div class="relative">
                                                    <button
                                                        class="bg-sky-600 hover:bg-sky-700 px-3 py-1 rounded text-sm font-bold shadow-lg flex items-center gap-2"
                                                        title="Ajouter une image d'arrière plan libre et déplaçable">
                                                        <i class="fa fa-image"></i> Image de Fond (Libre)
                                                    </button>
                                                    <input type="file"
                                                        @change="addRawImageComponent($event, formule, fKey)"
                                                        class="absolute inset-0 opacity-0 cursor-pointer"
                                                        accept="image/*">
                                                </div>

                                                <div class="relative">
                                                    <button
                                                        class="bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 px-3 py-1 rounded text-sm font-bold shadow-lg flex items-center gap-2">
                                                        <i class="fa-solid fa-wand-magic-sparkles"></i> Upload &
                                                        Détourer
                                                    </button>
                                                    <input type="file" @change="handleUploadAndProcess($event, formule)"
                                                        class="absolute inset-0 opacity-0 cursor-pointer"
                                                        accept="image/*"
                                                        title="Uploader une image pour retirer le fond par IA">
                                                </div>
                                            </div>
                                    </div>

                                    <div class="space-y-4 pr-2 pb-12">
                                        <!-- Background Properties Block -->
                                        <div v-if="activeCompIndex === 'background'"
                                            class="component-card active-card mb-4 border-blue-500 border-2 p-3 bg-slate-800/50 rounded-lg">
                                            <div class="flex justify-between items-start mb-3">
                                                <h5 class="font-bold text-blue-400 capitalize"><i class="fa-solid fa-fill-drip mr-2"></i> Arrière-plan</h5>
                                            </div>
                                            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                                                <div class="col-span-2">
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1">Couleur ou Dégradé</label>
                                                    <div class="grid grid-cols-2 gap-4 mt-2 mb-2">
                                                        <div>
                                                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Couleur 1</label>
                                                            <input type="color" v-model="formule.bgColor" class="w-full h-8 rounded cursor-pointer border border-slate-600 bg-slate-900">
                                                        </div>
                                                        <div>
                                                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Dégradé (Couleur 2)</label>
                                                            <div class="flex items-center gap-2">
                                                                <input type="checkbox" v-model="formule.isBgGradient" class="rounded bg-slate-800 border-slate-600">
                                                                <input v-if="formule.isBgGradient" type="color" v-model="formule.bgColor2" class="w-full h-8 rounded cursor-pointer border border-slate-600 bg-slate-900">
                                                            </div>
                                                        </div>
                                                        <div class="col-span-2" v-if="formule.isBgGradient">
                                                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Angle Dégradé: {{formule.bgGradientAngle || 90}}°</label>
                                                            <input type="range" v-model.number="formule.bgGradientAngle" min="0" max="360" step="15" class="w-full">
                                                        </div>
                                                        <div class="col-span-2">
                                                            <label class="text-[10px] text-slate-400 uppercase block mb-1">Effet Néon (Lumière d'arrière-plan)</label>
                                                            <div class="flex items-center gap-2">
                                                                <input type="checkbox" v-model="formule.isBgNeon" class="rounded bg-slate-800 border-slate-600">
                                                                <span class="text-xs text-slate-300">Allumer la couleur (Glow)</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <label class="text-[10px] text-slate-400 uppercase block mt-2 mb-1">Valeur CSS (Code complet)</label>
                                                    <input type="text" v-model="formule.bgColor" class="text-xs w-full bg-slate-900 border border-slate-600 rounded px-2 py-1 text-white mb-2" placeholder="Ex: #000000 ou linear-gradient(...)">
                                                </div>
                                                <div class="col-span-2 mt-4 pt-4 border-t border-slate-700">
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1">Image de fond (URL optionnelle)</label>
                                                    <input type="text" v-model="formule.bgImage" placeholder="Laissez vide pour utiliser la couleur" class="w-full bg-slate-900 border border-slate-600 rounded px-2 py-1 text-xs text-white">
                                                </div>
                                                <!-- Gradient / Fade Mask for Background Image -->
                                                <div v-if="formule.bgImage" class="col-span-2 mt-2 pt-2 border-t border-slate-700">
                                                    <label class="text-[10px] text-pink-400 font-bold uppercase block mb-1"><i class="fa fa-mask"></i> Masque / Fondu (Dégradé)</label>
                                                    <div class="grid grid-cols-2 gap-2 mt-2">
                                                        <div>
                                                            <label class="text-[9px] text-slate-400">Type de Masque</label>
                                                            <select v-model="formule.maskType" class="select-field text-xs py-1 w-full bg-slate-900">
                                                                <option value="">Aucun (Image complète)</option>
                                                                <option value="bottom">Fondu vers le Bas</option>
                                                                <option value="top">Fondu vers le Haut</option>
                                                                <option value="left">Fondu vers la Gauche</option>
                                                                <option value="right">Fondu vers la Droite</option>
                                                                <option value="radial">Fondu Radial (Centre transparent)</option>
                                                                <option value="radial-reverse">Fondu Radial (Bords transparents)</option>
                                                            </select>
                                                        </div>
                                                        <div v-if="formule.maskType && formule.maskType !== ''">
                                                            <label class="text-[9px] text-slate-400">Intensité ({{ Math.round((formule.maskStrength || 50)) }}%)</label>
                                                            <input type="range" v-model.number="formule.maskStrength" min="0" max="100" class="w-full h-1 mt-1">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Text Layout Editor Block -->
                                        <div v-if="typeof activeCompIndex === 'string' && formule[activeCompIndex]"
                                            :id="'comp-card-' + activeCompIndex"
                                            class="component-card active-card mb-4 border-blue-500 border-2">
                                            <div class="flex justify-between items-start mb-3">
                                                <h5 class="font-bold text-blue-400 capitalize">{{
                                                    activeCompIndex.replace('Layout', '') }} (Texte)</h5>
                                            </div>
                                            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                                                <div class="col-span-2">
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1">Contenu du Texte</label>
                                                    <textarea v-if="activeCompIndex === 'nameLayout'" v-model="formule.name" rows="2" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white outline-none focus:border-indigo-500"></textarea>
                                                    <textarea v-if="activeCompIndex === 'descLayout'" v-model="formule.description" rows="2" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white outline-none focus:border-indigo-500"></textarea>
                                                    <textarea v-if="activeCompIndex === 'priceLayout'" v-model="formule.price" rows="2" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white outline-none focus:border-indigo-500"></textarea>
                                                    <textarea v-if="activeCompIndex === 'badgeLayout'" v-model="formule.badge" rows="2" class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white outline-none focus:border-indigo-500"></textarea>
                                                </div>
                                                <!-- X, Y, Zoom, Rotation hidden as per user request -->
                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Anim
                                                        Entrée</label>
                                                    <select v-model="formule[activeCompIndex].animIn"
                                                        @change="previewSingleAnim(fKey, activeCompIndex, false)"
                                                        class="select-field text-xs py-1">
                                                        <option value="none">Aucune</option>
                                                        <option value="fadeUp">Lever (Monte)</option>
                                                        <option value="fadeDown">Tombe</option>
                                                        <option value="fadeLeft">Venant de Droite</option>
                                                        <option value="fadeRight">Venant de Gauche</option>
                                                        <option value="zoomIn">Zoom</option>
                                                        <option value="fade">Fondu (Fade)</option>
                                                        <option value="pop">Pop (Scale Pop)</option>
                                                        <option value="drop">Chute (Drop)</option>
                                                        <option value="rollIn">Roulade (Roll In)</option>
                                                        <option value="driftLeft">Dérive Gauche</option>
                                                        <option value="driftRight">Dérive Droite</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Anim
                                                        Sortie</label>
                                                    <select v-model="formule[activeCompIndex].animOut"
                                                        @change="previewSingleAnim(fKey, activeCompIndex, true)"
                                                        class="select-field text-xs py-1"
                                                        @wheel.prevent="cycleSelectOption($event, formule[activeCompIndex], 'animOut', Math.sign($event.deltaY))"
                                                        @keydown.up.prevent="cycleSelectOption($event, formule[activeCompIndex], 'animOut', -1)"
                                                        @keydown.down.prevent="cycleSelectOption($event, formule[activeCompIndex], 'animOut', 1)">
                                                        <option value="none">Aucune</option>
                                                        <option value="fadeDown">Tombe (S'en va vers le bas)</option>
                                                        <option value="fadeUp">Monte (S'en va vers le haut)</option>
                                                        <option value="fadeRight">Vers la Gauche</option>
                                                        <option value="fadeLeft">Vers la Droite</option>
                                                        <option value="zoomOut">Zoom Arrière (Sortie)</option>
                                                        <option value="fade">Fondu (Fade Out)</option>
                                                        <option value="pop">Pop Inverse</option>
                                                        <option value="drop">Envole (Drop Inverse)</option>
                                                        <option value="rollIn">Roulade Arrière</option>
                                                        <option value="driftLeft">Dérive Droite</option>
                                                        <option value="driftRight">Dérive Gauche</option>
                                                    </select>
                                                </div>

                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Délai:
                                                        {{formule[activeCompIndex].delay}}s</label>
                                                    <input type="range" v-model.number="formule[activeCompIndex].delay"
                                                        min="0" max="2" step="0.1">
                                                </div>
                                                <div
                                                    v-if="activeCompIndex === 'priceLayout' || activeCompIndex === 'badgeLayout'">
                                                    <label class="text-[10px] text-slate-400 uppercase">Forme
                                                        (Shape)</label>
                                                    <select v-model="formule[activeCompIndex].shapeType"
                                                        class="select-field text-xs py-1">
                                                        <option value="">Par défaut</option>
                                                        <option value="circle">Ronde</option>
                                                        <option value="rect">Carré/Rectangle</option>
                                                        <option value="badge">Badge Étoile</option>
                                                    </select>
                                                </div>
                                                <div
                                                    v-if="activeCompIndex === 'priceLayout' || activeCompIndex === 'badgeLayout'">
                                                    <label class="text-[10px] text-slate-400 uppercase">Couleur de
                                                        Fond</label>
                                                    <input type="color" :value="formule[activeCompIndex].bgColor || (Object.keys(menuData.formules).indexOf(fKey) % 2 === 0 ? '#DA291C' : '#FFC72C')" @input="formule[activeCompIndex].bgColor = $event.target.value; $forceUpdate()"
                                                        class="w-full h-8 bg-slate-800 rounded border border-slate-600 cursor-pointer">
                                                </div>
                                                <div
                                                    v-if="activeCompIndex === 'priceLayout' || activeCompIndex === 'badgeLayout'">
                                                    <label class="text-[10px] text-slate-400 uppercase">Couleur de Bordure</label>
                                                    <input type="color" :value="formule[activeCompIndex].borderColor || (Object.keys(menuData.formules).indexOf(fKey) % 2 === 0 ? '#FFC72C' : '#DA291C')" @input="formule[activeCompIndex].borderColor = $event.target.value; $forceUpdate()"
                                                        class="w-full h-8 bg-slate-800 rounded border border-slate-600 cursor-pointer">
                                                </div>
                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Couleur du
                                                        Texte</label>
                                                    <input type="color" :value="formule[activeCompIndex].color || (Object.keys(menuData.formules).indexOf(fKey) % 2 === 0 ? '#ffffff' : '#111111')" @input="formule[activeCompIndex].color = $event.target.value; $forceUpdate()"
                                                        class="w-full h-8 bg-slate-800 rounded border border-slate-600 cursor-pointer">
                                                </div>
                                                <div class="col-span-2">
                                                    <label class="text-[10px] text-slate-400 uppercase">Animation
                                                        Continue (Boucle Infinie)</label>
                                                    <select v-model="formule[activeCompIndex].continuousAnim"
                                                        class="select-field text-xs py-1 w-full bg-slate-800">
                                                        <option value="none"
                                                            :selected="!formule[activeCompIndex].continuousAnim">Aucune
                                                        </option>
                                                        <option value="float">Flottement (Haut/Bas)</option>
                                                        <option value="float-x">Flottement (Gauche/Droite)</option>
                                                        <option value="pulse">Battement (Pulse)</option>
                                                        <option value="heartbeat">Battement de Coeur</option>
                                                        <option value="breathe">Respiration (Zoom lent)</option>
                                                        <option value="glow">Brillance (Glow)</option>
                                                        <option value="bounce-slow">Rebondissement Lent</option>
                                                        <option value="swing">Balancement (Swing)</option>
                                                        <option value="wobble">Tremblotement (Wobble)</option>
                                                        <option value="shake">Secousse (Shake)</option>
                                                        <option value="spin">Rotation Lente</option>
                                                        <option value="spin-reverse">Rotation Lente Inversée</option>
                                                        <option value="spin-fast">Rotation Rapide</option>
                                                        <option value="flip">Rotation 3D (Flip)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div v-for="(comp, cIdx) in formule.components" :key="cIdx"
                                            class="component-card" :id="'comp-card-' + cIdx"
                                            :class="{'active-card': isActive(fKey, cIdx)}" v-show="isActive(fKey, cIdx)"
                                            @click="setActive(fKey, cIdx)">
                                            <div class="flex items-center gap-3 mb-3">
                                                <div v-if="comp.type === 'main'"
                                                    class="w-10 h-10 shrink-0 bg-slate-900 rounded-lg flex items-center justify-center p-1 border border-slate-700">
                                                    <img :src="getAssetUrl(comp.assetId)"
                                                        class="max-h-full max-w-full object-contain drop-shadow-md">
                                                </div>
                                                <div v-else-if="comp.type === 'rawImage'"
                                                    class="w-10 h-10 shrink-0 bg-slate-900 rounded-lg flex items-center justify-center p-1 border border-slate-700">
                                                    <img :src="'/' + comp.url"
                                                        class="max-h-full max-w-full object-cover rounded">
                                                </div>
                                                <div v-else-if="comp.type === 'customText'"
                                                    class="w-10 h-10 shrink-0 bg-indigo-900/50 rounded-lg flex items-center justify-center border border-indigo-700/50 text-indigo-400">
                                                    <i class="fa fa-font text-xl"></i>
                                                </div>
                                                <div v-else-if="comp.type === 'shape'"
                                                    class="w-10 h-10 shrink-0 bg-pink-900/50 rounded-lg flex items-center justify-center border border-pink-700/50 text-pink-400">
                                                    <i class="fa fa-shapes text-xl"></i>
                                                </div>

                                                <div class="flex-1 min-w-0">
                                                    <select v-if="comp.type === 'main'" v-model="comp.assetId"
                                                        class="select-field w-full font-bold text-white bg-slate-800">
                                                        <optgroup label="Sandwichs">
                                                            <option v-for="a in menuData.assets.sandwiches"
                                                                :value="a.id">{{ a.name }}</option>
                                                        </optgroup>
                                                        <optgroup label="Boissons">
                                                            <option v-for="a in menuData.assets.drinks" :value="a.id">{{
                                                                a.name }}</option>
                                                        </optgroup>
                                                        <optgroup label="Accompagnements">
                                                            <option v-for="a in menuData.assets.sides" :value="a.id">{{
                                                                a.name }}</option>
                                                        </optgroup>
                                                    </select>
                                                    <div v-else-if="comp.type === 'rawImage'"
                                                        class="w-full font-bold text-blue-400 truncate">Image de Fond
                                                    </div>
                                                    <div v-else-if="comp.type === 'customText'"
                                                        class="w-full font-bold text-indigo-400 truncate">{{
                                                        comp.content || 'Texte Libre' }}</div>
                                                    <div v-else-if="comp.type === 'shape'"
                                                        class="w-full font-bold text-pink-400 truncate">Forme</div>
                                                </div>

                                                <button v-if="comp.type === 'main' || comp.type === 'rawImage'" @click.stop="toggleFillScreen(comp)"
                                                    class="text-slate-400 hover:text-white p-2 shrink-0"
                                                    title="Remplir l'écran (Plein écran)"
                                                    :class="{'text-blue-400 ring-1 ring-blue-400 rounded bg-blue-900/30': comp.fillScreen}"><i
                                                        class="fa-solid fa-expand"></i></button>

                                                <button @click.stop="comp.flipX = !comp.flipX; comp.flip = false"
                                                    class="text-slate-400 hover:text-white p-2 shrink-0"
                                                    title="Retourner horizontalement"
                                                    :class="{'text-blue-400': comp.flipX || comp.flip}"><i
                                                        class="fa-solid fa-arrows-left-right"></i></button>
                                                <button @click.stop="comp.flipY = !comp.flipY"
                                                    class="text-slate-400 hover:text-white p-2 shrink-0"
                                                    title="Retourner verticalement"
                                                    :class="{'text-blue-400': comp.flipY}"><i
                                                        class="fa-solid fa-arrows-up-down"></i></button>
                                                <button @click.stop="copyComponent(fKey, cIdx)"
                                                    class="text-blue-400 hover:text-blue-300 p-2 shrink-0"
                                                    title="Copier ce composant"><i class="fa fa-copy"></i></button>
                                                <button @click.stop="duplicateComponent(fKey, cIdx)"
                                                    class="text-emerald-400 hover:text-emerald-300 p-2 shrink-0"
                                                    title="Dupliquer"><i class="fa fa-clone"></i></button>
                                                <button @click.stop="formule.components.splice(cIdx, 1)"
                                                    class="text-red-400 hover:text-red-300 p-2 shrink-0"
                                                    title="Supprimer"><i class="fa fa-trash"></i></button>
                                            </div>

                                            <!-- Custom Text Content Editor -->
                                            <div v-if="comp.type === 'customText'"
                                                class="mb-4 bg-slate-900 p-3 rounded border border-slate-700">
                                                <div class="mb-2">
                                                    <label
                                                        class="text-[10px] text-slate-400 uppercase block mb-1">Contenu
                                                        du Texte</label>
                                                    <textarea v-model="comp.content" rows="2"
                                                        class="w-full bg-slate-800 border border-slate-600 rounded px-2 py-1 text-sm text-white outline-none focus:border-indigo-500"></textarea>
                                                </div>
                                                <div class="grid grid-cols-2 gap-4">
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Couleur</label>
                                                        <input type="color" v-model="comp.color"
                                                            class="w-full h-8 rounded cursor-pointer bg-transparent border-0">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Taille:
                                                            {{comp.fontSize}}px</label>
                                                        <input type="range" v-model.number="comp.fontSize" min="10"
                                                            max="250" step="2" class="w-full">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Espacement
                                                            Let. ({{comp.letterSpacing || 0}})</label>
                                                        <input type="range" v-model.number="comp.letterSpacing"
                                                            min="-50" max="150" step="1" class="w-full">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Interligne
                                                            ({{comp.lineHeight || 1}})</label>
                                                        <input type="range" v-model.number="comp.lineHeight" min="0.1"
                                                            max="5" step="0.1" class="w-full">
                                                    </div>
                                                    <div
                                                        class="col-span-2 grid grid-cols-2 gap-4 mt-1 border-t border-slate-700 pt-2">
                                                        <div>
                                                            <label
                                                                class="text-[10px] text-slate-400 uppercase block mb-1">Effet
                                                                (Style Canva)</label>
                                                            <select v-model="comp.textEffect"
                                                                class="select-field text-xs py-1 w-full bg-slate-800">
                                                                <option value="">Aucun</option>
                                                                <option value="shadow">Ombre portée</option>
                                                                <option value="glow">Brillance</option>
                                                                <option value="echo">Écho</option>
                                                                <option value="outline">Bordure</option>
                                                                <option value="bg">Arrière-plan</option>
                                                                <option value="bevel">Biseautage</option>
                                                                <option value="hollow">Contour</option>
                                                                <option value="neon">Néon</option>
                                                                <option value="glitch">Glitch</option>
                                                            </select>
                                                        </div>
                                                        <div v-if="comp.textEffect && comp.textEffect !== 'none'">
                                                            <label
                                                                class="text-[10px] text-slate-400 uppercase block mb-1">Intensité</label>
                                                            <input type="range" v-model.number="comp.effectIntensity"
                                                                min="0" max="100" step="1" class="w-full"
                                                                :title="comp.effectIntensity || 50">
                                                        </div>
                                                        <div
                                                            v-if="['outline', 'hollow', 'glitch'].includes(comp.textEffect)">
                                                            <label
                                                                class="text-[10px] text-slate-400 uppercase block mb-1">Couleur
                                                                2 (Stroke)</label>
                                                            <input type="color" v-model="comp.strokeColor"
                                                                class="w-full h-8 rounded cursor-pointer bg-transparent border-0">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mt-2">
                                                    <label
                                                        class="text-[10px] text-slate-400 uppercase block mb-1">Style</label>
                                                    <select v-model="comp.fontFamily"
                                                        class="select-field text-xs py-1 w-full">
                                                        <option value="'Oswald', sans-serif">Titre (Oswald)</option>
                                                        <option value="'Open Sans', sans-serif">Normal (Open Sans)
                                                        </option>
                                                        <option value="'Bebas Neue', sans-serif">Prix (Bebas Neue)
                                                        </option>
                                                        <option value="'Bangers', cursive">BD / Pop-Art (Bangers)
                                                        </option>
                                                        <option value="'Luckiest Guy', cursive">Fun / Gros (Luckiest
                                                            Guy)</option>
                                                        <option value="'Titan One', cursive">Très Gras (Titan One)
                                                        </option>
                                                        <option value="'Carter One', cursive">Street (Carter One)
                                                        </option>
                                                    </select>
                                                </div>
                                                <div
                                                    class="col-span-2 mt-2 pt-2 border-t border-slate-700 grid grid-cols-2 gap-2">
                                                    <button @click="applyScaleToAll(fKey, cIdx, 'customText')"
                                                        class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                            class="fa fa-expand"></i> Taille à tous</button>
                                                    <button @click="applyStyleToAll(fKey, cIdx, 'customText')"
                                                        class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                            class="fa fa-paint-brush"></i> Style à tous</button>
                                                </div>
                                            </div>

                                            <!-- Raw Image / Main Component Crop Editor -->
                                            <div v-if="comp.type === 'rawImage' || comp.type === 'main'"
                                                class="mb-4 bg-slate-900 p-3 rounded border border-slate-700">
                                                <div class="mt-2 flex justify-between items-center pt-1">
                                                    <label
                                                        class="flex items-center gap-2 text-xs text-slate-300 font-bold cursor-pointer">
                                                        <input type="checkbox" v-model="comp.hasShadow"
                                                            :true-value="true" :false-value="false"
                                                            class="rounded bg-slate-800 border-slate-600">
                                                        Activer l'ombre
                                                    </label>
                                                </div>
                                                <div class="mt-3 border-t border-slate-700 pt-3">
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1">Masque / Fondu (Dégradé)</label>
                                                    <select v-model="comp.maskType" class="select-field text-xs py-1 w-full mb-2">
                                                        <option :value="undefined">Aucun</option>
                                                        <option value="bottom">Fondu vers le bas</option>
                                                        <option value="top">Fondu vers le haut</option>
                                                        <option value="left">Fondu vers la gauche</option>
                                                        <option value="right">Fondu vers la droite</option>
                                                        <option value="radial">Fondu radial (Centre)</option>
                                                    </select>
                                                    <div v-if="comp.maskType" class="flex flex-col gap-1">
                                                        <label class="text-[10px] text-slate-400 uppercase">Intensité: {{comp.maskStrength || 50}}%</label>
                                                        <input type="range" v-model.number="comp.maskStrength" min="0" max="100" class="w-full">
                                                    </div>
                                                </div>
                                                <div class="mt-3 text-center">
                                                    <button @click="openLassoTool(fKey, cIdx)"
                                                        class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white py-2 px-4 rounded w-full flex items-center justify-center gap-2 font-bold shadow-lg">
                                                        <i class="fa-solid fa-pen-nib"></i> Outil Plume (Détourage
                                                        Précis)
                                                    </button>
                                                    <button v-if="comp.clipPolygon"
                                                        @click="comp.clipPolygon = null; saveData()"
                                                        class="mt-2 text-xs bg-red-600/50 hover:bg-red-600 text-white py-1 px-3 rounded w-full flex items-center justify-center gap-2">
                                                        <i class="fa-solid fa-trash"></i> Annuler le détourage plume
                                                    </button>
                                                </div>
                                                <div class="mt-3 pt-3 border-t border-slate-700 grid grid-cols-2 gap-2">
                                                    <button @click="applyScaleToAll(fKey, cIdx, comp.type)"
                                                        class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                            class="fa fa-expand"></i> Taille à tous</button>
                                                    <button @click="applyStyleToAll(fKey, cIdx, comp.type)"
                                                        class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                            class="fa fa-paint-brush"></i> Style à tous</button>
                                                </div>
                                            </div>

                                            <!-- Shape Editor -->
                                            <div v-if="comp.type === 'shape'"
                                                class="mb-4 bg-slate-900 p-3 rounded border border-slate-700">
                                                <div class="mb-4">
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1">Type
                                                        de Forme</label>
                                                    <select v-model="comp.shapeType"
                                                        class="select-field text-xs py-1 w-full bg-slate-800">
                                                        <option value="rect">Rectangle / Carré</option>
                                                        <option value="circle">Rond / Ovale</option>
                                                        <option value="badge">Promo Badge (Macaron)</option>
                                                        <option value="star">Étoile Promo</option>
                                                        <option value="burst">Éclat Promo (Burst)</option>
                                                    </select>
                                                </div>
                                                <div class="grid grid-cols-2 gap-4">
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Largeur:
                                                            {{comp.width}}px</label>
                                                        <input type="range" v-model.number="comp.width" min="10"
                                                            max="1000" step="10" class="w-full">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Hauteur:
                                                            {{comp.height}}px</label>
                                                        <input type="range" v-model.number="comp.height" min="10"
                                                            max="1000" step="10" class="w-full">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Couleur</label>
                                                        <input type="color" v-model="comp.color"
                                                            class="w-full h-8 rounded cursor-pointer bg-transparent border-0">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Dégradé
                                                            (Couleur 2)</label>
                                                        <div class="flex items-center gap-2">
                                                            <input type="checkbox" v-model="comp.isGradient"
                                                                class="rounded bg-slate-800 border-slate-600">
                                                            <input v-if="comp.isGradient" type="color"
                                                                v-model="comp.color2"
                                                                class="w-full h-8 rounded cursor-pointer bg-transparent border-0">
                                                        </div>
                                                    </div>
                                                    <div class="col-span-2" v-if="comp.isGradient">
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Angle
                                                            Dégradé: {{comp.gradientAngle || 90}}°</label>
                                                        <input type="range" v-model.number="comp.gradientAngle" min="0"
                                                            max="360" step="15" class="w-full">
                                                    </div>
                                                    <div :class="{'col-span-2': !comp.isGradient}">
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Opacité:
                                                            {{comp.opacity}}</label>
                                                        <input type="range" v-model.number="comp.opacity" min="0.1"
                                                            max="1" step="0.05" class="w-full">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400 uppercase block mb-1">Effet Néon</label>
                                                        <div class="flex items-center gap-2 mt-1">
                                                            <input type="checkbox" v-model="comp.isNeon" class="rounded bg-slate-800 border-slate-600">
                                                            <span class="text-xs text-slate-300">Lumière</span>
                                                        </div>
                                                    </div>
                                                    <div class="col-span-2"
                                                        v-if="!comp.shapeType || comp.shapeType === 'rect'">
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Bords
                                                            Arrondis: {{comp.borderRadius}}px</label>
                                                        <input type="range" v-model.number="comp.borderRadius" min="0"
                                                            max="500" step="5" class="w-full">
                                                    </div>

                                                    <div class="col-span-2">
                                                        <label class="text-[10px] text-slate-400 uppercase block mb-1">Masque / Fondu (Dégradé)</label>
                                                        <select v-model="comp.maskType" class="select-field text-xs py-1 w-full mb-2">
                                                            <option :value="undefined">Aucun</option>
                                                            <option value="bottom">Fondu vers le bas</option>
                                                            <option value="top">Fondu vers le haut</option>
                                                            <option value="left">Fondu vers la gauche</option>
                                                            <option value="right">Fondu vers la droite</option>
                                                            <option value="radial">Fondu radial (Centre)</option>
                                                        </select>
                                                        <div v-if="comp.maskType" class="flex flex-col gap-1">
                                                            <label class="text-[10px] text-slate-400 uppercase">Intensité: {{comp.maskStrength || 50}}%</label>
                                                            <input type="range" v-model.number="comp.maskStrength" min="0" max="100" class="w-full">
                                                        </div>
                                                    </div>

                                                    <div class="col-span-2 mt-2 pt-2 border-t border-slate-700">
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Texte
                                                            (Double Clic sur la forme pour modifier)</label>
                                                        <input type="text" v-model="comp.content"
                                                            placeholder="Texte à l'intérieur"
                                                            class="w-full bg-slate-800 border border-slate-700 rounded px-2 py-1 text-white text-xs">
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Couleur
                                                            Texte</label>
                                                        <div class="flex gap-2">
                                                            <input type="color" v-model="comp.textColor"
                                                                class="w-8 h-8 rounded cursor-pointer bg-transparent border-0 flex-shrink-0">
                                                            <button
                                                                @mousedown.prevent="applyColorToSelection(comp.textColor)"
                                                                class="bg-indigo-600 hover:bg-indigo-500 text-white text-[10px] px-2 rounded font-bold flex-1"
                                                                title="Surlignez le texte puis cliquez ici pour colorer uniquement la sélection">Appliquer
                                                                à la sélection</button>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <label
                                                            class="text-[10px] text-slate-400 uppercase block mb-1">Taille:
                                                            {{comp.fontSize || 40}}px</label>
                                                        <input type="range" v-model.number="comp.fontSize" min="10"
                                                            max="250" step="2" class="w-full">
                                                    </div>
                                                    <div
                                                        class="col-span-2 mt-2 pt-2 border-t border-slate-700 grid grid-cols-2 gap-2">
                                                        <button @click="applyScaleToAll(fKey, cIdx, 'shape')"
                                                            class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                                class="fa fa-expand"></i> Taille à tous</button>
                                                        <button @click="applyStyleToAll(fKey, cIdx, 'shape')"
                                                            class="text-[10px] bg-slate-700 hover:bg-slate-600 text-white py-1.5 rounded shadow flex items-center justify-center gap-1"><i
                                                                class="fa fa-paint-brush"></i> Style à tous</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                                                <div class="col-span-2">
                                                    <label
                                                        class="text-[10px] text-slate-400 uppercase block mb-1">Transparence
                                                        (Opacité): {{ Math.round((comp.opacity ?? 1) * 100) }}%</label>
                                                    <input type="range" :value="comp.opacity ?? 1"
                                                        @input="comp.opacity = parseFloat($event.target.value)" min="0"
                                                        max="1" step="0.05" class="w-full">
                                                </div>

                                                <!-- X, Y, Zoom, Rotation hidden as per user request -->
                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase block mb-1"
                                                        title="Z-Index">Position (Calque)</label>
                                                    <div class="flex gap-2">
                                                        <button @click.prevent="moveLayer(fKey, cIdx, -1)"
                                                            class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded py-1 text-xs border border-slate-600 transition-colors"
                                                            title="Reculer (Mettre en arrière)">
                                                            <i class="fa-solid fa-arrow-down mr-1"></i> Reculer
                                                        </button>
                                                        <button @click.prevent="moveLayer(fKey, cIdx, 1)"
                                                            class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded py-1 text-xs border border-slate-600 transition-colors"
                                                            title="Avancer (Mettre en avant)">
                                                            <i class="fa-solid fa-arrow-up mr-1"></i> Avancer
                                                        </button>
                                                        <button @click.prevent="comp.locked = !comp.locked"
                                                            :class="comp.locked ? 'bg-red-600 hover:bg-red-700' : 'bg-slate-800 hover:bg-slate-700'"
                                                            class="flex-1 text-white rounded py-1 text-xs border border-slate-600 transition-colors"
                                                            :title="comp.locked ? 'Déverrouiller' : 'Verrouiller'">
                                                            <i class="fa-solid"
                                                                :class="comp.locked ? 'fa-lock' : 'fa-unlock'"></i>
                                                            <span class="hidden xl:inline">{{ comp.locked ? 'Fixé' :
                                                                'Libre' }}</span>
                                                        </button>
                                                    </div>
                                                </div>

                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Anim
                                                        Entrée</label>
                                                    <select v-model="comp.animIn" class="select-field text-xs py-1"
                                                        @change="previewSingleAnim(fKey, cIdx, false)"
                                                        @wheel.prevent="cycleSelectOption($event, comp, 'animIn', Math.sign($event.deltaY))"
                                                        @keydown.up.prevent="cycleSelectOption($event, comp, 'animIn', -1)"
                                                        @keydown.down.prevent="cycleSelectOption($event, comp, 'animIn', 1)">
                                                        <option value="none">Aucune</option>
                                                        <option value="fadeUp">Lever (Monte)</option>
                                                        <option value="fadeDown">Tombe</option>
                                                        <option value="fadeLeft">Venant de Droite</option>
                                                        <option value="fadeRight">Venant de Gauche</option>
                                                        <option value="zoomIn">Zoom</option>
                                                        <option value="fade">Fondu (Fade)</option>
                                                        <option value="pop">Pop (Scale Pop)</option>
                                                        <option value="drop">Chute (Drop)</option>
                                                        <option value="rollIn">Roulade (Roll In)</option>
                                                        <option value="driftLeft">Dérive Gauche</option>
                                                        <option value="driftRight">Dérive Droite</option>
                                                        <option value="custom">Personnalisée (Trajectoire)</option>
                                                    </select>
                                                </div>
                                                <div v-if="comp.animIn === 'custom'" class="col-span-2 grid grid-cols-2 gap-2 mt-1 mb-2 p-2 bg-slate-800 rounded border border-indigo-500/50">
                                                    <div class="col-span-2 text-[10px] text-indigo-300 font-bold mb-1"><i class="fa fa-route"></i> Point de départ personnalisé</div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">X (Décalage H): {{comp.animStartX || 0}}</label>
                                                        <input type="range" v-model.number="comp.animStartX" min="-1920" max="1920" step="10" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, false)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Y (Décalage V): {{comp.animStartY || 0}}</label>
                                                        <input type="range" v-model.number="comp.animStartY" min="-1080" max="1080" step="10" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, false)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Échelle initiale: {{comp.animStartScale !== undefined ? comp.animStartScale : 1}}</label>
                                                        <input type="range" v-model.number="comp.animStartScale" min="0" max="3" step="0.1" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, false)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Rotation: {{(comp.animStartRotation || 0)}}°</label>
                                                        <input type="range" v-model.number="comp.animStartRotation" min="-720" max="720" step="15" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, false)">
                                                    </div>
                                                </div>
                                                <div>
                                                    <label class="text-[10px] text-slate-400 uppercase">Anim
                                                        Sortie</label>
                                                    <select v-model="comp.animOut" class="select-field text-xs py-1"
                                                        @change="previewSingleAnim(fKey, cIdx, true)"
                                                        @wheel.prevent="cycleSelectOption($event, comp, 'animOut', Math.sign($event.deltaY))"
                                                        @keydown.up.prevent="cycleSelectOption($event, comp, 'animOut', -1)"
                                                        @keydown.down.prevent="cycleSelectOption($event, comp, 'animOut', 1)">
                                                        <option value="none">Aucune</option>
                                                        <option value="fadeDown">Tombe (S'en va vers le bas)</option>
                                                        <option value="fadeUp">Monte (S'en va vers le haut)</option>
                                                        <option value="fadeRight">Vers la Gauche</option>
                                                        <option value="fadeLeft">Vers la Droite</option>
                                                        <option value="zoomOut">Zoom Arrière (Sortie)</option>
                                                        <option value="fade">Fondu (Fade Out)</option>
                                                        <option value="pop">Pop Inverse</option>
                                                        <option value="drop">Envole (Drop Inverse)</option>
                                                        <option value="rollIn">Roulade Arrière</option>
                                                        <option value="driftLeft">Dérive Droite</option>
                                                        <option value="driftRight">Dérive Gauche</option>
                                                        <option value="custom">Personnalisée (Trajectoire)</option>
                                                    </select>
                                                </div>
                                                <div v-if="comp.animOut === 'custom'" class="col-span-2 grid grid-cols-2 gap-2 mt-1 mb-2 p-2 bg-slate-800 rounded border border-indigo-500/50">
                                                    <div class="col-span-2 text-[10px] text-indigo-300 font-bold mb-1"><i class="fa fa-route"></i> Point de sortie personnalisé</div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">X (Décalage H): {{comp.animEndX || 0}}</label>
                                                        <input type="range" v-model.number="comp.animEndX" min="-1920" max="1920" step="10" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, true)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Y (Décalage V): {{comp.animEndY || 0}}</label>
                                                        <input type="range" v-model.number="comp.animEndY" min="-1080" max="1080" step="10" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, true)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Échelle finale: {{comp.animEndScale !== undefined ? comp.animEndScale : 1}}</label>
                                                        <input type="range" v-model.number="comp.animEndScale" min="0" max="3" step="0.1" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, true)">
                                                    </div>
                                                    <div>
                                                        <label class="text-[10px] text-slate-400">Rotation: {{(comp.animEndRotation || 0)}}°</label>
                                                        <input type="range" v-model.number="comp.animEndRotation" min="-720" max="720" step="15" class="w-full h-1" @input="previewSingleAnim(fKey, cIdx, true)">
                                                    </div>
                                                </div>

                                                <div class="col-span-2 mt-2 border-t border-slate-700 pt-2">
                                                    <label
                                                        class="text-[10px] text-slate-400 uppercase block mb-1">Animation
                                                        Continue (Boucle Infinie)</label>
                                                    <select v-model="comp.continuousAnim"
                                                        class="select-field text-xs py-1 w-full bg-slate-800"
                                                        @wheel.prevent="cycleSelectOption($event, comp, 'continuousAnim', Math.sign($event.deltaY))"
                                                        @keydown.up.prevent="cycleSelectOption($event, comp, 'continuousAnim', -1)"
                                                        @keydown.down.prevent="cycleSelectOption($event, comp, 'continuousAnim', 1)">
                                                        <option value="none">Aucune</option>
                                                        <option value="float">Flottement (Haut/Bas)</option>
                                                        <option value="float-x">Flottement (Gauche/Droite)</option>
                                                        <option value="pulse">Battement (Pulse)</option>
                                                        <option value="heartbeat">Battement de Coeur</option>
                                                        <option value="breathe">Respiration (Zoom lent)</option>
                                                        <option value="glow">Brillance (Glow)</option>
                                                        <option value="bounce-slow">Rebondissement Lent</option>
                                                        <option value="swing">Balancement (Swing)</option>
                                                        <option value="wobble">Tremblotement (Wobble)</option>
                                                        <option value="shake">Secousse (Shake)</option>
                                                        <option value="spin">Rotation Lente</option>
                                                        <option value="spin-reverse">Rotation Lente Inversée</option>
                                                        <option value="spin-fast">Rotation Rapide</option>
                                                        <option value="flip">Rotation 3D (Flip)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Live Preview Panel (Gauche - Main) -->
                                <div
                                    class="flex-1 min-w-0 order-1 flex flex-col sticky top-0 h-fit z-40 bg-slate-900/80 backdrop-blur-md p-4 rounded-xl shadow-xl border border-slate-700/50">
                                    <div class="flex justify-between items-center mb-4">
                                        <h4 class="font-bold text-blue-400 uppercase text-sm tracking-wider"><i
                                                class="fa fa-tv"></i> Aperçu Interactif (Timeline)</h4>
                                        <div class="flex gap-2">
                                            <button @click="togglePlayPreview(fKey)"
                                                class="bg-blue-600 hover:bg-blue-500 text-xs px-3 py-1 rounded">
                                                <i class="fa" :class="isPlaying ? 'fa-pause' : 'fa-play'"></i> {{
                                                isPlaying ? 'Pause' : 'Play' }}
                                            </button>
                                            <div v-if="showGuides"
                                                class="flex items-center gap-2 bg-slate-800 px-2 py-1 rounded border border-cyan-500/50">
                                                <span class="text-xs text-cyan-400 font-bold">Ligne:</span>
                                                <input type="range" v-model="guideY" min="0" max="100"
                                                    class="w-24 h-1 bg-slate-600 rounded-lg appearance-none cursor-pointer">
                                                <span class="text-xs text-white">{{ guideY }}%</span>
                                            </div>
                                            <button @click="showGuides = !showGuides"
                                                class="bg-slate-700 hover:bg-slate-600 text-xs px-3 py-1 rounded inline-flex items-center gap-2 text-white font-bold"
                                                title="Afficher les lignes de repère (Grille)">
                                                <i class="fa-solid fa-ruler-combined"></i> {{ showGuides ? 'Cacher Repères' : 'Afficher Repères' }}
                                            </button>
                                            <a :href="'/' + (currentTab === 'ia' ? 'tv1' : currentTab) + '.html'"
                                                target="_blank"
                                                class="bg-slate-700 hover:bg-slate-600 text-xs px-3 py-1 rounded inline-flex items-center gap-2 text-white no-underline font-bold"
                                                title="Ouvrir dans une nouvelle page localhost">
                                                <i class="fa-solid fa-external-link-alt"></i> Ouvrir Player
                                            </a>
                                        </div>
                                    </div>

                                    <!-- Scrubber replaced by CapCut timeline below -->
                                    <div :id="'mockup-wrapper-'+fKey"
                                        class="bg-black rounded-lg relative shadow-2xl border border-slate-700 mockup-wrapper"
                                        :class="{'overflow-hidden': !isFullscreenEditor}"
                                        :style="menuData.orientation === 'vertical' ? 'width: 273px; height: 486px;' : 'width: 864px; height: 486px;'">
                                        <!-- Exit Fullscreen button (only visible in fullscreen) -->
                                        <button @click.stop="exitAllFullscreen(fKey)"
                                            class="exit-fs-btn absolute top-6 right-6 z-[999999] bg-slate-800/80 hover:bg-red-600 text-white w-12 h-12 rounded-full shadow-2xl border border-slate-600 backdrop-blur">
                                            <i class="fa-solid fa-times text-xl"></i>
                                        </button>

                                        <!-- Toggle Panels (only in editor fullscreen) -->
                                        <div v-if="isFullscreenEditor" class="absolute top-6 right-24 z-[999999] flex gap-3">
                                            <!-- Bouton Play ajouté en plein écran -->
                                            <button @click.stop="togglePlayPreview(fKey)" 
                                                class="bg-blue-600/80 hover:bg-blue-500 text-white px-4 h-12 rounded-full shadow-2xl border border-blue-400 backdrop-blur flex items-center gap-2 font-bold transition mr-4">
                                                <i class="fa-solid" :class="isPlaying ? 'fa-pause' : 'fa-play'"></i> {{ isPlaying ? 'Pause' : 'Play' }}
                                            </button>
                                            
                                            <button @click.stop="showFsProps = !showFsProps" 
                                                class="bg-slate-800/80 hover:bg-slate-700 text-white px-4 h-12 rounded-full shadow-2xl border border-slate-600 backdrop-blur flex items-center gap-2 font-bold transition"
                                                :class="{'ring-2 ring-blue-500 text-blue-400': showFsProps}">
                                                <i class="fa-solid fa-sliders"></i> Propriétés
                                            </button>
                                            <button @click.stop="showFsTimeline = !showFsTimeline" 
                                                class="bg-slate-800/80 hover:bg-slate-700 text-white px-4 h-12 rounded-full shadow-2xl border border-slate-600 backdrop-blur flex items-center gap-2 font-bold transition"
                                                :class="{'ring-2 ring-blue-500 text-blue-400': showFsTimeline}">
                                                <i class="fa-solid fa-layer-group"></i> Timeline
                                            </button>
                                        </div>

                                        <!-- The Mockup scaled -->
                                        <div class="tv-mockup select-none absolute top-0 left-0 origin-top-left"
                                            :class="{'editor-paused': isEditorPaused, 'overflow-hidden': !isFullscreenEditor}"
                                            :style="menuData.orientation === 'vertical' ? 'width: 1080px; height: 1920px; transform: scale(0.2531);' : 'width: 1920px; height: 1080px; transform: scale(0.45);'"
                                            :id="'mockup-'+fKey"
                                            @contextmenu.prevent="handleContextMenu($event, fKey, null)"
                                            @dragover.prevent @drop.prevent="handleCanvasDrop($event, fKey)">

                                            <!-- Background Color Layer -->
                                            <div class="absolute inset-0 z-0"
                                                @mousedown="activeCompIndex = 'background'; multiSelect = []"
                                                :style="{ background: getBgColorStyle(formule), opacity: 0.8, boxShadow: formule.isBgNeon ? `inset 0 0 150px #ffffff, inset 0 0 300px ${formule.bgColor || '#000000'}` : 'none', filter: formule.isBgNeon ? 'brightness(1.5) saturate(1.5)' : 'none' }">
                                            </div>
                                            <!-- Background Image Layer with Mask -->
                                            <div v-if="formule.bgImage" class="absolute inset-0 z-0 opacity-80 pointer-events-none"
                                                :style="{ background: `url(/${formule.bgImage}) center/cover no-repeat`, WebkitMaskImage: getMaskStyle(formule), maskImage: getMaskStyle(formule) }">
                                            </div>

                                            <!-- Visual Guides (Rulers) for alignment -->
                                            <div v-if="showGuides"
                                                class="absolute inset-0 pointer-events-none z-[9999]">
                                                <!-- Horizontal movable line -->
                                                <div class="absolute left-0 w-full h-[2px] bg-cyan-400/80 shadow-[0_0_5px_cyan] border-y border-cyan-200/50"
                                                    :style="{ top: guideY + '%', transform: 'translateY(-50%)' }"></div>
                                                <!-- Fixed Vertical Center Line -->
                                                <div class="absolute top-0 left-1/2 h-full w-[2px] bg-cyan-400/80 shadow-[0_0_5px_cyan] border-x border-cyan-200/50"
                                                    style="transform: translateX(-50%);"></div>

                                                <!-- Thirds Grid -->
                                                <div
                                                    class="absolute top-1/3 left-0 w-full h-[1px] bg-magenta-400/40 border-b border-dashed border-white/50">
                                                </div>
                                                <div
                                                    class="absolute top-2/3 left-0 w-full h-[1px] bg-magenta-400/40 border-b border-dashed border-white/50">
                                                </div>
                                                <div
                                                    class="absolute top-0 left-1/3 h-full w-[1px] bg-magenta-400/40 border-r border-dashed border-white/50">
                                                </div>
                                                <div
                                                    class="absolute top-0 left-2/3 h-full w-[1px] bg-magenta-400/40 border-r border-dashed border-white/50">
                                                </div>

                                                <!-- Center Dot -->
                                                <div class="absolute left-1/2 w-4 h-4 bg-red-500 rounded-full shadow-[0_0_10px_red]"
                                                    :style="{ top: guideY + '%', transform: 'translate(-50%, -50%)' }">
                                                </div>
                                            </div>

                                            <!-- Static Header Mock removed in favor of draggable layouts below -->

                                            <!-- Components Scene -->
                                            <div class="absolute top-[350px] left-1/2 w-0 h-0 overflow-visible z-10"
                                                v-if="formule.components && Array.isArray(formule.components)">
                                                <div v-for="(comp, cIdx) in formule.components" :key="'wrap'+cIdx"
                                                    class="dyn-element absolute top-0 left-0 w-0 h-0 overflow-visible z-10"
                                                    v-show="isCompVisibleInTimeline(fKey, comp)"
                                                    :style="{ transform: `translate(${comp.x}px, ${comp.y}px) scale(${comp.scale})`, zIndex: isSelected(fKey, cIdx) ? 999999 : comp.z, opacity: comp.opacity ?? 1, pointerEvents: comp.locked ? 'none' : 'auto' }">

                                                    <!-- Floating Toolbar removed as per user request -->

                                                    <div class="absolute w-max h-max"
                                                        :style="{ transform: `translate(-50%, -50%) rotate(${comp.rotation || 0}deg)` }">
                                                        <div
                                                            :style="{ transform: `scaleX(${(comp.flipX || comp.flip ? -1 : 1) * (comp.scaleX || 1)}) scaleY(${(comp.flipY ? -1 : 1) * (comp.scaleY || 1)})` }">
                                                            <div :id="'mockup-anim-' + fKey + '-' + cIdx">
                                                                <img v-if="comp.type === 'main'"
                                                                    :src="getAssetUrl(comp.assetId)"
                                                                    @mousedown.prevent="startDrag($event, fKey, cIdx)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, cIdx)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, cIdx)"
                                                                    @dblclick="promptImageReplacement($event, fKey, cIdx)"
                                                                    :class="[{'active-item': isSelected(fKey, cIdx)}, comp.continuousAnim && comp.continuousAnim !== 'none' ? 'anim-' + comp.continuousAnim : '', comp.hasShadow !== false ? 'drop-shadow-[0_20px_30px_rgba(0,0,0,0.6)]' : '']"
                                                                    class="preview-item filter"
                                                                    :style="{ maxWidth: comp.fillScreen ? 'none' : (isSmallItem(comp.assetId) ? '400px' : '900px'), width: comp.fillScreen ? (menuData.orientation === 'vertical' ? '1080px' : '1920px') : 'auto', height: comp.fillScreen ? (menuData.orientation === 'vertical' ? '1920px' : '1080px') : 'auto', objectFit: comp.fillScreen ? 'cover' : 'contain', clipPath: getClipPathStyle(comp), WebkitMaskImage: getMaskStyle(comp), maskImage: getMaskStyle(comp) }">

                                                                <div v-if="comp.type === 'customText'"
                                                                    @mousedown.prevent="startDrag($event, fKey, cIdx)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, cIdx)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, cIdx)"
                                                                    @dblclick="promptTextEdit($event, fKey, cIdx)"
                                                                    :class="[{'ring-4 ring-indigo-500 rounded-lg p-2': isSelected(fKey, cIdx)}, comp.continuousAnim && comp.continuousAnim !== 'none' ? 'anim-' + comp.continuousAnim : '']"
                                                                    class="cursor-pointer" :style="getTextStyle(comp)">
                                                                    <div v-html="comp.content || '&nbsp;'"></div>
                                                                </div>

                                                                <div v-if="comp.type === 'shape'"
                                                                    @mousedown.prevent="startDrag($event, fKey, cIdx)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, cIdx)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, cIdx)"
                                                                    @dblclick="promptTextEdit($event, fKey, cIdx)"
                                                                    :class="[{'ring-4 ring-pink-500': isSelected(fKey, cIdx)}, comp.continuousAnim && comp.continuousAnim !== 'none' ? 'anim-' + comp.continuousAnim : '']"
                                                                    class="cursor-pointer flex items-center justify-center font-bold"
                                                                    :style="[getShapeStyle(comp), { color: comp.textColor || '#ffffff', fontSize: (comp.fontSize || 40) + 'px', WebkitMaskImage: getMaskStyle(comp), maskImage: getMaskStyle(comp) }]">
                                                                    <div v-html="comp.content || '&nbsp;'"></div>
                                                                </div>

                                                                <img v-if="comp.type === 'rawImage'"
                                                                    :src="comp.url && comp.url.startsWith('http') ? comp.url : '/' + comp.url"
                                                                    @mousedown.prevent="startDrag($event, fKey, cIdx)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, cIdx)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, cIdx)"
                                                                    @dblclick="promptImageReplacement($event, fKey, cIdx)"
                                                                    :class="[{'ring-4 ring-blue-500': isSelected(fKey, cIdx)}, comp.continuousAnim && comp.continuousAnim !== 'none' ? 'anim-' + comp.continuousAnim : '']"
                                                                    class="preview-item cursor-pointer"
                                                                    :style="{ maxWidth: comp.fillScreen ? 'none' : '2500px', width: comp.fillScreen ? (menuData.orientation === 'vertical' ? '1080px' : '1920px') : 'auto', height: comp.fillScreen ? (menuData.orientation === 'vertical' ? '1920px' : '1080px') : 'auto', objectFit: comp.fillScreen ? 'cover' : 'contain', clipPath: `inset(${comp.clipTop || 0}% ${comp.clipRight || 0}% ${comp.clipBottom || 0}% ${comp.clipLeft || 0}%)`, WebkitMaskImage: getMaskStyle(comp), maskImage: getMaskStyle(comp) }">

                                                                <video v-if="comp.type === 'rawVideo'"
                                                                    :src="comp.url && comp.url.startsWith('http') ? comp.url : '/' + comp.url"
                                                                    @mousedown.prevent="startDrag($event, fKey, cIdx)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, cIdx)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, cIdx)"
                                                                    @dblclick="promptImageReplacement($event, fKey, cIdx)"
                                                                    :class="[{'ring-4 ring-blue-500': isSelected(fKey, cIdx)}, comp.continuousAnim && comp.continuousAnim !== 'none' ? 'anim-' + comp.continuousAnim : '']"
                                                                    class="preview-item cursor-pointer" autoplay loop
                                                                    muted playsinline
                                                                    :style="{ maxWidth: '2500px', clipPath: `inset(${comp.clipTop || 0}% ${comp.clipRight || 0}% ${comp.clipBottom || 0}% ${comp.clipLeft || 0}%)` }"></video>
                                                            </div>
                                                        </div>

                                                        <!-- Canvas Style Resize Box for Components -->
                                                        <div v-if="isActive(fKey, cIdx) && isFreeTransformMode"
                                                            class="absolute inset-0 pointer-events-none"
                                                            style="border: 2px solid #8b5cf6; z-index: 999; margin: -4px;">
                                                            <!-- Delete Button -->
                                                            <div @mousedown.prevent.stop="removeComponent(formule, fKey, cIdx)"
                                                                class="absolute -top-4 -right-4 w-8 h-8 bg-red-600 hover:bg-red-500 text-white rounded-full flex justify-center items-center cursor-pointer shadow-lg pointer-events-auto border-2 border-white"
                                                                title="Supprimer cet élément">
                                                                <i class="fa fa-trash text-xs"></i>
                                                            </div>
                                                            <!-- Corners for Scaling -->
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -left-2 cursor-nwse-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'nw')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -right-2 cursor-nesw-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'ne')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -left-2 cursor-nesw-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'sw')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -right-2 cursor-nwse-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'se')">
                                                            </div>

                                                            <!-- Edges for Width/Height/Scale -->
                                                            <template v-if="true">
                                                                <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -left-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'w')"
                                                                    title="Ajuster la largeur"></div>
                                                                <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -right-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'e')"
                                                                    title="Ajuster la largeur"></div>
                                                                <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -top-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'n')"
                                                                    title="Ajuster la hauteur"></div>
                                                                <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -bottom-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 's')"
                                                                    title="Ajuster la hauteur"></div>
                                                            </template>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Draggable Texts Scene -->
                                            <div class="absolute top-[540px] left-1/2 w-0 h-0 overflow-visible z-20"
                                                v-if="formule.nameLayout">
                                                <template
                                                    v-for="tKey in ['nameLayout', 'descLayout', 'badgeLayout', 'priceLayout']"
                                                    :key="tKey">
                                                    <div v-if="formule[tKey]"
                                                        v-show="isLayoutVisibleInTimeline(fKey, tKey)"
                                                        class="absolute top-0 left-0 w-0 h-0 overflow-visible"
                                                        :style="{ transform: `translate(${formule[tKey].x}px, ${formule[tKey].y}px) scale(${formule[tKey].scale})`, zIndex: formule[tKey].z }">

                                                        <!-- Floating Toolbar removed as per user request -->

                                                        <div class="absolute w-max h-max pointer-events-auto"
                                                            :style="{ transform: `translate(-50%, -50%) rotate(${formule[tKey].rotation || 0}deg)` }">
                                                            <div :id="'mockup-anim-' + fKey + '-' + tKey" style="position: relative;">
                                                                <div @mousedown.prevent="startDrag($event, fKey, tKey)"
                                                                    @contextmenu.stop.prevent="handleContextMenu($event, fKey, tKey)"
                                                                    @wheel.prevent="handleScrollZoom($event, fKey, tKey)"
                                                                    :class="[formule[tKey].continuousAnim && formule[tKey].continuousAnim !== 'none' ? 'anim-' + formule[tKey].continuousAnim : '']"
                                                                    class="cursor-pointer">

                                                                    <!-- Canvas Style Resize Box -->
                                                                    <div v-if="isActive(fKey, tKey) && !formule[tKey].locked && isFreeTransformMode"
                                                                        class="absolute inset-0 pointer-events-none"
                                                                        style="border: 2px solid #8b5cf6; z-index: 999; margin: -4px;">
                                                                        <!-- Delete Button -->
                                                                        <div @mousedown.prevent.stop="removeLayoutComponent(fKey, tKey)"
                                                                            class="absolute -top-4 -right-4 w-8 h-8 bg-red-600 hover:bg-red-500 text-white rounded-full flex justify-center items-center cursor-pointer shadow-lg pointer-events-auto border-2 border-white"
                                                                            title="Cacher cet élément">
                                                                            <i class="fa fa-eye-slash text-xs"></i>
                                                                        </div>
                                                                        <!-- Corners for Scaling -->
                                                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -left-2 cursor-nwse-resize pointer-events-auto"
                                                                            @mousedown.prevent.stop="startResize($event, 'nw')">
                                                                        </div>
                                                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -right-2 cursor-nesw-resize pointer-events-auto"
                                                                            @mousedown.prevent.stop="startResize($event, 'ne')">
                                                                        </div>
                                                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -left-2 cursor-nesw-resize pointer-events-auto"
                                                                            @mousedown.prevent.stop="startResize($event, 'sw')">
                                                                        </div>
                                                                        <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -right-2 cursor-nwse-resize pointer-events-auto"
                                                                            @mousedown.prevent.stop="startResize($event, 'se')">
                                                                        </div>
                                                                    </div>

                                                                    <div v-if="tKey === 'nameLayout'"
                                                                        @dblclick="promptTextEdit($event, fKey, tKey)"
                                                                        class="mock-title m-0 text-center"
                                                                        :style="{ color: formule.nameLayout.color || 'white' }"
                                                                        style="position:static; transform:none; letter-spacing: -2px;">
                                                                        {{ formule.name }}</div>
                                                                    <div v-if="tKey === 'descLayout'"
                                                                        @dblclick="promptTextEdit($event, fKey, tKey)"
                                                                        class="mock-desc m-0 text-center"
                                                                        :style="{ color: formule.descLayout.color || (index % 2 === 0 ? '#DA291C' : '#FFC72C') }"
                                                                        style="position:static; transform:none; font-size:20px;">
                                                                        {{ formule.description }}</div>
                                                                    <div v-if="tKey === 'badgeLayout'"
                                                                        @dblclick="promptTextEdit($event, fKey, tKey)"
                                                                        class="mock-badge m-0 text-center"
                                                                        :style="{ background: formule.badgeLayout.bgColor || (index % 2 === 0 ? '#DA291C' : '#FFC72C'), color: formule.badgeLayout.color || (index % 2 === 0 ? 'white' : '#111'), borderRadius: formule.badgeLayout.shapeType === 'circle' ? '50%' : (formule.badgeLayout.shapeType === 'rect' ? '10px' : (formule.badgeLayout.shapeType === 'badge' ? '0' : '')), clipPath: formule.badgeLayout.shapeType === 'badge' ? 'polygon(50% 0%, 80% 10%, 100% 35%, 100% 70%, 80% 90%, 50% 100%, 20% 90%, 0% 70%, 0% 35%, 20% 10%)' : 'none' }"
                                                                        style="position:static; transform:none; display:block;">
                                                                        {{ formule.badge }}</div>

                                                                    <div v-if="tKey === 'priceLayout'"
                                                                        @dblclick="promptTextEdit($event, fKey, tKey)"
                                                                        class="mock-price price-mock m-0 flex flex-col justify-center items-center"
                                                                        :style="{ background: formule.priceLayout.bgColor || (index % 2 === 0 ? '#DA291C' : '#FFC72C'), borderColor: formule.priceLayout.borderColor || (index % 2 === 0 ? '#FFC72C' : '#DA291C'), borderRadius: formule.priceLayout.shapeType === 'rect' ? '20px' : (formule.priceLayout.shapeType === 'circle' ? '50%' : (formule.priceLayout.shapeType === 'badge' ? '0' : '50%')), clipPath: formule.priceLayout.shapeType === 'badge' ? 'polygon(50% 0%, 80% 10%, 100% 35%, 100% 70%, 80% 90%, 50% 100%, 20% 90%, 0% 70%, 0% 35%, 20% 10%)' : 'none', borderWidth: formule.priceLayout.shapeType === 'badge' ? '0' : '8px' }"
                                                                        style="position:static; transform:none; width: 220px; height: 220px;">
                                                                        <span
                                                                            :style="{ color: formule.priceLayout.color || (index % 2 === 0 ? 'white' : '#111') }"
                                                                            style="font-size: 85px; position:static;">{{
                                                                            formule.price }}</span>
                                                                    </div>

                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Canvas Style Resize Box -->
                                                        <div v-if="isActive(fKey, tKey)"
                                                            class="absolute inset-0 pointer-events-none"
                                                            style="border: 2px solid #8b5cf6; z-index: 999; margin: -4px;">
                                                            <!-- Corners for Scaling -->
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -left-2 cursor-nwse-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'nw')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -right-2 cursor-nesw-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'ne')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -left-2 cursor-nesw-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'sw')">
                                                            </div>
                                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -right-2 cursor-nwse-resize pointer-events-auto"
                                                                @mousedown.prevent.stop="startResize($event, 'se')">
                                                            </div>

                                                            <!-- Edges for Width/Height -->
                                                            <template
                                                                v-if="formule[tKey].type === 'shape' || isFreeTransformMode">
                                                                <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -left-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'w')"
                                                                    title="Ajuster la largeur"></div>
                                                            <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -right-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'e')"
                                                                    title="Ajuster la largeur"></div>
                                                                <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -top-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 'n')"
                                                                    title="Ajuster la hauteur"></div>
                                                                <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -bottom-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto"
                                                                    @mousedown.prevent.stop="startResize($event, 's')"
                                                                    title="Ajuster la hauteur"></div>
                                                            </template>
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                            <div :id="'effect-layer-' + fKey"
                                                class="absolute inset-0 z-50 pointer-events-none overflow-hidden"></div>
                                        </div>
                                    </div>
                                    <p class="text-[10px] text-slate-500 mt-2 mb-4 text-center">Glissez et déposez les
                                        images pour les déplacer.</p>

                                    <!-- CapCut Style Timeline -->
                                    <div class="bg-slate-900 border border-slate-700 rounded-lg p-2 overflow-hidden flex flex-col relative select-none shadow-inner"
                                        :class="{'fs-floating-panel': isFullscreenEditor}"
                                        @mousedown="activeSelectionType = 'timeline'"
                                        :style="isFullscreenEditor ? { left: fsPanels.timeline.x + 'px', top: fsPanels.timeline.y + 'px', width: fsPanels.timeline.w + 'px', height: fsPanels.timeline.h + 'px', right: 'auto', bottom: 'auto' } : {}"
                                        v-if="formule && (!isFullscreenEditor || showFsTimeline)">
                                        
                                        <!-- Free Transform Box -->
                                        <div v-if="isFullscreenEditor && activeSelectionType === 'timeline' && isFreeTransformMode" class="absolute inset-0 pointer-events-none" style="border: 2px solid #8b5cf6; z-index: 9999;">
                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -left-2 cursor-nwse-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'nw', 'timeline')"></div>
                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -top-2 -right-2 cursor-nesw-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'ne', 'timeline')"></div>
                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -left-2 cursor-nesw-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'sw', 'timeline')"></div>
                                            <div class="absolute w-4 h-4 bg-white border-2 border-purple-500 rounded-full -bottom-2 -right-2 cursor-nwse-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'se', 'timeline')"></div>
                                            <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -left-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'w', 'timeline')"></div>
                                            <div class="absolute w-6 h-2 bg-white border-2 border-purple-500 rounded-full top-1/2 -right-2 -translate-y-1/2 cursor-ew-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'e', 'timeline')"></div>
                                            <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -top-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 'n', 'timeline')"></div>
                                            <div class="absolute w-2 h-6 bg-white border-2 border-purple-500 rounded-full -bottom-2 left-1/2 -translate-x-1/2 cursor-ns-resize pointer-events-auto" @mousedown.prevent.stop="startResize($event, 's', 'timeline')"></div>
                                        </div>

                                        <div
                                            class="text-xs font-bold text-slate-400 mb-2 px-2 flex justify-between items-center"
                                            :class="{'fs-drag-handle bg-slate-800 p-2 rounded text-white cursor-move': isFullscreenEditor}"
                                            @mousedown.prevent.stop="isFullscreenEditor && startFsDrag($event, 'timeline')">
                                            <span><i class="fa-solid fa-layer-group text-blue-500"></i> Timeline
                                                (Montage)</span>
                                            <span class="font-mono bg-slate-800 px-2 py-1 rounded text-blue-400">{{
                                                displayTime(previewProgress * (formule.duration || 6) / 100) }} / {{
                                                displayTime(formule.duration || 6) }}</span>
                                        </div>

                                        <!-- Timeline Head (Ruler) -->
                                        <div class="h-6 relative border-b border-slate-700 ml-24 mr-4 mb-2 cursor-pointer"
                                            @mousedown="setPlayhead($event, fKey)"
                                            @mousemove="dragPlayhead($event, fKey)">
                                            <!-- Ticks -->
                                            <div
                                                class="absolute inset-0 bg-[url('data:image/svg+xml;utf8,<svg width=\'20\' height=\'10\' xmlns=\'http://www.w3.org/2000/svg\'><line x1=\'0\' y1=\'5\' x2=\'0\' y2=\'10\' stroke=\'%23475569\' stroke-width=\'1\'/></svg>')]">
                                            </div>
                                            <!-- Playhead indicator -->
                                            <div class="absolute top-0 bottom-[-300px] w-px bg-red-500 z-50 pointer-events-none"
                                                :style="{ left: previewProgress + '%' }">
                                                <div
                                                    class="w-3 h-3 bg-red-500 rounded-full absolute -top-1.5 -left-1.5 shadow-[0_0_10px_rgba(239,68,68,0.8)]">
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Tracks Container -->
                                        <div
                                            class="flex-1 overflow-y-auto max-h-[250px] space-y-1 relative pr-4 pb-4 timeline-tracks">

                                            <!-- Unified Track for all layers (Layout + Components) sorted by Z-Index -->
                                            <div v-for="layer in getAllLayers(fKey)" :key="layer.key"
                                                class="flex items-center group mt-1 transition-all duration-200 border border-transparent timeline-track-row"
                                                :data-layer-key="layer.key"
                                                :class="{'opacity-50': dragLayerIndex === layer.key, 'border-t-2 border-blue-500 pt-1 -mt-1': dragLayerHoverIndex === layer.key}"
                                                @dragover.prevent="dragLayerHoverIndex = layer.key"
                                                @dragleave.prevent="dragLayerHoverIndex = null"
                                                @drop="onTrackDrop($event, fKey, layer.key)">

                                                <div class="w-32 shrink-0 text-[10px] text-slate-400 truncate pr-2 flex items-center gap-1 cursor-ns-resize"
                                                    :class="{'text-blue-400 font-bold': isSelected(fKey, layer.key) || layer.clips.some(c => isSelected(fKey, c.key))}"
                                                    draggable="true"
                                                    @dragstart="onTrackDragStart($event, fKey, layer.key)"
                                                    @dragend="onTrackDragEnd"
                                                    title="Glisser pour réorganiser (Z-Index)">
                                                    <input type="checkbox" :value="layer.key" v-model="multiSelect" @click.stop title="Sélection multiple" class="w-3 h-3 cursor-pointer mr-1 bg-slate-800 border-slate-600 rounded">
                                                    <i
                                                        class="fa-solid fa-grip-vertical text-slate-600 mr-1 hover:text-white cursor-grab"></i>

                                                    <!-- Layout texts -->
                                                    <template v-if="layer.type === 'layout'">
                                                        <span v-if="layer.key === 'nameLayout'" class="truncate"><i
                                                                class="fa-solid fa-heading mr-1"></i> {{ formule.name
                                                            }}</span>
                                                        <span v-if="layer.key === 'descLayout'" class="truncate"><i
                                                                class="fa-solid fa-align-left mr-1"></i> {{
                                                            formule.description }}</span>
                                                        <span v-if="layer.key === 'badgeLayout'" class="truncate"><i
                                                                class="fa-solid fa-certificate mr-1"></i> {{
                                                            formule.badge }}</span>
                                                        <span v-if="layer.key === 'priceLayout'" class="truncate"><i
                                                                class="fa-solid fa-tag mr-1"></i> {{ formule.price
                                                            }}</span>
                                                    </template>

                                                    <!-- Components -->
                                                    <template v-else-if="layer.type === 'background'">
                                                        <span class="truncate pointer-events-none text-slate-400 font-bold"><i class="fa-solid fa-fill-drip mr-1"></i> Arrière-plan</span>
                                                    </template>
                                                    <template v-else>
                                                        <template
                                                            v-if="layer.mainComp.type === 'main' || layer.mainComp.type === 'rawImage'">
                                                            <img :src="layer.mainComp.type === 'main' ? getAssetUrl(layer.mainComp.assetId) : ('/' + layer.mainComp.url)"
                                                                class="w-6 h-6 object-contain bg-slate-900 rounded border border-slate-700 pointer-events-none">
                                                            <span class="truncate pointer-events-none">Image</span>
                                                        </template>
                                                        <span v-else-if="layer.mainComp.type === 'customText'"
                                                            class="truncate pointer-events-none"><i
                                                                class="fa-solid fa-font mr-1"></i> {{ layer.mainComp.content
                                                            }}</span>
                                                        <span v-else-if="layer.mainComp.type === 'shape'"
                                                            class="truncate pointer-events-none"><i
                                                                class="fa-solid fa-shapes mr-1"></i> Forme</span>
                                                    </template>
                                                    <div class="ml-auto flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                                        <button v-if="layer.type !== 'background'" @click.stop="splitTimelineClip(fKey, layer.key)"
                                                            class="text-amber-500 hover:text-amber-400"
                                                            title="Couper ce clip en deux (Scinder)">
                                                            <i class="fa-solid fa-scissors text-xs"></i>
                                                        </button>
                                                        <button v-if="layer.type !== 'background'" @click.stop="deleteComponentDirect(fKey, layer.key)"
                                                            class="text-red-500 hover:text-red-400"
                                                            title="Supprimer">
                                                            <i class="fa-solid fa-trash text-xs"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <div class="flex-1 h-8 bg-slate-800 rounded relative overflow-hidden group-hover:bg-slate-700 transition-colors"
                                                    @mousedown="setPlayhead($event, fKey)"
                                                    @mousemove="dragPlayhead($event, fKey)">
                                                    
                                                    <div v-for="clipLayer in layer.clips" :key="clipLayer.key"
                                                        class="absolute h-full rounded cursor-move opacity-80 hover:opacity-100 flex items-center px-1 text-[10px] text-white overflow-hidden"
                                                        :class="[
                                                             isSelected(fKey, clipLayer.key) ? 'ring-2 ring-white opacity-100 z-10' : '',
                                                             clipLayer.comp.continuousAnim && clipLayer.comp.continuousAnim !== 'none' 
                                                                ? 'bg-[repeating-linear-gradient(45deg,transparent,transparent_10px,rgba(255,255,255,0.2)_10px,rgba(255,255,255,0.2)_20px)] bg-indigo-600 border border-indigo-400 shadow-[0_0_15px_rgba(79,70,229,0.7)]'
                                                                : (clipLayer.type !== 'layout' ? 'bg-emerald-600 border border-emerald-400 shadow-[0_0_10px_rgba(5,150,105,0.5)]' : 'bg-blue-600 border border-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.5)]')
                                                         ]" :style="{ 
                                                             left: ((clipLayer.comp.delay || 0) / (formule.duration || 6) * 100) + '%', 
                                                             width: (((clipLayer.comp.exitTime || formule.duration || 6) - (clipLayer.comp.delay || 0)) / (formule.duration || 6) * 100) + '%' 
                                                         }"
                                                        @mousedown.stop="startDragTimelineClip($event, fKey, clipLayer.key)"
                                                        @dblclick.stop="wiggleElement(fKey, clipLayer.key)">

                                                        <template v-if="clipLayer.type === 'background'">
                                                            <span class="truncate pointer-events-none px-2 font-bold opacity-80 text-[10px]">Arrière-plan (Toujours visible)</span>
                                                        </template>
                                                        <template v-else-if="clipLayer.type === 'layout'">
                                                            <span v-if="clipLayer.key === 'nameLayout'"
                                                                class="truncate pointer-events-none px-2">{{
                                                                formule.name }}</span>
                                                            <span v-if="clipLayer.key === 'descLayout'"
                                                                class="truncate pointer-events-none px-2">{{
                                                                formule.description }}</span>
                                                            <span v-if="clipLayer.key === 'badgeLayout'"
                                                                class="truncate pointer-events-none px-2">{{
                                                                formule.badge }}</span>
                                                            <span v-if="clipLayer.key === 'priceLayout'"
                                                                class="truncate pointer-events-none px-2">{{
                                                                formule.price }}</span>
                                                        </template>
                                                        <template v-else>
                                                            <template
                                                                v-if="clipLayer.comp.type === 'main' || clipLayer.comp.type === 'rawImage'">
                                                                <img :src="clipLayer.comp.type === 'main' ? getAssetUrl(clipLayer.comp.assetId) : ('/' + clipLayer.comp.url)"
                                                                    class="h-7 w-7 object-contain mr-1 pointer-events-none drop-shadow">
                                                            </template>
                                                            <span v-else-if="clipLayer.comp.type === 'customText'"
                                                                class="truncate pointer-events-none px-2">{{
                                                                clipLayer.comp.content }}</span>
                                                            <span v-else-if="clipLayer.comp.type === 'shape'"
                                                                class="truncate pointer-events-none px-2">Forme</span>
                                                        </template>

                                                        <div class="absolute left-0 top-0 bottom-0 w-3 cursor-col-resize bg-white/20 hover:bg-white/70 flex justify-center items-center"
                                                            @mousedown.stop="startResizeTimelineClip($event, fKey, clipLayer.key, 'left')">
                                                            <div class="w-px h-3 bg-white"></div>
                                                        </div>
                                                        <div class="absolute right-0 top-0 bottom-0 w-3 cursor-col-resize bg-white/20 hover:bg-white/70 flex justify-center items-center"
                                                            @mousedown.stop="startResizeTimelineClip($event, fKey, clipLayer.key, 'right')">
                                                            <div class="w-px h-3 bg-white"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Assets Library -->
                <div v-if="currentTab === 'assets'">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-2xl font-bold">Bibliothèque des Produits</h2>
                    </div>
                    <div v-for="(categoryList, catName) in menuData.assets" :key="catName" class="mb-10">
                        <div class="flex justify-between items-center border-b border-slate-700 pb-2 mb-4">
                            <h3 class="text-xl font-bold uppercase tracking-wider text-slate-400">{{ catName }}</h3>
                            <button @click="addAsset(catName)"
                                class="bg-blue-600 hover:bg-blue-700 text-xs px-3 py-1 rounded"><i
                                    class="fa fa-plus"></i> Nouveau Produit</button>
                        </div>
                        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                            <div v-for="(asset, idx) in categoryList" :key="idx"
                                class="glass-panel p-4 rounded-lg flex flex-col gap-2 relative">
                                <button @click="categoryList.splice(idx, 1)"
                                    class="absolute top-2 right-2 text-red-500 hover:text-red-400"><i
                                        class="fa fa-times"></i></button>
                                <img :src="'/' + asset.url"
                                    class="h-24 object-contain mx-auto mb-2 bg-slate-900/50 rounded p-1"
                                    onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMDAiIGhlaWdodD0iMTAwIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzMzMyIvPjx0ZXh0IHg9IjUwIiB5PSI1MCIgZm9udC1mYW1pbHk9InNhbnMtc2VyaWYiIGZvbnQtc2l6ZT0iMTIiIHRleHQtYW5jaG9yPSJtaWRkbGUiIGZpbGw9IiM5OTkiPkluY29ubnU8L3RleHQ+PC9zdmc+'">
                                <div><label class="text-[10px] text-slate-500 uppercase">ID Unique</label><input
                                        v-model="asset.id" class="input-field text-xs py-1"></div>
                                <div><label class="text-[10px] text-slate-500 uppercase">Nom</label><input
                                        v-model="asset.name" class="input-field text-xs py-1"></div>
                                <div><label
                                        class="bg-slate-700 hover:bg-slate-600 text-center block rounded py-1 text-xs cursor-pointer mt-2">Upload
                                        Image<input type="file" @change="uploadAssetFile($event, asset)" class="hidden"
                                            accept="image/*"></label></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Others (Minimal) -->
                <div v-if="currentTab === 'tv1' || currentTab === 'tv3'">
                    <h2 class="text-2xl font-bold mb-6">Géré via menu_data.json pour l'instant</h2>
                </div>
                <!-- Promos -->
                <div v-if="currentTab === 'promos'">
                    <h2 class="text-2xl font-bold mb-6">Médias Promotionnels</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" v-if="menuData.promos">
                        <div class="glass-panel p-6 rounded-xl">
                            <h3 class="text-lg font-bold mb-4">Vidéo Promo</h3>
                            <p class="text-sm mb-2">{{ menuData.promos.video }} ({{ menuData.promos.videoDuration }}s)
                            </p>
                            <label class="block w-full text-center border-2 border-dashed p-8 cursor-pointer">
                                <div class="font-medium">Changer</div><input type="file"
                                    @change="uploadPromoFile($event, 'video')" class="hidden" accept="video/*">
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lasso Tool Modal -->
        <div v-if="showLassoModal"
            class="fixed inset-0 z-[110] flex items-center justify-center bg-black/95 backdrop-blur-sm select-none">
            <div class="relative w-full h-full flex flex-col">
                <div class="flex justify-between items-center p-4 bg-slate-900 border-b border-slate-700">
                    <div>
                        <h2 class="text-xl font-bold text-white"><i class="fa-solid fa-pen-nib text-indigo-400"></i>
                            Outil Plume (Détourage)</h2>
                        <p class="text-xs text-slate-400 mt-1">Cliquez sur l'image pour tracer la zone à conserver.
                            <strong class="text-emerald-400">Cliquez sur le premier point pour fermer la forme.</strong>
                        </p>
                    </div>
                    <div class="flex gap-2">
                        <button @click="lassoPoints = []"
                            class="bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded font-bold transition">Effacer
                            les points</button>
                        <button @click="closeLassoTool"
                            class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded font-bold transition">Annuler</button>
                    </div>
                </div>

                <div class="flex-1 relative overflow-hidden flex items-center justify-center bg-slate-800 p-8"
                    @click="addLassoPoint" @mousemove="updateLassoMouse">
                    <div class="relative max-w-full max-h-full inline-block shadow-2xl" ref="lassoContainer">
                        <img :src="lassoImageUrl" class="max-w-full max-h-full object-contain block pointer-events-none"
                            style="max-height: 70vh;">

                        <!-- SVG Overlay for drawing -->
                        <svg class="absolute inset-0 w-full h-full pointer-events-none overflow-visible"
                            style="z-index: 10;">
                            <!-- Polygon fill if closed -->
                            <polygon v-if="lassoClosed" :points="lassoPointsSvg" fill="rgba(99, 102, 241, 0.2)"
                                stroke="#6366f1" stroke-width="2" />

                            <!-- Lines connecting points -->
                            <polyline v-if="!lassoClosed && lassoPoints.length > 0" :points="lassoPointsSvg" fill="none"
                                stroke="#6366f1" stroke-width="2" stroke-dasharray="4" />

                            <!-- Dynamic line from last point to cursor -->
                            <line v-if="!lassoClosed && lassoPoints.length > 0"
                                :x1="lassoPoints[lassoPoints.length-1].x + '%'"
                                :y1="lassoPoints[lassoPoints.length-1].y + '%'" :x2="lassoMouseX + '%'"
                                :y2="lassoMouseY + '%'" stroke="#6366f1" stroke-width="2" stroke-dasharray="4"
                                opacity="0.5" />

                            <!-- Points -->
                            <circle v-for="(pt, idx) in lassoPoints" :key="idx" :cx="pt.x + '%'" :cy="pt.y + '%'" r="6"
                                :fill="idx === 0 ? '#34d399' : '#6366f1'"
                                class="pointer-events-auto cursor-pointer hover:r-8 transition-all"
                                @click.stop="idx === 0 && lassoPoints.length > 2 ? finishLasso() : null" />
                        </svg>

                        <!-- Overlay masks (to darken outside the polygon) -->
                        <div v-if="lassoClosed" class="absolute inset-0 pointer-events-none"
                            style="background: rgba(0,0,0,0.8);">
                            <div class="w-full h-full"
                                :style="{ clipPath: 'polygon(' + lassoPolygonString + ')', background: 'url(' + lassoImageUrl + ')', backgroundSize: '100% 100%' }">
                            </div>
                        </div>
                    </div>
                </div>

                <div v-if="lassoClosed" class="p-6 bg-slate-900 border-t border-slate-700 flex justify-center">
                    <button @click="applyLasso"
                        class="bg-emerald-600 hover:bg-emerald-500 text-white px-8 py-3 rounded-xl font-bold text-lg shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-all flex items-center gap-2">
                        <i class="fa-solid fa-check"></i> Valider le détourage
                    </button>
                </div>
            </div>
        </div>

        <!-- Template Modal (9walab) -->
        <div v-if="showTemplateModal"
            class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm">
            <div class="glass-panel p-8 rounded-2xl border border-slate-600 w-full max-w-4xl shadow-2xl relative">
                <button @click="showTemplateModal = false"
                    class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl"><i
                        class="fa fa-times"></i></button>
                <h2 class="text-3xl font-bold text-white mb-2 text-center">Choisir un Modèle (9aleb)</h2>
                <p class="text-slate-400 text-center mb-8">Sélectionnez une disposition de départ pour votre nouvel
                    écran.</p>

                <div class="grid grid-cols-3 gap-6">
                    <!-- Hero Classique -->
                    <div @click="applyTemplate('hero')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-emerald-500 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-slate-900 border border-slate-700 rounded mb-4 relative overflow-hidden flex flex-col items-center justify-center">
                            <div class="w-12 h-2 bg-slate-700 rounded mb-1"></div>
                            <div class="w-8 h-8 rounded-full bg-emerald-500/50 mb-1"></div>
                            <div class="w-6 h-6 rounded-full border-2 border-yellow-500 absolute bottom-1 right-2">
                            </div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-emerald-400">Hero Classique</h3>
                        <p class="text-[10px] text-slate-400 mt-1">1 Produit géant, Titre, Prix.</p>
                    </div>

                    <!-- Duo Combo -->
                    <div @click="applyTemplate('duo')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-blue-500 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-slate-900 border border-slate-700 rounded mb-4 relative overflow-hidden flex flex-col items-center justify-center">
                            <div class="w-16 h-2 bg-slate-700 rounded mb-2"></div>
                            <div class="flex gap-2">
                                <div class="w-6 h-6 rounded-full bg-blue-500/50"></div>
                                <div class="w-6 h-6 rounded-full bg-blue-500/50"></div>
                            </div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-blue-400">Duo Combo</h3>
                        <p class="text-[10px] text-slate-400 mt-1">2 Produits côte à côte.</p>
                    </div>

                    <!-- Grille Multi -->
                    <div @click="applyTemplate('grid')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-purple-500 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-slate-900 border border-slate-700 rounded mb-4 relative overflow-hidden flex flex-col justify-center gap-1 p-2">
                            <div class="flex justify-between px-2">
                                <div class="w-5 h-5 rounded-full bg-purple-500/50"></div>
                                <div class="w-5 h-5 rounded-full bg-purple-500/50"></div>
                            </div>
                            <div class="flex justify-between px-2">
                                <div class="w-5 h-5 rounded-full bg-purple-500/50"></div>
                                <div class="w-5 h-5 rounded-full bg-purple-500/50"></div>
                            </div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-purple-400">Grille (KFC Style)</h3>
                        <p class="text-[10px] text-slate-400 mt-1">4 Produits en grille avec prix.</p>
                    </div>

                    <!-- Menu Liste -->
                    <div @click="applyTemplate('list')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-orange-500 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-slate-900 border border-slate-700 rounded mb-4 relative overflow-hidden flex items-center justify-between p-2">
                            <div class="w-8 h-8 rounded-full bg-orange-500/50"></div>
                            <div class="flex flex-col gap-1 w-1/2">
                                <div class="w-full h-1 bg-slate-600 rounded"></div>
                                <div class="w-full h-1 bg-slate-600 rounded"></div>
                                <div class="w-full h-1 bg-slate-600 rounded"></div>
                            </div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-orange-400">Menu Liste</h3>
                        <p class="text-[10px] text-slate-400 mt-1">Image gauche, liste textes droite.</p>
                    </div>

                    <!-- Promo Soleil (PosterMyWall) -->
                    <div @click="applyTemplate('pmw_soleil')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-yellow-400 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-yellow-500/20 border border-yellow-500/50 rounded mb-4 relative flex items-center justify-center overflow-hidden">
                            <div class="w-12 h-12 bg-yellow-500 rounded-full opacity-50 blur-sm absolute"></div>
                            <div class="w-8 h-8 rounded-full bg-orange-500 z-10"></div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-yellow-400">Promo Soleil</h3>
                        <p class="text-[10px] text-slate-400 mt-1">Design Affiche avec macaron.</p>
                    </div>

                    <!-- Offre Badge (PosterMyWall) -->
                    <div @click="applyTemplate('pmw_offre')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-green-400 p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div
                            class="w-24 h-16 bg-green-900/20 border border-green-500/50 rounded mb-4 relative flex items-center justify-around overflow-hidden">
                            <div class="w-6 h-10 bg-red-500/50 rounded-sm"></div>
                            <div class="w-8 h-8 rounded-full bg-orange-500/50"></div>
                            <div class="absolute top-1 right-1 w-4 h-4 bg-yellow-400 rounded-full"></div>
                        </div>
                        <h3 class="font-bold text-white group-hover:text-green-400">Offre Duo Badge</h3>
                        <p class="text-[10px] text-slate-400 mt-1">Menu + Boisson + Promo Badge.</p>
                    </div>

                    <!-- Écran Vide -->
                    <div @click="applyTemplate('blank')"
                        class="bg-slate-800/80 hover:bg-slate-700 border border-slate-600 hover:border-white p-4 rounded-xl cursor-pointer transition-all hover:scale-105 group text-center flex flex-col items-center">
                        <div class="w-24 h-16 bg-slate-900 border border-slate-700 rounded mb-4"></div>
                        <h3 class="font-bold text-white">Écran Vide</h3>
                        <p class="text-[10px] text-slate-400 mt-1">Commencer de zéro.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- IA Generation Tab -->
        <div v-if="currentTab === 'ia'" class="max-w-4xl mx-auto py-12 px-6 text-center">
            <h2
                class="text-4xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 flex justify-center items-center gap-4">
                <i class="fa-solid fa-wand-magic-sparkles text-purple-400"></i> Infographiste IA
            </h2>
            <div
                class="glass-panel p-10 rounded-2xl border border-purple-500/30 shadow-[0_0_50px_rgba(168,85,247,0.15)] relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-48 h-48 bg-purple-500/20 blur-[50px] rounded-full"></div>
                <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-blue-500/20 blur-[50px] rounded-full"></div>

                <p class="text-slate-300 mb-8 text-xl">Décrivez ce que vous voulez créer. L'IA va générer un écran TV
                    complet, positionner les images et configurer les animations !</p>

                <div class="flex flex-col gap-6">
                    <textarea v-model="aiPrompt" @keyup.enter="generateDesign" :disabled="isGenerating"
                        placeholder="Ex: Sawab lia formule jdida dyal tacos m3a frites w boisson f fond rouge..."
                        rows="4"
                        class="w-full bg-slate-900/80 border-2 border-slate-700 text-white px-6 py-4 rounded-xl focus:outline-none focus:border-purple-500 focus:ring-4 focus:ring-purple-500/30 shadow-inner text-lg resize-none"></textarea>

                    <button @click="generateDesign" :disabled="isGenerating || !aiPrompt.trim()"
                        class="bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-500 hover:to-blue-500 text-white px-10 py-5 rounded-xl font-bold transition-all shadow-[0_0_20px_rgba(147,51,234,0.4)] hover:shadow-[0_0_30px_rgba(147,51,234,0.7)] flex justify-center items-center gap-3 text-xl disabled:opacity-50">
                        <i class="fa-solid fa-wand-magic-sparkles" :class="{'fa-spin': isGenerating}"></i>
                        {{ isGenerating ? 'Génération du design en cours...' : 'Générer l\'Écran avec l\'IA (Texte)' }}
                    </button>

                    <div class="relative flex items-center py-5">
                        <div class="flex-grow border-t border-slate-700"></div>
                        <span class="flex-shrink-0 mx-4 text-slate-500 font-bold uppercase tracking-widest text-sm">OU
                            PAR IMAGE</span>
                        <div class="flex-grow border-t border-slate-700"></div>
                    </div>

                    <p class="text-slate-400 text-sm mb-2">Cloner un menu existant (Uploadez une image d'un menu trouvé
                        sur Internet, l'IA recréera la même disposition avec vos images).</p>

                    <label
                        class="relative cursor-pointer bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white px-10 py-5 rounded-xl font-bold transition-all flex justify-center items-center gap-3 text-xl w-full text-center group"
                        :class="{'opacity-50 cursor-not-allowed': isGenerating}">
                        <input type="file" @change="generateDesignFromImage" accept="image/*"
                            class="absolute inset-0 opacity-0 cursor-pointer" :disabled="isGenerating">
                        <i class="fa-solid fa-clone text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        {{ isGenerating ? "Analyse de l'image..." : "Cloner depuis une Image (Nouveau!)" }}
                    </label>

                    <button @click="openInpaintModal"
                        class="mt-4 bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white px-10 py-5 rounded-xl font-bold transition-all flex justify-center items-center gap-3 text-xl w-full text-center group">
                        <i class="fa-solid fa-eraser text-pink-400 group-hover:scale-110 transition-transform"></i>
                        Nettoyer une Image (Gommer texte/images)
                    </button>
                </div>
            </div>
        </div>

        <!-- Context Menu -->
        <div v-if="contextMenu.visible" :style="{ top: contextMenu.y + 'px', left: contextMenu.x + 'px' }"
            class="fixed z-[9999999] w-48 bg-slate-800 border border-slate-600 rounded-lg shadow-2xl py-2 flex flex-col text-sm text-slate-300">
            <template v-if="contextMenu.cIdx !== null">
                <button @click="contextCopy()"
                    class="px-4 py-2 text-left hover:bg-slate-700 hover:text-white flex items-center gap-3"><i
                        class="fa fa-copy w-4 text-blue-400"></i> Copier</button>
                <button @click="contextDuplicate()"
                    class="px-4 py-2 text-left hover:bg-slate-700 hover:text-white flex items-center gap-3"><i
                        class="fa fa-clone w-4 text-emerald-400"></i> Dupliquer</button>
                <div class="h-px bg-slate-700 my-1"></div>

                <div
                    class="group relative px-4 py-2 text-left hover:bg-slate-700 cursor-pointer flex items-center justify-between">
                    <div class="flex items-center gap-3"><i class="fa-solid fa-layer-group w-4 text-slate-400"></i>
                        Calque</div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500"></i>

                    <div
                        class="absolute left-full top-0 ml-1 hidden group-hover:flex flex-col bg-slate-800 border border-slate-600 rounded-lg shadow-xl w-64 text-sm text-slate-200 z-[10000000] py-2">
                        <button @click="moveLayer(contextMenu.fKey, contextMenu.cIdx, 100); hideContextMenu()"
                            class="px-4 py-2 text-left hover:bg-slate-700 flex items-center justify-between">
                            <span class="flex items-center gap-3"><i class="fa-solid fa-arrow-up-from-bracket w-4"></i>
                                Mettre au premier plan</span>
                        </button>
                        <button @click="moveLayer(contextMenu.fKey, contextMenu.cIdx, 1); hideContextMenu()"
                            class="px-4 py-2 text-left hover:bg-slate-700 flex items-center justify-between">
                            <span class="flex items-center gap-3"><i class="fa-solid fa-arrow-up w-4"></i> Faire avancer
                                d'un niveau</span>
                        </button>
                        <button @click="moveLayer(contextMenu.fKey, contextMenu.cIdx, -1); hideContextMenu()"
                            class="px-4 py-2 text-left hover:bg-slate-700 flex items-center justify-between">
                            <span class="flex items-center gap-3"><i class="fa-solid fa-arrow-down w-4"></i> Faire
                                reculer d'un niveau</span>
                        </button>
                        <button @click="moveLayer(contextMenu.fKey, contextMenu.cIdx, -100); hideContextMenu()"
                            class="px-4 py-2 text-left hover:bg-slate-700 flex items-center justify-between">
                            <span class="flex items-center gap-3"><i class="fa-solid fa-arrow-down-to-bracket w-4"></i>
                                Mettre à l'arrière-plan</span>
                        </button>
                        <div class="h-px bg-slate-600 my-1"></div>
                        <button class="px-4 py-2 text-left hover:bg-slate-700 flex items-center gap-3"
                            @click="showLayersPanel(); hideContextMenu()">
                            <i class="fa-solid fa-list-ul w-4"></i> Afficher les calques (Timeline)
                        </button>
                    </div>
                </div>

                <div class="h-px bg-slate-700 my-1"></div>
                <button @click="contextDelete()"
                    class="px-4 py-2 text-left hover:bg-slate-700 hover:text-red-400 flex items-center gap-3"><i
                        class="fa fa-trash w-4 text-red-500"></i> Supprimer</button>
            </template>
            <template v-else>
                <button @click="contextPaste()" :disabled="!clipboardData"
                    :class="{'opacity-50 cursor-not-allowed': !clipboardData}"
                    class="px-4 py-2 text-left hover:bg-slate-700 hover:text-white flex items-center gap-3"><i
                        class="fa fa-paste w-4 text-blue-400"></i> Coller</button>
            </template>
        </div>

        <!-- Hidden file input for image replacement -->
        <input type="file" ref="replaceImageInput" @change="handleReplaceImage" class="hidden" accept="image/*">

        <!-- INPAINT MODAL -->
        <div v-if="inpaint.show"
            class="fixed inset-0 bg-black/95 flex flex-col items-center justify-center z-[1000] p-10">
            <h2 class="text-3xl text-white font-bold mb-4"><i class="fa fa-eraser text-pink-400"></i> Gomme Magique
                (Rapide)</h2>
            <p class="text-slate-400 mb-6">Uploadez une image, puis peignez en rouge (cliquer + glisser) sur le texte ou
                les éléments à gommer.</p>

            <div v-if="!inpaint.image"
                class="w-full max-w-2xl bg-slate-800 border-2 border-dashed border-slate-600 rounded-xl p-10 flex flex-col items-center justify-center">
                <input type="file" @change="onInpaintUpload" accept="image/*" class="text-white text-xl">
            </div>

            <div v-if="inpaint.image && !inpaint.result"
                class="relative bg-black rounded-xl overflow-hidden border border-slate-700 max-h-[60vh] max-w-[80vw]"
                :style="{ cursor: 'crosshair' }">
                <canvas ref="inpaintCanvas" @mousedown="startInpaintDraw" @mousemove="inpaintDraw"
                    @mouseup="stopInpaintDraw" @mouseout="stopInpaintDraw" class="block"></canvas>
            </div>

            <div v-if="inpaint.result"
                class="relative bg-black rounded-xl overflow-hidden border border-slate-700 max-h-[60vh] max-w-[80vw] flex items-center justify-center">
                <img :src="'/' + inpaint.result" class="max-h-[60vh] rounded">
            </div>

            <div class="flex gap-4 mt-8" v-if="inpaint.image">
                <button @click="inpaint.show = false; inpaint.image = null; inpaint.result = null;"
                    class="px-6 py-3 bg-slate-700 text-white rounded-lg font-bold">Fermer</button>
                <button v-if="!inpaint.result" @click="processInpaint" :disabled="inpaint.loading"
                    class="px-6 py-3 bg-pink-600 hover:bg-pink-500 text-white rounded-lg font-bold flex items-center gap-2">
                    <i class="fa fa-wand-magic" :class="{'fa-spin': inpaint.loading}"></i> {{ inpaint.loading ?
                    'Nettoyage en cours...' : 'Nettoyer (Effacer rouge)' }}
                </button>
                <button v-if="inpaint.result" @click="useInpaintAsBg"
                    class="px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-bold flex items-center gap-2">
                    <i class="fa fa-check"></i> Utiliser comme Fond pour l'écran actuel
                </button>
            </div>
        </div>

        <!-- Modal Nouveau Client -->
        <div v-if="showNewProjectModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[999999] flex items-center justify-center" @click.self="showNewProjectModal = false">
            <div class="bg-slate-900 border border-slate-700 rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
                <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 flex justify-between items-center">
                    <h3 class="text-white font-bold text-lg"><i class="fa-solid fa-plus-circle mr-2"></i> Nouveau Client / Projet</h3>
                    <button @click="showNewProjectModal = false" class="text-white hover:text-slate-200 transition"><i class="fa-solid fa-times text-xl"></i></button>
                </div>
                <div class="p-6">
                    <div class="mb-4">
                        <label class="block text-slate-300 text-sm font-bold mb-2">Nom du Client / Projet :</label>
                        <input type="text" v-model="newProjectName" placeholder="Ex: mcdonalds, kfc_rabat..." 
                            @keyup.enter="confirmNewProject"
                            class="w-full bg-slate-800 border-2 border-slate-700 text-white px-4 py-3 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/30 transition shadow-inner">
                        <p class="text-xs text-slate-500 mt-2">Pas d'espaces, uniquement des lettres, chiffres et tirets.</p>
                    </div>
                    <div class="mb-6">
                        <label class="block text-slate-300 text-sm font-bold mb-2">Nombre d'écrans (TV) :</label>
                        <input type="number" min="1" max="20" v-model="newProjectTvs" 
                            @keyup.enter="confirmNewProject"
                            class="w-full bg-slate-800 border-2 border-slate-700 text-white px-4 py-3 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/30 transition shadow-inner">
                    </div>
                    <div class="flex justify-end gap-3">
                        <button @click="showNewProjectModal = false" class="px-5 py-2.5 rounded-xl font-bold text-slate-300 hover:text-white hover:bg-slate-800 transition">Annuler</button>
                        <button @click="confirmNewProject" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2.5 rounded-xl font-bold transition shadow-[0_0_15px_rgba(37,99,235,0.5)] hover:shadow-[0_0_25px_rgba(37,99,235,0.7)] flex items-center gap-2">
                            <i class="fa-solid fa-check"></i> Créer
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    currentTvId: '1',
                    menuData: null, currentTab: 'tv2', notification: null,
                    activeFormuleKey: null, activeCompIndex: null,
                    multiSelect: [], multiDragStart: {}, multiResizeStart: {},
                    isDragging: false, startX: 0, startY: 0, initialCompX: 0, initialCompY: 0, globalMouseX: 0, globalMouseY: 0,
                    playingTimeline: null, isPlaying: false, previewProgress: 0, isEditorPaused: false, showGuides: false, guideY: 50,
                    aiPrompt: '', isGenerating: false,
                    history: [], showTemplateModal: false, showNewProjectModal: false, newProjectName: '', newProjectTvs: 4, isSidebarOpen: true, dragLayerFKey: null,
                    isFullscreenEditor: false,
                    showFsTimeline: true, showFsProps: true,
                    activeSelectionType: null, // 'timeline' | 'props' | 'mockup' | 'component'
                    fsPanels: {
                        timeline: { x: 50, y: 50, w: 800, h: 250, dragging: false, startX: 0, startY: 0 },
                        props: { x: 800, y: 50, w: 320, h: 600, dragging: false, startX: 0, startY: 0 },
                        mockup: { x: 0, y: 0, scale: 0, dragging: false, startX: 0, startY: 0 }
                    },
                    dragLayerIndex: null,
                    dragLayerHoverIndex: null,
                    replaceTarget: null, clipboardData: null,
                    inpaint: { show: false, image: null, loading: false, result: null, isDrawing: false, ctx: null, maskCtx: null },
                    contextMenu: { visible: false, x: 0, y: 0, fKey: null, cIdx: null },
                    timelineDrag: { active: false, fKey: null, cKey: null, mode: null, startX: 0, startVal: 0, startEndVal: 0, timelineWidth: 0, duration: 6, isDraggingPlayhead: false },
                    currentProject: 'default',
                    projects: { 'default': 4 },
                    showLassoModal: false,
                    lassoPoints: [],
                    lassoClosed: false,
                    lassoMouseX: 0,
                    lassoMouseY: 0,
                    isFreeTransformMode: false
                }
            },
            computed: {
                lassoPointsSvg() {
                    return this.lassoPoints.map(p => `${p.x}%,${p.y}%`).join(' ');
                },
                lassoPolygonString() {
                    return this.lassoPoints.map(p => `${p.x}% ${p.y}%`).join(', ');
                },
                activeCompStyleStr() {
                    if (!this.activeFormuleKey || this.activeCompIndex === null) return '';
                    const comp = this.menuData?.formules?.[this.activeFormuleKey]?.components?.[this.activeCompIndex];
                    if (!comp) return '';
                    
                    const {
                        color, color2, bgColor, strokeColor, textColor,
                        opacity, fontSize, fontFamily, letterSpacing, lineHeight,
                        textEffect, effectIntensity, hasShadow, isGradient,
                        animIn, animOut, continuousAnim, delay, exitTime,
                        scale, width, height, shapeType, content, assetId
                    } = comp;
                    
                    return JSON.stringify({
                        color, color2, bgColor, strokeColor, textColor,
                        opacity, fontSize, fontFamily, letterSpacing, lineHeight,
                        textEffect, effectIntensity, hasShadow, isGradient,
                        animIn, animOut, continuousAnim, delay, exitTime,
                        scale, width, height, shapeType, content, assetId
                    });
                }
            },
            watch: {
                activeCompStyleStr(newStr, oldStr) {
                    if (!newStr || !oldStr || newStr === oldStr) return;
                    if (!this.multiSelect || this.multiSelect.length <= 1) return;
                    if (this.isResizing || this.isDragging || this.timelineDrag?.active) return;
                    
                    const newProps = JSON.parse(newStr);
                    const oldProps = JSON.parse(oldStr);
                    
                    const changedProps = {};
                    for (let key in newProps) {
                        if (newProps[key] !== oldProps[key]) {
                            changedProps[key] = newProps[key];
                        }
                    }
                    
                    if (Object.keys(changedProps).length > 0) {
                        this.multiSelect.forEach(idx => {
                            if (idx !== this.activeCompIndex) {
                                const target = this.menuData.formules[this.activeFormuleKey].components[idx];
                                if (target) {
                                    for (let key in changedProps) {
                                        this.$set(target, key, changedProps[key]);
                                    }
                                }
                            }
                        });
                    }
                }
            },
            mounted() {
                this.fetchProjects();
                window.addEventListener('keydown', this.handleKeydown);
                window.addEventListener('click', this.hideContextMenu);
                window.addEventListener('paste', this.handlePaste);

                this._mouseMoveHandler = (e) => {
                    this.globalMouseX = e.clientX;
                    this.globalMouseY = e.clientY;
                };
                window.addEventListener('mousemove', this._mouseMoveHandler);

                this._fullscreenChangeHandler = () => {
                    const isNativeFs = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
                    if (!isNativeFs && this.isFullscreenEditor) {
                        this.isFullscreenEditor = false;
                        document.body.classList.remove('editor-fullscreen');
                    }
                };
                window.addEventListener('fullscreenchange', this._fullscreenChangeHandler);
                window.addEventListener('webkitfullscreenchange', this._fullscreenChangeHandler);
                window.addEventListener('mozfullscreenchange', this._fullscreenChangeHandler);
                window.addEventListener('MSFullscreenChange', this._fullscreenChangeHandler);
            },
            beforeUnmount() {
                window.removeEventListener('keydown', this.handleKeydown);
                window.removeEventListener('click', this.hideContextMenu);
                window.removeEventListener('paste', this.handlePaste);
                if (this._mouseMoveHandler) {
                    window.removeEventListener('mousemove', this._mouseMoveHandler);
                }
                if (this._fullscreenChangeHandler) {
                    window.removeEventListener('fullscreenchange', this._fullscreenChangeHandler);
                    window.removeEventListener('webkitfullscreenchange', this._fullscreenChangeHandler);
                    window.removeEventListener('mozfullscreenchange', this._fullscreenChangeHandler);
                    window.removeEventListener('MSFullscreenChange', this._fullscreenChangeHandler);
                }
            },
            methods: {
                startFsDrag(e, panelName) {
                    const panel = this.fsPanels[panelName];
                    panel.dragging = true;
                    panel.startX = e.clientX - panel.x;
                    panel.startY = e.clientY - panel.y;
                    
                    const moveHandler = (moveEvent) => {
                        if (!panel.dragging) return;
                        panel.x = moveEvent.clientX - panel.startX;
                        panel.y = moveEvent.clientY - panel.startY;
                    };
                    
                    const upHandler = () => {
                        panel.dragging = false;
                        window.removeEventListener('mousemove', moveHandler);
                        window.removeEventListener('mouseup', upHandler);
                    };
                    
                    window.addEventListener('mousemove', moveHandler);
                    window.addEventListener('mouseup', upHandler);
                },
                toggleEditorFullscreen() {
                    this.isFullscreenEditor = !this.isFullscreenEditor;
                    if (this.isFullscreenEditor) {
                        document.body.classList.add('editor-fullscreen');
                        
                        // Set default panel positions for fullscreen
                        this.fsPanels.timeline.x = 20;
                        this.fsPanels.timeline.y = window.innerHeight - 320;
                        this.fsPanels.timeline.w = window.innerWidth - 420 > 800 ? 800 : window.innerWidth - 420;
                        
                        this.fsPanels.props.x = window.innerWidth - 350;
                        this.fsPanels.props.y = 80;
                        this.fsPanels.props.h = window.innerHeight - 150;

                        try {
                            const el = document.documentElement;
                            if (el.requestFullscreen) { el.requestFullscreen(); }
                            else if (el.mozRequestFullScreen) { el.mozRequestFullScreen(); }
                            else if (el.webkitRequestFullscreen) { el.webkitRequestFullscreen(); }
                            else if (el.msRequestFullscreen) { el.msRequestFullscreen(); }
                        } catch (e) {}
                    } else {
                        document.body.classList.remove('editor-fullscreen');
                        try {
                            if (document.exitFullscreen) { document.exitFullscreen(); }
                            else if (document.mozCancelFullScreen) { document.mozCancelFullScreen(); }
                            else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
                            else if (document.msExitFullscreen) { document.msExitFullscreen(); }
                        } catch (e) {}
                    }
                },
                async handlePaste(e) {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;
                    if (!this.activeFormuleKey) return;

                    const items = (e.clipboardData || e.originalEvent.clipboardData).items;
                    let imageFile = null;
                    for (let index in items) {
                        let item = items[index];
                        if (item.kind === 'file' && item.type.startsWith('image/')) {
                            imageFile = item.getAsFile();
                            break;
                        }
                    }

                    if (imageFile) {
                        e.preventDefault();
                        const formData = new FormData();
                        formData.append('file', imageFile);
                        formData.append('target', 'root');
                        
                        try {
                            const response = await fetch('/api/upload', {
                                method: 'POST',
                                body: formData
                            });
                            const result = await response.json();
                            if (result.success) {
                                // Paste at cursor position if over canvas
                                const wrapper = document.getElementById('canvas-wrapper');
                                let cx = 0, cy = 0;
                                if (wrapper) {
                                    const rect = wrapper.getBoundingClientRect();
                                    const scaleX = wrapper.offsetWidth / rect.width;
                                    const scaleY = wrapper.offsetHeight / rect.height;
                                    const mx = (this.globalMouseX - rect.left) * scaleX;
                                    const my = (this.globalMouseY - rect.top) * scaleY;
                                    cx = Math.round(mx - (wrapper.offsetWidth / 2));
                                    cy = Math.round(my - (wrapper.offsetHeight / 2));
                                }
                                
                                this.menuData.formules[this.activeFormuleKey].components.push({
                                    type: 'rawImage',
                                    url: result.path,
                                    x: cx,
                                    y: cy,
                                    scale: 1,
                                    rotation: 0,
                                    z: 100,
                                    animIn: 'zoomIn',
                                    animOut: 'zoomOut',
                                    delay: 0,
                                    exitTime: this.menuData.formules[this.activeFormuleKey].duration || 6
                                });
                                this.saveData();
                                this.showNotif("Image collée depuis le presse-papiers !", 'success');
                            }
                        } catch (err) {
                            console.error(err);
                            this.showNotif("Erreur lors du collage", "error");
                        }
                    } else {
                        // Handle Text Paste
                        const pastedText = (e.clipboardData || e.originalEvent.clipboardData).getData('text/plain');
                        if (pastedText && pastedText.trim()) {
                            e.preventDefault();
                            const wrapper = document.getElementById('canvas-wrapper');
                            let cx = 0, cy = 0;
                            if (wrapper) {
                                const rect = wrapper.getBoundingClientRect();
                                const scaleX = wrapper.offsetWidth / rect.width;
                                const scaleY = wrapper.offsetHeight / rect.height;
                                const mx = (this.globalMouseX - rect.left) * scaleX;
                                const my = (this.globalMouseY - rect.top) * scaleY;
                                cx = Math.round(mx - (wrapper.offsetWidth / 2));
                                cy = Math.round(my - (wrapper.offsetHeight / 2));
                            }

                            this.menuData.formules[this.activeFormuleKey].components.push({
                                type: 'customText',
                                content: pastedText.trim(),
                                x: cx,
                                y: cy,
                                scale: 1,
                                rotation: 0,
                                z: 100,
                                color: '#ffffff',
                                fontFamily: "'Oswald', sans-serif",
                                fontSize: 80,
                                hasShadow: true,
                                animIn: 'zoomIn',
                                animOut: 'zoomOut',
                                delay: 0,
                                exitTime: this.menuData.formules[this.activeFormuleKey].duration || 6
                            });
                            this.saveData();
                            this.showNotif("Texte collé depuis le presse-papiers !", 'success');
                        }
                    }
                },
                async handleCanvasDrop(event, fKey) {
                    if (event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files.length > 0) {
                        const file = event.dataTransfer.files[0];
                        const isVideo = file.type.startsWith('video/');
                        const isImage = file.type.startsWith('image/');
                        if (!isVideo && !isImage) {
                            alert("Veuillez glisser une image ou une vidéo.");
                            return;
                        }

                        // Calculate drop position relative to center of canvas
                        const rect = event.currentTarget.getBoundingClientRect();
                        const scale = this.menuData.orientation === 'vertical' ? 0.2531 : 0.45;
                        const dropX = (event.clientX - rect.left) / scale;
                        const dropY = (event.clientY - rect.top) / scale;
                        const w = this.menuData.orientation === 'vertical' ? 1080 : 1920;
                        const h = this.menuData.orientation === 'vertical' ? 1920 : 1080;
                        const centeredX = Math.round(dropX - (w / 2));
                        const centeredY = Math.round(dropY - (h / 2));

                        const formData = new FormData();
                        formData.append('file', file);
                        formData.append('target', 'root'); // Save to root directory so it can be served directly

                        try {
                            const response = await fetch('/api/upload', {
                                method: 'POST',
                                body: formData
                            });
                            const result = await response.json();
                            if (result.success) {
                                if (!this.menuData.formules[fKey].components) {
                                    this.menuData.formules[fKey].components = [];
                                }
                                if (isVideo) {
                                    this.menuData.formules[fKey].components.push({
                                        type: 'rawVideo',
                                        url: result.path,
                                        x: centeredX,
                                        y: centeredY,
                                        scale: 1,
                                        rotation: 0,
                                        z: -1, // Render behind everything by default for backgrounds
                                        animIn: 'fadeIn',
                                        animOut: 'fadeOut',
                                        delay: 0,
                                        exitTime: this.menuData.formules[fKey].duration - 1
                                    });
                                } else {
                                    this.menuData.formules[fKey].components.push({
                                        type: 'rawImage',
                                        url: result.path,
                                        x: centeredX,
                                        y: centeredY,
                                        scale: 1,
                                        rotation: 0,
                                        z: 50, // Render on top by default for dropped images
                                        animIn: 'zoomIn',
                                        animOut: 'zoomOut',
                                        delay: 0,
                                        exitTime: this.menuData.formules[fKey].duration - 1
                                    });
                                }
                                this.saveMenu();
                            } else {
                                alert("Erreur d'upload: " + result.error);
                            }
                        } catch (e) {
                            alert("Erreur réseau: " + e.message);
                        }
                    }
                },
                applyEffect(fKey) {
                    if (!this.menuData || !this.menuData.formules) return;
                    const formule = this.menuData.formules[fKey];
                    if (!formule) return;
                    this.$nextTick(() => {
                        const container = document.getElementById('effect-layer-' + fKey);
                        if (container && window.applyBgEffect) {
                            window.applyBgEffect(container, formule.bgEffect, 'transparent');
                        }
                    });
                },
                applyColorToSelection(color) {
                    if (window.getSelection && window.getSelection().rangeCount > 0) {
                        document.execCommand('styleWithCSS', false, true);
                        document.execCommand('foreColor', false, color);
                    }
                },
                applyAllEffects() {
                    if (!this.menuData || !this.menuData.formules) return;
                    for (let fKey in this.menuData.formules) {
                        this.applyEffect(fKey);
                    }
                },
                promptNewProject() {
                    this.newProjectName = '';
                    this.newProjectTvs = 4;
                    this.showNewProjectModal = true;
                },
                async confirmNewProject() {
                    const name = this.newProjectName;
                    const tvs = this.newProjectTvs;
                    this.showNewProjectModal = false;
                    
                    if (name && name.trim()) {
                        const cleanName = name.trim().replace(/[^a-zA-Z0-9_-]/g, '').toLowerCase();
                        if (cleanName && !this.projects[cleanName]) {
                            let tvCount = parseInt(tvs);
                            if (isNaN(tvCount) || tvCount < 1) tvCount = 1;

                            this.projects[cleanName] = tvCount;
                            this.currentProject = cleanName;

                            // Initialize with empty menu data
                            this.menuData = { orientation: 'horizontal', assets: { sandwiches: [], drinks: [], sides: [] }, formules: {} };

                            // Force save the max TV to register it in the backend
                            try {
                                await fetch(`/api/menu/${cleanName}/${tvCount}`, {
                                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(this.menuData)
                                });
                            } catch (e) { }

                            this.currentTvId = "1";
                            this.saveData();
                            this.showNotif("Client " + cleanName + " créé avec " + tvCount + " TVs!", "success");
                        }
                    }
                },
                async deleteProject() {
                    if (this.currentProject === 'default') return;
                    if (confirm(`Voulez-vous vraiment supprimer le client/projet "${this.currentProject}" ?\nToutes ses données (tous ses écrans) seront supprimées DÉFINITIVEMENT.`)) {
                        try {
                            const res = await fetch('/api/projects/' + this.currentProject, { method: 'DELETE' });
                            if (res.ok) {
                                this.showNotif("Client " + this.currentProject + " supprimé.", "success");
                                this.currentProject = 'default';
                                this.currentTvId = "1";
                                this.fetchProjects();
                                this.fetchData();
                            } else {
                                this.showNotif("Erreur lors de la suppression", "error");
                            }
                        } catch (e) {
                            this.showNotif("Erreur serveur", "error");
                        }
                    }
                },
                fetchProjects() {
                    fetch('/api/projects')
                        .then(res => res.json())
                        .then(data => {
                            if (data && Object.keys(data).length) {
                                this.projects = data;
                            }
                            // Check URL for project and tv
                            const urlParams = new URLSearchParams(window.location.search);
                            if (urlParams.has('project') && this.projects[urlParams.get('project')]) {
                                this.currentProject = urlParams.get('project');
                            }
                            if (urlParams.has('tv')) {
                                this.currentTvId = urlParams.get('tv');
                            }
                            this.fetchData();
                        });
                },
                getClipPathStyle(comp) {
                    if (comp.clipPolygon) {
                        return `polygon(${comp.clipPolygon})`;
                    }
                    return `inset(${comp.clipTop || 0}% ${comp.clipRight || 0}% ${comp.clipBottom || 0}% ${comp.clipLeft || 0}%)`;
                },
                openLassoTool(fKey, cIdx) {
                    this.lassoTarget = { fKey, cIdx };
                    const comp = this.getComp(fKey, cIdx);
                    this.lassoImageUrl = comp.type === 'main' ? this.getAssetUrl(comp.assetId) : ('/' + comp.url);

                    if (comp.clipPolygon) {
                        this.lassoPoints = comp.clipPolygon.split(',').map(s => {
                            const [x, y] = s.trim().split(' ').map(v => parseFloat(v));
                            return { x, y };
                        });
                        this.lassoClosed = true;
                    } else {
                        this.lassoPoints = [];
                        this.lassoClosed = false;
                    }

                    this.showLassoModal = true;
                },
                closeLassoTool() {
                    this.showLassoModal = false;
                    this.lassoTarget = null;
                },
                updateLassoMouse(e) {
                    if (!this.showLassoModal || this.lassoClosed || !this.$refs.lassoContainer) return;
                    const rect = this.$refs.lassoContainer.getBoundingClientRect();
                    let x = ((e.clientX - rect.left) / rect.width) * 100;
                    let y = ((e.clientY - rect.top) / rect.height) * 100;
                    this.lassoMouseX = Math.max(0, Math.min(100, x));
                    this.lassoMouseY = Math.max(0, Math.min(100, y));
                },
                addLassoPoint(e) {
                    if (this.lassoClosed) return;
                    const rect = this.$refs.lassoContainer.getBoundingClientRect();
                    let x = ((e.clientX - rect.left) / rect.width) * 100;
                    let y = ((e.clientY - rect.top) / rect.height) * 100;
                    x = Math.max(0, Math.min(100, x));
                    y = Math.max(0, Math.min(100, y));

                    if (this.lassoPoints.length > 2) {
                        const first = this.lassoPoints[0];
                        const dist = Math.sqrt(Math.pow(x - first.x, 2) + Math.pow(y - first.y, 2));
                        if (dist < 3) {
                            this.finishLasso();
                            return;
                        }
                    }

                    this.lassoPoints.push({ x, y });
                },
                finishLasso() {
                    if (this.lassoPoints.length > 2) {
                        this.lassoClosed = true;
                    }
                },
                applyLasso() {
                    if (!this.lassoClosed) return;
                    const comp = this.getComp(this.lassoTarget.fKey, this.lassoTarget.cIdx);
                    comp.clipPolygon = this.lassoPolygonString;

                    // Initialize hasShadow to false if default shadow looks bad with arbitrary polygons
                    if (comp.hasShadow === undefined) {
                        comp.hasShadow = false;
                    }

                    this.saveData();
                    this.closeLassoTool();
                },
                cycleSelectOption(event, obj, key, delta) {
                    const select = event.currentTarget;
                    const options = Array.from(select.options);
                    const currentVal = obj[key] || 'none';
                    const currentIndex = Math.max(0, options.findIndex(opt => opt.value === currentVal));
                    let newIndex = currentIndex + delta;
                    if (newIndex < 0) newIndex = 0;
                    if (newIndex >= options.length) newIndex = options.length - 1;
                    obj[key] = options[newIndex].value;
                },
                toggleOrientation() {
                    if (!this.menuData) return;
                    this.menuData.orientation = this.menuData.orientation === 'vertical' ? 'horizontal' : 'vertical';
                },
                isCompVisibleInTimeline(fKey, comp) {
                    if (!this.menuData || !this.menuData.formules[fKey]) return true;
                    const duration = this.menuData.formules[fKey].duration || 6;
                    const currentTime = (this.previewProgress / 100) * duration;
                    const delay = comp.delay || 0;
                    if (currentTime < delay) return false;
                    const exitTime = comp.exitTime || duration;
                    if (exitTime < duration && currentTime > exitTime + 1) return false;
                    return true;
                },
                isLayoutVisibleInTimeline(fKey, tKey) {
                    if (!this.menuData || !this.menuData.formules[fKey]) return true;
                    const formule = this.menuData.formules[fKey];
                    if (!formule[tKey]) return false;
                    const duration = formule.duration || 6;
                    const currentTime = (this.previewProgress / 100) * duration;
                    const delay = formule[tKey].delay || 0;
                    if (currentTime < delay) return false;
                    const exitTime = formule[tKey].exitTime || duration;
                    if (exitTime < duration && currentTime > exitTime + 1) return false;
                    return true;
                },
                // --- CapCut Timeline Methods ---
                setPlayhead(event, fKey) {
                    if (!this.menuData.formules[fKey]) return;
                    const rect = event.currentTarget.getBoundingClientRect();
                    const pos = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
                    this.previewProgress = pos * 100;
                    if (this.playingTimeline) this.playingTimeline.progress(pos);
                    this.timelineDrag.isDraggingPlayhead = true;
                    window.addEventListener('mouseup', this.stopTimelineDrag);
                },
                dragPlayhead(event, fKey) {
                    if (!this.timelineDrag.isDraggingPlayhead || !this.menuData.formules[fKey]) return;
                    const rect = event.currentTarget.getBoundingClientRect();
                    const pos = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
                    this.previewProgress = pos * 100;
                    if (this.playingTimeline) this.playingTimeline.progress(pos);
                },
                startDragTimelineClip(event, fKey, cKey) {
                    this.setActive(fKey, cKey, false, event.ctrlKey || event.shiftKey);
                    this.wiggleElement(fKey, cKey);
                    const comp = this.getComp(fKey, cKey);
                    const duration = this.menuData.formules[fKey].duration || 6;
                    if (comp.exitTime === undefined) comp.exitTime = duration;

                    this.timelineDrag = {
                        active: true, isDraggingPlayhead: false,
                        fKey, cKey, mode: 'move',
                        startX: event.clientX,
                        startY: event.clientY,
                        startVal: comp.delay || 0,
                        startEndVal: comp.exitTime || duration,
                        timelineWidth: event.currentTarget.parentElement.getBoundingClientRect().width,
                        duration: duration
                    };
                    window.addEventListener('mousemove', this.onTimelineDrag);
                    window.addEventListener('mouseup', this.stopTimelineDrag);
                },
                startResizeTimelineClip(event, fKey, cKey, side) {
                    this.setActive(fKey, cKey, false);
                    const comp = this.getComp(fKey, cKey);
                    const duration = this.menuData.formules[fKey].duration || 6;
                    if (comp.exitTime === undefined) comp.exitTime = duration;

                    this.timelineDrag = {
                        active: true, isDraggingPlayhead: false,
                        fKey, cKey, mode: side,
                        startX: event.clientX,
                        startY: event.clientY,
                        startVal: comp.delay || 0,
                        startEndVal: comp.exitTime || duration,
                        timelineWidth: event.currentTarget.parentElement.parentElement.getBoundingClientRect().width,
                        duration: duration
                    };
                    window.addEventListener('mousemove', this.onTimelineDrag);
                    window.addEventListener('mouseup', this.stopTimelineDrag);
                },
                onTimelineDrag(event) {
                    if (!this.timelineDrag.active) return;

                    const dx = event.clientX - this.timelineDrag.startX;
                    const dy = event.clientY - this.timelineDrag.startY;
                    const timeDelta = (dx / this.timelineDrag.timelineWidth) * this.timelineDrag.duration;
                    const comp = this.getComp(this.timelineDrag.fKey, this.timelineDrag.cKey);

                    if (this.timelineDrag.mode === 'move') {
                        if (Math.abs(dy) > 20 && Math.abs(dy) > Math.abs(dx)) {
                            const elements = document.elementsFromPoint(event.clientX, event.clientY);
                            const trackEl = elements.find(el => el.classList.contains('timeline-track-row'));
                            if (trackEl) {
                                const hoverKey = trackEl.getAttribute('data-layer-key');
                                if (hoverKey && hoverKey !== this.timelineDrag.cKey) {
                                    this.dragLayerFKey = this.timelineDrag.fKey;
                                    this.dragLayerIndex = this.timelineDrag.cKey;
                                    this.onTrackDrop(event, this.timelineDrag.fKey, hoverKey);
                                    this.timelineDrag.startY = event.clientY;
                                }
                            }
                        }

                        const dur = this.timelineDrag.startEndVal - this.timelineDrag.startVal;
                        let newDelay = this.timelineDrag.startVal + timeDelta;

                        if (newDelay < 0) newDelay = 0;
                        if (newDelay + dur > this.timelineDrag.duration) newDelay = this.timelineDrag.duration - dur;

                        comp.delay = Math.round(newDelay * 10) / 10;
                        comp.exitTime = Math.round((newDelay + dur) * 10) / 10;
                    }
                    else if (this.timelineDrag.mode === 'left') {
                        let newDelay = this.timelineDrag.startVal + timeDelta;
                        if (newDelay < 0) newDelay = 0;
                        if (newDelay > comp.exitTime - 0.5) newDelay = comp.exitTime - 0.5;
                        comp.delay = Math.round(newDelay * 10) / 10;
                    }
                    else if (this.timelineDrag.mode === 'right') {
                        let newExitTime = this.timelineDrag.startEndVal + timeDelta;
                        if (newExitTime > this.timelineDrag.duration) newExitTime = this.timelineDrag.duration;
                        if (newExitTime < (comp.delay || 0) + 0.5) newExitTime = (comp.delay || 0) + 0.5;
                        comp.exitTime = Math.round(newExitTime * 10) / 10;
                    }
                },
                stopTimelineDrag() {
                    this.timelineDrag.active = false;
                    this.timelineDrag.isDraggingPlayhead = false;
                    window.removeEventListener('mousemove', this.onTimelineDrag);
                    window.removeEventListener('mouseup', this.stopTimelineDrag);
                    
                    if (this.playingTimeline && !this.isPlaying) {
                        this.playPreview(this.activeFormuleKey);
                        this.playingTimeline.progress(this.previewProgress / 100);
                        this.playingTimeline.pause();
                    }
                },
                removeComponent(formule, fKey, cIdx) {
                    if (confirm("Voulez-vous vraiment supprimer cet élément ?")) {
                        formule.components.splice(cIdx, 1);
                        this.activeCompIndex = null;
                        this.saveData();
                    }
                },
                removeLayoutComponent(fKey, tKey) {
                    if (confirm("Voulez-vous vraiment cacher cet élément ?")) {
                        this.menuData.formules[fKey][tKey] = null;
                        this.activeCompIndex = null;
                        this.saveData();
                    }
                },
                wiggleElement(fKey, cKey) {
                    // Les composants ont l'ID mockup-anim-fKey-cIdx
                    let el = document.getElementById('mockup-anim-' + fKey + '-' + cKey);
                    // Si c'est un layout, on cherche l'id correspondant
                    if (!el && typeof cKey === 'string') {
                        el = document.getElementById('mockup-' + cKey + '-' + fKey);
                    }
                    if (el) {
                        el.classList.remove('highlight-wiggle');
                        // Force reflow to restart animation
                        void el.offsetWidth;
                        el.classList.add('highlight-wiggle');
                        setTimeout(() => {
                            if (el) el.classList.remove('highlight-wiggle');
                        }, 500);
                    }
                },
                // ------------------------------

                applyTemplate(type) {
                    const newKey = 'formule_' + Date.now().toString().slice(-6);
                    let newFormule = {
                        name: "Nouvelle Formule", price: "0", duration: 6, bgColor: "radial-gradient(circle at 50% 60%, #1a1a1a 0%, #000000 100%)", badge: "NOUVEAU", description: "Description", tv: "",
