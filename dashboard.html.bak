                        newFormule.components.push({ type: 'customText', content: 'COMBO DEAL', x: 0, y: -230, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.2, rotation: -5, color: '#d50000', fontSize: 150, fontFamily: "'Oswald', sans-serif", hasShadow: true, strokeColor: '#ffffff' });

