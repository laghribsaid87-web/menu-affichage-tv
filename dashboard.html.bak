                        newFormule.components.push({ type: 'customText', content: 'ONLY', x: -350, y: -100, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.6, rotation: 15, color: '#ffffff', fontSize: 40, fontFamily: "'Oswald', sans-serif", hasShadow: false });
                        newFormule.components.push({ type: 'customText', content: '5.99', x: -350, y: -40, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.7, rotation: 15, color: '#ffea00', fontSize: 90, fontFamily: "'Oswald', sans-serif", hasShadow: true });

