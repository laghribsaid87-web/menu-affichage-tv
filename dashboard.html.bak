                        newFormule.components.push({ type: 'customText', content: 'BURGERS', x: 250, y: -20, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.5, rotation: 0, color: '#ffb300', fontSize: 140, fontFamily: "'Oswald', sans-serif", hasShadow: true, strokeColor: '#000' });
                        newFormule.components.push({ type: 'customText', content: 'IN TOWN', x: 250, y: 100, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.7, rotation: 0, color: '#ffffff', fontSize: 130, fontFamily: "'Oswald', sans-serif", hasShadow: false });

