                    }
                    // 'blank' does nothing extra

                    this.menuData.formules[newKey] = newFormule;
                    this.showTemplateModal = false;
                    this.activeFormuleKey = newKey;
                    this.saveData();
                },
                showNotif(msg, type = 'success') {
                    this.notification = { message: msg, type };
                    setTimeout(() => this.notification = null, 4000);
                },
                copyTvLink() {
                    const link = window.location.origin + '/viewer.html?project=' + this.currentProject + '&tv=' + this.currentTvId;
                    navigator.clipboard.writeText(link).then(() => {
                        this.showNotif("Lien copié avec succès ! (" + link + ")", "success");
                    }).catch(err => {
                        this.showNotif("Erreur lors de la copie du lien", "error");
                    });
                },
                getAssetUrl(id) {
                    if (!this.menuData || !this.menuData.assets) return '';
                    for (let cat in this.menuData.assets) {
                        const a = this.menuData.assets[cat].find(x => x.id === id);
                        if (a) return '/' + a.url;
                    }
                    return '';
                },
                isSmallItem(id) {
                    const url = this.getAssetUrl(id);
                    return url.includes('coca') || url.includes('SODA') || url.includes('jus');
                },
                async fetchData() {
                    try {
                        const res = await fetch(`/api/menu/${this.currentProject}/${this.currentTvId}`);
                        this.menuData = await res.json();
                        if (!this.menuData.assets) this.menuData.assets = {};
                        if (!this.menuData.assets.sandwiches) this.menuData.assets.sandwiches = [];
                        if (!this.menuData.assets.drinks) this.menuData.assets.drinks = [];
                        if (!this.menuData.assets.sides) this.menuData.assets.sides = [];
                        if (this.menuData.formules) {
                            Object.values(this.menuData.formules).forEach(f => {
                                if (!f.nameLayout) f.nameLayout = { x: 0, y: -430, scale: 1, rotation: 0, animIn: "fadeDown", delay: 0, z: 20 };
                                if (!f.descLayout) f.descLayout = { x: 0, y: -360, scale: 1, rotation: 0, animIn: "fadeUp", delay: 0.2, z: 20 };
                                if (!f.badgeLayout) f.badgeLayout = { x: -350, y: -430, scale: 1.5, rotation: -15, animIn: "fadeLeft", delay: 0.4, z: 20 };
                                if (!f.priceLayout) f.priceLayout = { x: 350, y: 300, scale: 1.5, rotation: -10, animIn: "zoomIn", delay: 1, z: 20 };
                            });
                        }
                        if (Object.keys(this.menuData.formules).length > 0) this.activeFormuleKey = Object.keys(this.menuData.formules)[0];

                        this.$nextTick(() => {
                            this.applyAllEffects();
                        });
                    } catch (e) { this.showNotif("Erreur de connexion", "error"); }
                },
                async saveData() {
                    try {
                        const res = await fetch(`/api/menu/${this.currentProject}/${this.currentTvId}`, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(this.menuData)
                        });
                        if (res.ok) this.showNotif("Modifications sauvegardées avec succès !");
                        else this.showNotif("Erreur", "error");
                    } catch (e) { }
                },
                addAsset(category) { this.menuData.assets[category].push({ id: 'nouveau_' + Date.now().toString().slice(-4), name: 'Nouveau', url: '' }); },
                splitTimelineClip(fKey, layerKey) {
                    const formule = this.menuData.formules[fKey];
                    if (!formule || !formule.components) return;

                    if (typeof layerKey === 'string' && !layerKey.startsWith('comp_')) {
                        this.showNotif("Impossible de couper les éléments de base (Prix, Titre, etc.). Astuce: Cachez cet élément et recréez-le avec le bouton 'Forme' ou 'Texte' en haut pour pouvoir le couper !", "warning");
                        return;
                    }
                    
                    let compIndex = layerKey;
                    let comp = null;
                    if (typeof layerKey === 'string' && layerKey.startsWith('comp_')) {
                        // Find the clip under the playhead
                        const t = this.getCurrentTimelineTime(formule);
                        let tid = layerKey;
                        compIndex = formule.components.findIndex((c, i) => {
                            if ((c.trackId || 'comp_'+i) !== tid) return false;
                            const start = c.delay || 0;
                            const end = c.exitTime || formule.duration || 6;
                            return t > start && t < end;
                        });
                        if (compIndex === -1) {
                            this.showNotif("Aucun clip trouvé sous le curseur pour cette piste.", "error");
                            return;
                        }
                        comp = formule.components[compIndex];
                    } else {
                        comp = formule.components[layerKey];
                    }
                    if (!comp) return;
                    
                    const t = this.getCurrentTimelineTime(formule);
                    
                    const start = comp.delay || 0;
                    const end = comp.exitTime || formule.duration || 6;
                    
                    if (t <= start + 0.1 || t >= end - 0.1) {
                        this.showNotif("Placez le repère rouge au milieu du clip pour le couper.", "warning");
                        return;
                    }
                    
                    this.saveState();
                    // Duplicate
                    let newComp = JSON.parse(JSON.stringify(comp));
                    
                    comp.exitTime = t;
                    comp.animOut = 'none';
                    
                    newComp.delay = t;
                    newComp.animIn = 'none';
                    
                    formule.components.splice(compIndex + 1, 0, newComp);
                    
                    this.showNotif("Clip scindé en deux ! (Copie créée sur la même piste)", "success");
                    this.activeCompIndex = compIndex + 1; // select the new piece
                    this.saveData();
                },
                getCurrentTimelineTime(formule) {
                    if (this.previewProgress !== undefined) {
                        return Number(this.formatTime(this.previewProgress * (formule.duration || 6) / 100));
                    }
                    return 0;
                },
                getAllLayers(fKey) {
                    let f = this.menuData.formules[fKey];
                    if (!f) return [];
                    let trackMap = {};
                    
                    ['nameLayout', 'descLayout', 'badgeLayout', 'priceLayout'].forEach(t => {
                        if (f[t]) {
                            if (f[t].z === undefined) f[t].z = 15;
                            trackMap[t] = { key: t, type: 'layout', clips: [{ key: t, type: 'layout', comp: f[t] }], z: f[t].z, mainComp: f[t] };
                        }
                    });
                    
                    f.components.forEach((c, idx) => {
                        if (c.z === undefined) c.z = 15;
                        let tid = c.trackId;
                        if (!tid) {
                            tid = 'comp_' + idx;
                            c.trackId = tid;
                        }
                        if (!trackMap[tid]) {
                            trackMap[tid] = { key: tid, type: 'component', clips: [], z: c.z, mainComp: c };
                        }
                        trackMap[tid].clips.push({ key: idx, type: 'component', comp: c });
                    });

                    let layers = Object.values(trackMap);
                    
                    layers.push({ key: 'background', type: 'background', clips: [{ key: 'background', type: 'background', comp: { z: -99999 } }], z: -99999, mainComp: { z: -99999 } });

                    layers.sort((a, b) => (b.z || 0) - (a.z || 0));
                    return layers;
                },
                addComponent(formule, fKey) {
                    let firstAsset = this.menuData.assets.sandwiches?.[0]?.id || '';
                    formule.components.unshift({ assetId: firstAsset, type: 'main', x: 0, y: 0, scale: 1, z: 5, animIn: 'fadeUp', animOut: 'fadeDown', delay: this.getCurrentTimelineTime(formule), rotation: 0 });
                    if (fKey) this.setActive(fKey, 0);
                },
                async addRawImageComponent(event, formule, fKey) {
                    const file = event.target.files[0];
                    if (!file) return;
                    this.showNotif("Upload de l'image (Arrière-plan)...", "info");
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('target', 'root');
                    try {
                        const uploadRes = await fetch('/api/upload', { method: 'POST', body: formData });
                        const uploadData = await uploadRes.json();

                        if (uploadData.success) {
                            // z: 0 puts it in the background
                            formule.components.unshift({ type: 'rawImage', url: uploadData.path, x: 0, y: 0, scale: 1, z: 0, animIn: 'zoomIn', animOut: 'zoomOut', delay: this.getCurrentTimelineTime(formule), rotation: 0 });
                            if (fKey) this.setActive(fKey, 0);
                            this.saveData();
                            this.showNotif("Arrière-plan ajouté avec succès !", "success");
                        }
                    } catch (e) {
                        this.showNotif("Erreur upload", "error");
                    }
                    event.target.value = '';
                },
                addTextComponent(formule, fKey) {
                    formule.components.unshift({ type: 'customText', content: 'NOUVEAU TEXTE', x: 0, y: 0, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: this.getCurrentTimelineTime(formule), rotation: 0, color: '#ffffff', fontSize: 60, fontFamily: "'Oswald', sans-serif", hasShadow: false, strokeColor: '' });
                    if (fKey) this.setActive(fKey, 0);
                },
                deleteFormule(fKey) {
                    if (confirm("Voulez-vous vraiment supprimer cet écran entier ?")) {
                        delete this.menuData.formules[fKey];
                        this.saveData();
                        this.showNotif("Écran supprimé", "success");
                    }
                },
                addShapeComponent(formule, fKey) {
                    formule.components.unshift({ type: 'shape', shapeType: 'rect', width: 400, height: 100, color: '#000000', opacity: 0.5, borderRadius: 20, x: 0, y: 0, scale: 1, z: 2, animIn: 'zoomIn', animOut: 'zoomOut', delay: this.getCurrentTimelineTime(formule), rotation: 0, content: '', textColor: '#ffffff', fontSize: 40 });
                    if (fKey) this.setActive(fKey, 0);
                },
                openInpaintModal() {
                    this.inpaint = { show: true, image: null, loading: false, result: null, isDrawing: false, ctx: null, maskCtx: null };
                },
                onInpaintUpload(e) {
                    const file = e.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (ev) => {
                        this.inpaint.image = ev.target.result;
                        this.$nextTick(() => { this.initInpaintCanvas(); });
                    };
                    reader.readAsDataURL(file);
                },
                initInpaintCanvas() {
                    const canvas = this.$refs.inpaintCanvas;
                    const ctx = canvas.getContext('2d');
                    const img = new Image();
                    img.onload = () => {
                        canvas.width = img.width;
                        canvas.height = img.height;
                        canvas.style.maxWidth = '80vw';
                        canvas.style.maxHeight = '60vh';
                        ctx.drawImage(img, 0, 0);

                        const maskCanvas = document.createElement('canvas');
                        maskCanvas.width = img.width;
                        maskCanvas.height = img.height;
                        const maskCtx = maskCanvas.getContext('2d');
                        maskCtx.fillStyle = 'black';
                        maskCtx.fillRect(0, 0, maskCanvas.width, maskCanvas.height);

                        this.inpaint.ctx = ctx;
                        this.inpaint.maskCtx = maskCtx;
                    };
                    img.src = this.inpaint.image;
                },
                startInpaintDraw(e) {
                    this.inpaint.isDrawing = true;
                    this.inpaintDraw(e);
                },
                inpaintDraw(e) {
                    if (!this.inpaint.isDrawing || !this.inpaint.ctx) return;
                    const rect = e.target.getBoundingClientRect();
                    const scaleX = e.target.width / rect.width;
                    const scaleY = e.target.height / rect.height;
                    const x = (e.clientX - rect.left) * scaleX;
                    const y = (e.clientY - rect.top) * scaleY;
                    const size = 30; // Brush size

                    this.inpaint.ctx.fillStyle = 'rgba(255, 0, 0, 0.5)';
                    this.inpaint.ctx.beginPath();
                    this.inpaint.ctx.arc(x, y, size, 0, Math.PI * 2);
                    this.inpaint.ctx.fill();

                    this.inpaint.maskCtx.fillStyle = 'white';
                    this.inpaint.maskCtx.beginPath();
                    this.inpaint.maskCtx.arc(x, y, size, 0, Math.PI * 2);
                    this.inpaint.maskCtx.fill();
                },
                stopInpaintDraw() {
                    this.inpaint.isDrawing = false;
                },
                async processInpaint() {
                    this.inpaint.loading = true;
                    try {
                        const maskB64 = this.inpaint.maskCtx.canvas.toDataURL('image/png');
                        const res = await fetch('/api/inpaint', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ image: this.inpaint.image, mask: maskB64 })
                        });
                        const data = await res.json();
                        if (data.success) {
                            this.inpaint.result = data.path;
                            this.showNotif("Image nettoyée avec succès !", "success");
                        } else {
                            this.showNotif("Erreur du serveur", "error");
                        }
                    } catch (e) {
                        console.error("INPAINT JS ERROR:", e);
                        this.showNotif("Erreur de nettoyage: " + e.message, "error");
                    }
                    this.inpaint.loading = false;
                },
                useInpaintAsBg() {
                    if (!this.inpaint.result) return;
                    if (this.activeFormuleKey && this.menuData.formules[this.activeFormuleKey]) {
                        this.menuData.formules[this.activeFormuleKey].bgImage = this.inpaint.result;
                        this.saveData();
                        this.inpaint.show = false;
                        this.inpaint.result = null;
                        this.showNotif("Fond appliqué à l'écran actuel !", "success");
                    } else {
                        this.showNotif("Veuillez d'abord sélectionner ou créer un écran", "error");
                    }
                },
                getTextStyle(comp) {
                    if (!comp) return {};
                    let style = {
                        color: comp.color || '#ffffff',
                        fontSize: (comp.fontSize || 40) + 'px',
                        fontFamily: comp.fontFamily || "'Oswald', sans-serif",
                        fontWeight: 'bold',
                        lineHeight: comp.lineHeight !== undefined ? comp.lineHeight : 1,
                        letterSpacing: (comp.letterSpacing || 0) + 'px',
                        whiteSpace: 'pre-wrap'
                    };

                    const effect = comp.textEffect || (comp.hasShadow ? 'shadow' : 'none');
                    const intensity = comp.effectIntensity !== undefined ? comp.effectIntensity : 50;
                    const val = intensity / 100;

                    let strokeColor = comp.strokeColor || '#000000';
                    let cColor = comp.color || '#ffffff';

                    if (effect === 'shadow') {
                        style.textShadow = `0 ${10 * val}px ${25 * val}px rgba(0,0,0,${0.4 + (val * 0.6)})`;
                    } else if (effect === 'glow') {
                        style.textShadow = `0 0 ${10 * val}px ${cColor}, 0 0 ${20 * val}px ${cColor}, 0 0 ${40 * val}px ${cColor}`;
                    } else if (effect === 'echo') {
                        style.textShadow = `${6 * val}px ${6 * val}px 0px rgba(255,255,255,0.4), ${12 * val}px ${12 * val}px 0px rgba(255,255,255,0.2)`;
                    } else if (effect === 'outline') {
                        style.WebkitTextStroke = `${6 * val}px ${strokeColor}`;
                    } else if (effect === 'bg') {
                        style.backgroundColor = strokeColor;
                        style.padding = `${10 * val}px ${20 * val}px`;
                        style.borderRadius = `${15 * val}px`;
                    } else if (effect === 'bevel') {
                        style.textShadow = `${5 * val}px ${5 * val}px 0px rgba(0,0,0,0.6), -${3 * val}px -${3 * val}px 0px rgba(255,255,255,0.7)`;
                    } else if (effect === 'hollow') {
                        style.WebkitTextStroke = `${4 * val}px ${cColor}`;
                        style.color = 'transparent';
                    } else if (effect === 'neon') {
                        style.textShadow = `0 0 ${5 * val}px #fff, 0 0 ${10 * val}px #fff, 0 0 ${20 * val}px ${cColor}, 0 0 ${40 * val}px ${cColor}, 0 0 ${80 * val}px ${cColor}`;
                        style.color = '#ffffff';
                    } else if (effect === 'glitch') {
                        style.textShadow = `${8 * val}px 0 0 cyan, -${8 * val}px 0 0 red`;
                    } else {
                        style.textShadow = 'none';
                        style.WebkitTextStroke = 'none';
                    }

                    return style;
                },
                getBgColorStyle(f) {
                    if (f.isBgGradient && f.bgColor2) {
                        return `linear-gradient(${f.bgGradientAngle || 90}deg, ${f.bgColor || '#000000'}, ${f.bgColor2})`;
                    }
                    return f.bgColor || 'radial-gradient(circle at 50% 60%, #1a1a1a 0%, #000000 100%)';
                },
                getShapeStyle(comp) {
                    let style = {
                        opacity: comp.opacity,
                        width: comp.width + 'px',
                        height: comp.height + 'px'
                    };

                    if (comp.isGradient && comp.color2) {
                        style.background = `linear-gradient(${comp.gradientAngle || 90}deg, ${comp.color}, ${comp.color2})`;
                    } else {
                        style.backgroundColor = comp.color;
                    }

                    if (comp.shapeType === 'circle') {
                        style.borderRadius = '50%';
                    } else if (comp.shapeType === 'badge') {
                        style.clipPath = 'polygon(50% 0%, 80% 10%, 100% 35%, 100% 70%, 80% 90%, 50% 100%, 20% 90%, 0% 70%, 0% 35%, 20% 10%)';
                    } else if (comp.shapeType === 'star') {
                        style.clipPath = 'polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%)';
                    } else if (comp.shapeType === 'burst') {
                        style.clipPath = 'polygon(50% 0%, 65% 15%, 85% 15%, 85% 35%, 100% 50%, 85% 65%, 85% 85%, 65% 85%, 50% 100%, 35% 85%, 15% 85%, 15% 65%, 0% 50%, 15% 35%, 15% 15%, 35% 15%)';
                    } else {
                        style.borderRadius = (comp.borderRadius || 0) + 'px'; // rect par defaut
                    }

                    if (comp.isNeon) {
                        style.filter = `drop-shadow(0 0 15px ${comp.color}) drop-shadow(0 0 30px ${comp.color})`;
                        if (!comp.isGradient) {
                            style.backgroundColor = '#ffffff'; // Neon effect uses white center with colored glow
                        }
                    }

                    return style;
                },
                async uploadBgImage(event, fKey) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('target', 'root');
                    try {
                        const res = await fetch('/api/upload', { method: 'POST', body: formData });
                        const data = await res.json();
                        if (data.success) {
                            this.menuData.formules[fKey].bgImage = data.path;
                        }
                    } catch (e) { this.showNotif("Erreur upload bg", "error"); }
                },
                async uploadRawImage(event, formule) {
                    const file = event.target.files[0];
                    if (!file) return;
                    this.showNotif("Upload de l'image en cours...", "info");
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('target', 'root');
                    try {
                        const res = await fetch('/api/upload', { method: 'POST', body: formData });
                        const data = await res.json();
                        if (data.success) {
                            formule.components.push({ type: 'rawImage', url: data.path, x: 0, y: 0, scale: 1, z: 1, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.1, rotation: 0 });
                            this.saveData();
                            this.showNotif("Image ajoutée avec succès !", "success");
                        }
                    } catch (e) { this.showNotif("Erreur upload", "error"); }
                },
                async handleUploadAndProcess(event, formule) {
                    const file = event.target.files[0];
                    if (!file) return;

                    this.showNotif("1/3 Upload de l'image...", "info");
                    const formData = new FormData();
                    formData.append('file', file);
                    formData.append('target', 'raw');

                    try {
                        // 1. Upload
                        const uploadRes = await fetch('/api/upload', { method: 'POST', body: formData });
                        const uploadData = await uploadRes.json();

                        if (uploadData.success) {
                            this.showNotif("2/3 Détourage par IA en cours (Veuillez patienter...)", "info");

                            // 2. Process
                            const processRes = await fetch('/api/process_images', { method: 'POST' });
                            const processData = await processRes.json();

                            if (processData.success) {
                                // 3. Ajouter l'asset et le composant
                                const rawFilename = uploadData.filename; // ex: burger.jpg
                                const baseName = rawFilename.substring(0, rawFilename.lastIndexOf('.')) || rawFilename;
                                const newId = 'ai_' + Date.now().toString().slice(-4);

                                const newAsset = {
                                    id: newId,
                                    name: baseName,
                                    url: 'processed_images/' + baseName + '.png'
                                };

                                this.menuData.assets.sandwiches.push(newAsset);
                                this.saveData();

                                // Ajouter direct à la formule
                                formule.components.push({ assetId: newId, type: 'main', x: 0, y: 0, scale: 1, z: 5, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.2, rotation: 0 });
                                this.showNotif("3/3 Succès ! L'image est ajoutée à votre écran.", "success");
                            } else {
                                this.showNotif("Erreur lors du détourage IA.", "error");
                            }
                        }
                    } catch (e) {
                        this.showNotif("Erreur serveur.", "error");
                    }
                    event.target.value = ''; // reset input
                },

                // --- Interaction Drag & Drop ---
                getComp(fKey, cKey) {
                    if (typeof cKey === 'number') return this.menuData.formules[fKey].components[cKey];
                    return this.menuData.formules[fKey][cKey];
                },
                isActive(fKey, cKey) {
                    return this.activeFormuleKey === fKey && this.activeCompIndex === cKey;
                },
                isSelected(fKey, cKey) {
                    return this.activeFormuleKey === fKey && this.multiSelect.includes(cKey);
                },
                moveLayer(fKey, layerKey, dir) {
                    let layers = this.getAllLayers(fKey);
                    let currentIdx = layers.findIndex(l => l.key === layerKey);
                    if (currentIdx === -1) return;

                    if (dir === 100) dir = currentIdx;
                    else if (dir === -100) dir = currentIdx - (layers.length - 1);

                    let newIdx = currentIdx - dir;
                    newIdx = Math.max(0, Math.min(layers.length - 1, newIdx));
                    if (newIdx !== currentIdx) {
                        let [moved] = layers.splice(currentIdx, 1);
                        layers.splice(newIdx, 0, moved);

                        layers.forEach((l, i) => {
                            l.comp.z = 50 - i;
                        });
                        this.saveData();
                    }
                },
                onTrackDragStart(event, fKey, layerKey) {
                    this.dragLayerFKey = fKey;
                    this.dragLayerIndex = layerKey;
                    event.dataTransfer.effectAllowed = 'move';
                },
                onTrackDrop(event, fKey, targetLayerKey) {
                    this.dragLayerHoverIndex = null;
                    if (this.dragLayerFKey !== fKey || this.dragLayerIndex === null) return;
                    if (this.dragLayerIndex === targetLayerKey) return;
                    if (this.dragLayerIndex === 'background' || targetLayerKey === 'background') return;

                    let layers = this.getAllLayers(fKey).filter(l => l.key !== 'background');
                    let sourceIdx = layers.findIndex(l => l.key === this.dragLayerIndex);
                    let targetIdx = layers.findIndex(l => l.key === targetLayerKey);

                    if (sourceIdx === -1 || targetIdx === -1) return;

                    let [moved] = layers.splice(sourceIdx, 1);
                    layers.splice(targetIdx, 0, moved);

                    layers.forEach((l, i) => {
                        l.clips.forEach(clip => {
                            clip.comp.z = 50 - i;
                        });
                    });

                    if (this.activeFormuleKey === fKey && this.activeCompIndex === this.dragLayerIndex) {
                        this.activeCompIndex = targetLayerKey;
                    }

                    this.dragLayerIndex = null;
                    this.saveData();
                },
                onTrackDragEnd() {
                    this.dragLayerIndex = null;
                    this.dragLayerHoverIndex = null;
                },
                setActive(fKey, cKey, shouldScroll = true, isMulti = false) {
                    this.activeFormuleKey = fKey;
                    this.activeCompIndex = cKey;

                    if (isMulti) {
                        const idx = this.multiSelect.indexOf(cKey);
                        if (idx === -1) {
                            this.multiSelect.push(cKey);
                        } else if (this.multiSelect.length > 1) {
                            this.multiSelect.splice(idx, 1);
                        }
                    } else {
                        if (!this.multiSelect.includes(cKey) || this.multiSelect.length <= 1) {
                            this.multiSelect = [cKey];
                        }
                    }

                    if (shouldScroll) {
                        // Auto-scroll to component card
                        setTimeout(() => {
                            let el = document.getElementById('comp-card-' + cKey);
                            if (!el && typeof cKey === 'string') {
                                // Fallback: it's a layout element, the single editor card might not have this ID yet if we just clicked it, wait for Vue to render
                                el = document.getElementById('comp-card-' + cKey);
                            }
                            if (el) {
                                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            }
                        }, 100);
                    }
                },
                startDrag(event, fKey, cKey) {
                    if (event.target.isContentEditable) return; // Prevent drag if editing text

                    this.setActive(fKey, cKey, true, event.ctrlKey || event.shiftKey);

                    const comp = this.getComp(fKey, cKey);
                    if (comp && comp.locked) return; // Prevent drag if locked

                    this.isDragging = true;
                    this.dragFKey = fKey; // Sauvegarder pour le drag
                    this.dragCKey = cKey;
                    this.startX = event.clientX;
                    this.startY = event.clientY;
                    this.initialCompX = comp.x;
                    this.initialCompY = comp.y;

                    this.multiDragStart = {};
                    this.multiSelect.forEach(idx => {
                        const c = this.getComp(fKey, idx);
                        if (c) {
                            this.multiDragStart[idx] = { x: c.x, y: c.y };
                        }
                    });

                    this.saveState();
                    window.addEventListener('mousemove', this.onDrag);
                    window.addEventListener('mouseup', this.stopDrag);
                },
                startResize(event, direction, targetType = 'component') {
                    this.isResizing = true;
                    this.resizeDirection = direction;
                    this.resizeTargetType = targetType;
                    this.startX = event.clientX;
                    this.startY = event.clientY;

                    if (targetType === 'component') {
                        const comp = this.getComp(this.activeFormuleKey, this.activeCompIndex);
                        if (comp) {
                            this.initialScale = comp.scale || 1;
                            this.initialScaleX = comp.scaleX || 1;
                            this.initialScaleY = comp.scaleY || 1;
                            this.initialWidth = comp.width || 0;
                            this.initialHeight = comp.height || 0;
                        }

                        this.multiResizeStart = {};
                        this.multiSelect.forEach(idx => {
                            const c = this.getComp(this.activeFormuleKey, idx);
                            if (c) {
                                this.multiResizeStart[idx] = { width: c.width || 0, height: c.height || 0, scale: c.scale || 1, scaleX: c.scaleX || 1, scaleY: c.scaleY || 1 };
                            }
                        });
                    } else if (targetType === 'timeline' || targetType === 'props') {
                        this.panelResizeStart = {
                            w: this.fsPanels[targetType].w,
                            h: this.fsPanels[targetType].h,
                            x: this.fsPanels[targetType].x,
                            y: this.fsPanels[targetType].y
                        };
                    }

                    this.saveState();
                    window.addEventListener('mousemove', this.onResize);
                    window.addEventListener('mouseup', this.stopResize);
                },
                onResize(event) {
                    if (!this.isResizing) return;
                    const dx = event.clientX - this.startX;
                    const dy = event.clientY - this.startY;

                    if (this.resizeTargetType === 'timeline' || this.resizeTargetType === 'props') {
                        const panel = this.fsPanels[this.resizeTargetType];
                        const start = this.panelResizeStart;
                        
                        if (this.resizeDirection.includes('e')) panel.w = Math.max(100, start.w + dx);
                        if (this.resizeDirection.includes('w')) {
                            panel.w = Math.max(100, start.w - dx);
                            panel.x = start.x + (start.w - panel.w);
                        }
                        if (this.resizeDirection.includes('s')) panel.h = Math.max(100, start.h + dy);
                        if (this.resizeDirection.includes('n')) {
                            panel.h = Math.max(100, start.h - dy);
                            panel.y = start.y + (start.h - panel.h);
                        }
                        return;
                    }

                    let factor = (this.menuData.orientation === 'vertical' ? 1 / 0.2531 : 1 / 0.45);
                    if (this.isFullscreenEditor) {
                        const baseW = this.menuData.orientation === 'vertical' ? 1080 : 1920;
                        const baseH = this.menuData.orientation === 'vertical' ? 1920 : 1080;
                        const scale = Math.min(window.innerWidth / baseW, window.innerHeight / baseH);
                        factor = 1 / scale;
                    }

                    this.multiSelect.forEach(idx => {
                        const comp = this.getComp(this.activeFormuleKey, idx);
                        const start = this.multiResizeStart[idx];
                        if (comp && start && !comp.locked) {
                            if (this.resizeDirection.length === 1) {
                                if (comp.type === 'shape') {
                                    // resize width/height of shape
                                    let newW = start.width;
                                    let newH = start.height;
                                    if (this.resizeDirection === 'e') newW += dx * factor;
                                    if (this.resizeDirection === 'w') newW -= dx * factor; // dragging left means increasing width
                                    if (this.resizeDirection === 's') newH += dy * factor;
                                    if (this.resizeDirection === 'n') newH -= dy * factor; // dragging up means increasing height

                                    comp.width = Math.max(10, Math.round(newW));
                                    comp.height = Math.max(10, Math.round(newH));
                                } else {
                                    // resize scaleX/scaleY of image/text
                                    let newScaleX = start.scaleX;
                                    let newScaleY = start.scaleY;
                                    if (this.resizeDirection === 'e') newScaleX += dx * factor * 0.002;
                                    if (this.resizeDirection === 'w') newScaleX -= dx * factor * 0.002;
                                    if (this.resizeDirection === 's') newScaleY += dy * factor * 0.002;
                                    if (this.resizeDirection === 'n') newScaleY -= dy * factor * 0.002;

                                    comp.scaleX = Math.max(0.1, Math.round(newScaleX * 100) / 100);
                                    comp.scaleY = Math.max(0.1, Math.round(newScaleY * 100) / 100);
                                }
                            } else {
                                // resize scale of other elements using corner handles
                                let delta = 0;
                                if (this.resizeDirection === 'se') delta = Math.max(dx, dy);
                                if (this.resizeDirection === 'nw') delta = Math.max(-dx, -dy);
                                if (this.resizeDirection === 'sw') delta = Math.max(-dx, dy);
                                if (this.resizeDirection === 'ne') delta = Math.max(dx, -dy);

                                let newScale = start.scale + (delta * factor * 0.002);
                                comp.scale = Math.max(0.1, Math.round(newScale * 100) / 100);
                            }
                        }
                    });
                },
                stopResize() {
                    this.isResizing = false;
                    window.removeEventListener('mousemove', this.onResize);
                    window.removeEventListener('mouseup', this.stopResize);
                    this.saveData();
                },
                onDrag(event) {
                    if (!this.isDragging) return;
                    const dx = event.clientX - this.startX;
                    const dy = event.clientY - this.startY;

                    let factor = (this.menuData.orientation === 'vertical' ? 1 / 0.2531 : 1 / 0.45);
                    if (this.isFullscreenEditor) {
                        const baseW = this.menuData.orientation === 'vertical' ? 1080 : 1920;
                        const baseH = this.menuData.orientation === 'vertical' ? 1920 : 1080;
                        const scale = Math.min(window.innerWidth / baseW, window.innerHeight / baseH);
                        factor = 1 / scale;
                    }

                    this.multiSelect.forEach(idx => {
                        const comp = this.getComp(this.dragFKey, idx);
                        const start = this.multiDragStart[idx];
                        if (comp && start && !comp.locked) {
                            comp.x = Math.round(start.x + (dx * factor));
                            comp.y = Math.round(start.y + (dy * factor));
                        }
                    });
                },
                stopDrag() {
                    this.isDragging = false;
                    this.dragFKey = null;
                    this.dragCKey = null;
                    window.removeEventListener('mousemove', this.onDrag);
                    window.removeEventListener('mouseup', this.stopDrag);
                },
                toggleFillScreen(comp) {
                    if (!comp.fillScreen) {
                        comp.fillScreen = true;
                        comp.scale = 1;
                        comp.rotation = 0;
                        comp.x = 0;
                        // Center vertically: 190 for horizontal, 610 for vertical (relative to origin offset)
                        comp.y = this.menuData.orientation === 'vertical' ? 610 : 190;
                    } else {
                        comp.fillScreen = false;
                    }
                },

                handleScrollZoom(e, fKey, cKey) {
                    if (this.activeFormuleKey !== fKey || this.activeCompIndex !== cKey) return;

                    const comp = this.getComp(fKey, cKey);

                    if (e.shiftKey) {
                        const delta = e.deltaY > 0 ? -5 : 5;
                        let newRot = (comp.rotation || 0) + delta;
                        if (newRot > 180) newRot = -180 + (newRot - 180);
                        if (newRot < -180) newRot = 180 - (-180 - newRot);
                        comp.rotation = newRot;
                    } else {
                        const delta = e.deltaY > 0 ? -0.1 : 0.1;
                        let newScale = (comp.scale || 1) + delta;
                        newScale = Math.max(0.1, Math.min(3, newScale));
                        comp.scale = Math.round(newScale * 10) / 10;
                    }
                },
                promptImageReplacement(event, fKey, cKey) {
                    this.replaceTarget = { fKey, cKey };
                    this.$refs.replaceImageInput.click();
                },
                async handleReplaceImage(event) {
                    const file = event.target.files[0];
                    if (!file) return;

                    if (!this.replaceTarget) return;

                    const removeBg = confirm("Voulez-vous détourez l'image ? (Supprimer l'arrière-plan avec l'IA)\n\nOK = Oui, détourez l'image\nAnnuler = Non, garder l'image telle quelle");

                    const formule = this.menuData.formules[this.replaceTarget.fKey];
                    const comp = formule.components[this.replaceTarget.cKey];

                    if (removeBg) {
                        this.showNotif("1/3 Upload de l'image pour détourage...", "info");
                        const formData = new FormData();
                        formData.append('file', file);
                        formData.append('target', 'raw');
                        try {
                            const uploadRes = await fetch('/api/upload', { method: 'POST', body: formData });
                            const uploadData = await uploadRes.json();
                            if (uploadData.success) {
                                this.showNotif("2/3 Détourage par IA en cours (Veuillez patienter...)", "info");
                                const processRes = await fetch('/api/process_images', { method: 'POST' });
                                const processData = await processRes.json();

                                if (processData.success) {
                                    this.showNotif("3/3 Mise à jour de l'image...", "success");
                                    await this.fetchData();
                                    const newAssets = this.menuData.assets.sandwiches;
                                    const latestAsset = newAssets[newAssets.length - 1];
                                    if (latestAsset) {
                                        comp.assetId = latestAsset.id;
                                        comp.type = 'main';
                                        this.saveData();
                                    }
                                }
                            }
                        } catch (e) {
                            this.showNotif("Erreur lors du remplacement", "error");
                        }
                    } else {
                        this.showNotif("Upload de l'image...", "info");
                        const formData = new FormData();
                        formData.append('file', file);
                        formData.append('target', 'root');
                        try {
                            const uploadRes = await fetch('/api/upload', { method: 'POST', body: formData });
                            const uploadData = await uploadRes.json();

                            if (uploadData.success) {
                                comp.type = 'rawImage';
                                comp.url = uploadData.path;
                                delete comp.assetId;
                                this.saveData();
                                this.showNotif("Image remplacée avec succès !", "success");
                            }
                        } catch (e) {
                            this.showNotif("Erreur upload", "error");
                        }
                    }

                    event.target.value = '';
                    this.replaceTarget = null;
                },
                promptTextEdit(event, fKey, cKey) {
                    const el = event.target;
                    const comp = this.getComp(fKey, cKey);

                    const isLayoutKey = ['nameLayout', 'descLayout', 'badgeLayout', 'priceLayout'].includes(cKey);
                    if (comp.type !== 'customText' && comp.type !== 'shape' && !isLayoutKey) return;

                    el.contentEditable = "true";
                    el.focus();

                    const selection = window.getSelection();
                    const range = document.createRange();
                    range.selectNodeContents(el);
                    selection.removeAllRanges();
                    selection.addRange(range);

                    el.onblur = () => {
                        el.contentEditable = "false";
                        if (cKey === 'nameLayout') this.menuData.formules[fKey].name = el.innerHTML;
                        else if (cKey === 'descLayout') this.menuData.formules[fKey].description = el.innerHTML;
                        else if (cKey === 'badgeLayout') this.menuData.formules[fKey].badge = el.innerHTML;
                        else if (cKey === 'priceLayout') this.menuData.formules[fKey].price = el.innerHTML;
                        else comp.content = el.innerHTML;
                        window.getSelection().removeAllRanges();
                    };

                    el.onkeydown = (e) => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            el.blur();
                        }
                    };
                },
                exitAllFullscreen(fKey) {
                    // 1. Exit editor fullscreen if active
                    if (this.isFullscreenEditor) {
                        this.isFullscreenEditor = false;
                        document.body.classList.remove('editor-fullscreen');
                        try { document.exitFullscreen(); } catch (e) {}
                    }

                    // 2. Exit mockup fake-fullscreen if active
                    const el = document.getElementById('mockup-wrapper-' + fKey);
                    if (el && el.classList.contains('fake-fullscreen')) {
                        el.classList.remove('fake-fullscreen');
                    }

                    // 3. Exit native fullscreen if active
                    const isFullscreenAPI = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
                    if (isFullscreenAPI) {
                        if (document.exitFullscreen) {
                            document.exitFullscreen().catch(()=>{});
                        } else if (document.webkitExitFullscreen) {
                            document.webkitExitFullscreen();
                        } else if (document.mozCancelFullScreen) {
                            document.mozCancelFullScreen();
                        } else if (document.msExitFullscreen) {
                            document.msExitFullscreen();
                        }
                    }
                },
                scrollToPreview() {
                    let fKeyToScroll = this.activeFormuleKey;
                    if (!fKeyToScroll && this.menuData && this.menuData.formules) {
                        fKeyToScroll = Object.keys(this.menuData.formules)[0];
                    }
                    if (fKeyToScroll) {
                        const el = document.getElementById('mockup-wrapper-' + fKeyToScroll);
                        if (el) {
                            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                    }
                },
                showLayersPanel() {
                    // Flash the timeline or scroll to it
                    const timeline = document.querySelector('.timeline-container');
                    if (!timeline) {
                        // try generic timeline selector if class missing
                        const altTimeline = document.querySelector('.flex-1.bg-slate-800.rounded');
                        if (altTimeline) altTimeline.scrollIntoView({ behavior: 'smooth' });
                        return;
                    }
                    timeline.scrollIntoView({ behavior: 'smooth' });
                    timeline.style.boxShadow = '0 0 0 4px #8b5cf6';
                    setTimeout(() => timeline.style.boxShadow = '', 1000);
                },
                deleteComponentDirect(fKey, layerKey) {
                    this.saveState();
                    if (typeof layerKey === 'string' && layerKey.startsWith('comp_')) {
                        let f = this.menuData.formules[fKey];
                        f.components = f.components.filter((c, i) => (c.trackId || 'comp_'+i) !== layerKey);
                        this.activeCompIndex = null;
                    } else if (typeof layerKey === 'string') {
                        this.menuData.formules[fKey][layerKey] = null;
                        if (layerKey === 'nameLayout') this.menuData.formules[fKey].name = '';
                        if (layerKey === 'descLayout') this.menuData.formules[fKey].description = '';
                        if (layerKey === 'badgeLayout') this.menuData.formules[fKey].badge = '';
                        if (layerKey === 'priceLayout') this.menuData.formules[fKey].price = '';

                        if (this.activeCompIndex === layerKey) this.activeCompIndex = null;
                    } else if (this.menuData.formules[fKey].components[layerKey]) {
                        this.menuData.formules[fKey].components.splice(layerKey, 1);
                        if (this.activeCompIndex === layerKey) this.activeCompIndex = null;
                    }
                    this.saveData();
                },
                deleteActiveComponent(fKey) {
                    if (this.activeCompIndex !== null) {
                        this.deleteComponentDirect(fKey, this.activeCompIndex);
                    }
                },
                duplicateComponent(fKey, cIdx) {
                    this.saveState();
                    const comp = this.menuData.formules[fKey].components[cIdx];
                    const newComp = JSON.parse(JSON.stringify(comp)); // Deep clone
                    newComp.x += 30; // Offset slightly
                    newComp.y += 30;
                    this.menuData.formules[fKey].components.push(newComp);
                    this.activeCompIndex = this.menuData.formules[fKey].components.length - 1;
                },
                applyScaleToAll(fKey, cIdx, type) {
                    const sourceComp = this.getComp(fKey, cIdx);
                    if (!sourceComp) return;
                    this.saveState();
                    this.menuData.formules[fKey].components.forEach(comp => {
                        if (comp.type === type && comp !== sourceComp) {
                            if (sourceComp.scale !== undefined) comp.scale = sourceComp.scale;
                            if (sourceComp.scaleX !== undefined) comp.scaleX = sourceComp.scaleX;
                            if (sourceComp.scaleY !== undefined) comp.scaleY = sourceComp.scaleY;
                            if (sourceComp.width !== undefined) comp.width = sourceComp.width;
                            if (sourceComp.height !== undefined) comp.height = sourceComp.height;
                            if (sourceComp.fontSize !== undefined) comp.fontSize = sourceComp.fontSize;
                        }
                    });
                    this.saveData();
                },
                applyStyleToAll(fKey, cIdx, type) {
                    const sourceComp = this.getComp(fKey, cIdx);
                    if (!sourceComp) return;
                    this.saveState();
                    this.menuData.formules[fKey].components.forEach(comp => {
                        if (comp.type === type && comp !== sourceComp) {
                            if (sourceComp.color !== undefined) comp.color = sourceComp.color;
                            if (sourceComp.color2 !== undefined) comp.color2 = sourceComp.color2;
                            if (sourceComp.isGradient !== undefined) comp.isGradient = sourceComp.isGradient;
                            if (sourceComp.gradientAngle !== undefined) comp.gradientAngle = sourceComp.gradientAngle;
                            if (sourceComp.opacity !== undefined) comp.opacity = sourceComp.opacity;
                            if (sourceComp.textColor !== undefined) comp.textColor = sourceComp.textColor;
                            if (sourceComp.textEffect !== undefined) comp.textEffect = sourceComp.textEffect;
                            if (sourceComp.fontFamily !== undefined) comp.fontFamily = sourceComp.fontFamily;
                            if (sourceComp.borderRadius !== undefined) comp.borderRadius = sourceComp.borderRadius;
                            if (sourceComp.shapeType !== undefined) comp.shapeType = sourceComp.shapeType;
                            if (sourceComp.strokeColor !== undefined) comp.strokeColor = sourceComp.strokeColor;
                            if (sourceComp.hasShadow !== undefined) comp.hasShadow = sourceComp.hasShadow;
                        }
                    });
                    this.saveData();
                },
                async askAIAssistant(fKey, formule) {
                    if (!formule.aiPrompt || formule.aiPrompt.trim() === '') return;

                    this.showNotif("L'IA analyse votre demande et modifie l'écran...", "info");
                    formule.isGeneratingIA = true;

                    try {
                        const res = await fetch('/api/designer_edit', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                prompt: formule.aiPrompt,
                                formula: formule,
                                assets: this.menuData.assets
                            })
                        });

                        const data = await res.json();
                        if (data.success) {
                            this.saveState();
                            this.menuData.formules[fKey] = data.formula;
                            this.menuData.formules[fKey].aiPrompt = '';
                            this.saveData();
                            this.showNotif("L'écran a été modifié avec succès !", "success");
                        } else {
                            this.showNotif("Erreur IA: " + data.error, "error");
                        }
                    } catch (e) {
                        this.showNotif("Erreur de connexion avec l'IA.", "error");
                    } finally {
                        formule.isGeneratingIA = false;
                    }
                },
                saveState() {
                    const snapshot = JSON.stringify(this.menuData.formules);
                    this.history.push(snapshot);
                    if (this.history.length > 20) this.history.shift();
                },
                undo() {
                    if (this.history.length > 0) {
                        const previousState = this.history.pop();
                        this.menuData.formules = JSON.parse(previousState);
                        this.activeCompIndex = null;
                        this.showNotif("Action annulée (Ctrl+Z)", "info");
                    }
                },
                handleKeydown(e) {
                    // Spacebar to Play/Pause Timeline (Works even if SELECT is focused)
                    if (e.code === 'Space' || e.key === ' ') {
                        // Allow typing space in input fields
                        if (['INPUT', 'TEXTAREA'].includes(e.target.tagName)) return;

                        e.preventDefault();
                        if (e.target.tagName === 'SELECT') {
                            e.target.blur(); // Remove focus from select so it doesn't stay highlighted
                        }
                        if (this.currentTab) {
                            this.togglePlayPreview(this.currentTab);
                        }
                        return;
                    }

                    // For other shortcuts (arrows, delete), ignore if user is in an input or dropdown
                    if (['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) return;


                    // Arrow Keys logic for moving selected object
                    if (this.activeFormuleKey && this.activeCompIndex !== null) {
                        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
                            e.preventDefault(); // Prevent scroll immediately
                            const step = e.shiftKey ? 10 : 1;
                            let comp = this.getComp(this.activeFormuleKey, this.activeCompIndex);
                            if (comp) {
                                if (e.key === 'ArrowUp') comp.y -= step;
                                else if (e.key === 'ArrowDown') comp.y += step;
                                else if (e.key === 'ArrowLeft') comp.x -= step;
                                else if (e.key === 'ArrowRight') comp.x += step;

                                // Debounce saveData so it doesn't freeze the browser
                                clearTimeout(this._saveTimeout);
                                this._saveTimeout = setTimeout(() => {
                                    this.saveData();
                                }, 300);
                                return;
                            }
                        }
                        if (e.key === 'Delete' || e.key === 'Backspace') {
                            e.preventDefault();
                            this.deleteActiveComponent(this.activeFormuleKey);
                            return;
                        }
                    }

                    if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
                        e.preventDefault();
                        this.undo();
                        return;
                    }

                    if ((e.ctrlKey || e.metaKey) && e.key === 'c') {
                        if (this.activeFormuleKey && this.activeCompIndex !== null) {
                            e.preventDefault();
                            this.copyComponent(this.activeFormuleKey, this.activeCompIndex);
                        }
                        return;
                    }

                    if ((e.ctrlKey || e.metaKey) && e.key === 'v') {
                        if (this.activeFormuleKey && this.clipboardData) {
                            e.preventDefault();
                            this.pasteComponent(this.activeFormuleKey);
                        }
                        return;
                    }

                    if (e.code === 'KeyT') {
                        e.preventDefault();
                        this.isFreeTransformMode = !this.isFreeTransformMode;
                        this.showNotif("Mode Transformation Libre " + (this.isFreeTransformMode ? "Activé" : "Désactivé"), "info");
                        return;
                    }

                    if (e.code === 'Space' && this.currentTab === 'tv2' && this.activeFormuleKey) {
                        e.preventDefault();
                        this.playPreview(this.activeFormuleKey);
                    }

                    if ((e.code === 'Delete' || e.code === 'Backspace') && this.activeFormuleKey && this.activeCompIndex !== null) {
                        e.preventDefault();
                        this.deleteActiveComponent(this.activeFormuleKey);
                    }
                },
                copyComponent(fKey, cIdx) {
                    if (typeof cIdx === 'string') {
                        const layout = this.menuData.formules[fKey][cIdx];
                        if (layout) {
                            let contentStr = '';
                            if (cIdx === 'nameLayout') contentStr = this.menuData.formules[fKey].name;
                            else if (cIdx === 'descLayout') contentStr = this.menuData.formules[fKey].description;
                            else if (cIdx === 'badgeLayout') contentStr = this.menuData.formules[fKey].badge;
                            else if (cIdx === 'priceLayout') contentStr = this.menuData.formules[fKey].price + ' DH';

                            this.clipboardData = {
                                type: 'customText',
                                content: contentStr,
                                x: layout.x || 0,
                                y: layout.y || 0,
                                scale: layout.scale || 1,
                                z: layout.z || 50,
                                rotation: layout.rotation || 0,
                                color: layout.color || '#ffffff',
                                fontSize: cIdx === 'nameLayout' ? 90 : (cIdx === 'priceLayout' ? 85 : 40),
                                fontFamily: 'Impact',
                                hasShadow: true,
                                animIn: layout.animIn || 'fadeUp',
                                animOut: layout.animOut || 'fadeDown',
                                delay: layout.delay || 0.1,
                                continuousAnim: layout.continuousAnim || 'none'
                            };
                            this.showNotif("Texte (" + cIdx.replace('Layout', '') + ") copié !", "success");
                        }
                    } else {
                        const comp = this.menuData.formules[fKey].components[cIdx];
                        if (comp) {
                            this.clipboardData = JSON.parse(JSON.stringify(comp)); // deep clone
                            this.showNotif("Composant copié ! (Ctrl+V pour coller)", "success");
                        }
                    }
                },
                pasteComponent(fKey) {
                    if (this.clipboardData) {
                        this.saveState();
                        const newComp = JSON.parse(JSON.stringify(this.clipboardData));
                        newComp.x += 30; // offset
                        newComp.y += 30;
                        this.menuData.formules[fKey].components.push(newComp);
                        this.activeCompIndex = this.menuData.formules[fKey].components.length - 1;
                        this.showNotif("Composant collé !", "success");
                    }
                },
                handleContextMenu(e, fKey, cIdx) {
                    this.contextMenu = {
                        visible: true,
                        x: e.clientX,
                        y: e.clientY,
                        fKey: fKey,
                        cIdx: cIdx
                    };
                    if (cIdx !== null) {
                        this.setActive(fKey, cIdx);
                    }
                },
                hideContextMenu() {
                    this.contextMenu.visible = false;
                },
                contextCopy() {
                    this.copyComponent(this.contextMenu.fKey, this.contextMenu.cIdx);
                    this.hideContextMenu();
                },
                contextPaste() {
                    this.pasteComponent(this.contextMenu.fKey);
                    this.hideContextMenu();
                },
                contextDuplicate() {
                    this.duplicateComponent(this.contextMenu.fKey, this.contextMenu.cIdx);
                    this.hideContextMenu();
                },
                contextDelete() {
                    this.deleteActiveComponent(this.contextMenu.fKey);
                    this.hideContextMenu();
                },
                getAnimOffset(type, comp = null) {
                    const config = { x: 0, y: 0, scale: 1, opacity: 0 };
                    const dist = 300;
                    
                    if (type === 'custom' && comp) {
                        config.x = comp.animStartX !== undefined ? comp.animStartX : 0;
                        config.y = comp.animStartY !== undefined ? comp.animStartY : 0;
                        config.scale = comp.animStartScale !== undefined ? comp.animStartScale : 1;
                        config.rotationOffset = comp.animStartRotation !== undefined ? comp.animStartRotation : 0;
                        // Support custom exit animation by using End variables when isOut is implicitly expected
                        // Actually, getAnimOffset is used for both. I will check animEndX if type is custom out.
                        return config;
                    }

                    switch (type) {
                        case 'fadeUp': config.y = dist; break;
                        case 'fadeDown': config.y = -dist; break;
                        case 'fadeLeft': config.x = dist; break;
                        case 'fadeRight': config.x = -dist; break;
                        case 'zoomIn': config.scale = 0; break;
                        case 'zoomOut': config.scale = 2; break;
                        case 'fade': break; // Opacity only
                        case 'pop': config.scale = 0.5; break;
                        case 'drop': config.y = -700; break;
                        case 'rollIn': config.rotationOffset = -180; config.scale = 0; break;
                        case 'driftLeft': config.x = 100; break;
                        case 'driftRight': config.x = -100; break;
                        default: config.y = 50; break;
                    }
                    return config;
                },
                formatTime(val) {
                    return Number(val).toFixed(1);
                },
                displayTime(val) {
                    const num = Number(val);
                    if (num >= 60) {
                        const m = Math.floor(num / 60);
                        const s = (num % 60).toFixed(1);
                        return m + 'm ' + (s < 10 ? '0' : '') + s + 's';
                    }
                    return num.toFixed(1) + 's';
                },
                scrubTimeline() {
                    if (this.playingTimeline) {
                        this.playingTimeline.pause();
                        this.isPlaying = false;
                        this.playingTimeline.progress(this.previewProgress / 100);
                    }
                },
                togglePlayPreview(fKey) {
                    if (this.playingTimeline) {
                        if (this.isPlaying) {
                            this.playingTimeline.pause();
                            this.isPlaying = false;
                        } else {
                            if (this.previewProgress >= 100) {
                                this.playingTimeline.restart();
                            } else {
                                this.playingTimeline.play();
                            }
                            this.isPlaying = true;
                        }
                    } else {
                        this.playPreview(fKey);
                    }
                },
                playPreview(fKey) {
                    if (this.playingTimeline) {
                        this.playingTimeline.kill();
                    }
                    const view = document.getElementById('mockup-' + fKey);
                    if (!view) return;

                    const tl = gsap.timeline({
                        onUpdate: () => {
                            if (this.playingTimeline) {
                                this.previewProgress = this.playingTimeline.progress() * 100;
                            }
                        },
                        onComplete: () => {
                            this.isPlaying = false;
                            this.previewProgress = 100;

                            // Reset components
                            const formule = this.menuData.formules[fKey];
                            if (formule.components) {
                                formule.components.forEach((c, i) => gsap.set(document.getElementById('mockup-anim-' + fKey + '-' + i), { clearProps: 'all' }));
                            }
                            ['nameLayout', 'descLayout', 'badgeLayout', 'priceLayout'].forEach(t => {
                                if (formule[t]) gsap.set(document.getElementById('mockup-anim-' + fKey + '-' + t), { clearProps: 'all' });
                            });
                        }
                    });

                    this.playingTimeline = tl;
                    this.isPlaying = true;
                    this.previewProgress = 0;

                    const formule = this.menuData.formules[fKey];
                    const duration = formule.duration || 6;

                    tl.to({}, { duration: duration });

                    if (formule.components) {
                        formule.components.forEach((comp, cIdx) => {
                            const item = document.getElementById('mockup-anim-' + fKey + '-' + cIdx);
                            if (!item) return;

                            const rotation = comp.rotation || 0;
                            const delay = comp.delay || 0;
                            const exitTime = comp.exitTime || duration;

                            if (comp.animIn === 'none') {
                                tl.set(item, { opacity: 1, x: 0, y: 0, scale: 1, rotation: rotation }, delay);
                            } else {
                                const fromOffset = this.getAnimOffset(comp.animIn, comp);
                                tl.fromTo(item,
                                    { x: fromOffset.x, y: fromOffset.y, scale: fromOffset.scale, opacity: 0, rotation: (fromOffset.rotationOffset !== undefined ? rotation + fromOffset.rotationOffset : rotation) },
                                    { x: 0, y: 0, scale: 1, opacity: 1, rotation: rotation, duration: 1.5, ease: "back.out(1.2)" },
                                    delay
                                );
                            }

                            if (exitTime < duration) {
                                if (comp.animOut === 'none') {
                                    tl.set(item, { opacity: 0 }, exitTime);
                                } else {
                                    const outOffset = this.getAnimOffset(comp.animOut || 'zoomOut', Object.assign({}, comp, { animStartX: comp.animEndX, animStartY: comp.animEndY, animStartScale: comp.animEndScale, animStartRotation: comp.animEndRotation }));
                                    tl.to(item, {
                                        x: outOffset.x, y: outOffset.y, scale: outOffset.scale, opacity: 0, duration: 1, ease: "power2.in"
                                    }, exitTime);
                                }
                            }
                        });
                    }

                    ['nameLayout', 'descLayout', 'badgeLayout', 'priceLayout'].forEach(tKey => {
                        if (formule[tKey]) {
                            const layout = formule[tKey];
                            const item = document.getElementById('mockup-anim-' + fKey + '-' + tKey);
                            if (!item) return;

                            const fromOffset = this.getAnimOffset(layout.animIn, layout);
                            const rotation = layout.rotation || 0;
                            const delay = layout.delay || 0;
                            const exitTime = layout.exitTime || duration;

                            tl.fromTo(item,
                                { x: fromOffset.x, y: fromOffset.y, scale: fromOffset.scale, opacity: 0, rotation: (fromOffset.rotationOffset !== undefined ? rotation + fromOffset.rotationOffset : rotation) },
                                { x: 0, y: 0, scale: 1, opacity: 1, rotation: rotation, duration: 1.5, ease: "back.out(1.2)" },
                                delay
                            );

                            if (exitTime < duration) {
                                const outOffset = this.getAnimOffset(layout.animOut || 'zoomOut', Object.assign({}, layout, { animStartX: layout.animEndX, animStartY: layout.animEndY, animStartScale: layout.animEndScale, animStartRotation: layout.animEndRotation }));
                                tl.to(item, {
                                    x: outOffset.x, y: outOffset.y, scale: outOffset.scale, opacity: 0, duration: 1, ease: "power2.in"
                                }, exitTime);
                            }
                        }
                    });
                },
                previewSingleAnim(fKey, cIdx, isOut = false) {
                    const item = document.getElementById('mockup-anim-' + fKey + '-' + cIdx);
                    if (!item) return;

                    gsap.killTweensOf(item);
                    let comp;
                    if (typeof cIdx === 'string') {
                        comp = this.menuData.formules[fKey][cIdx];
                    } else {
                        comp = this.menuData.formules[fKey].components[cIdx];
                    }
                    if (!comp) return;

                    const rotation = comp.rotation || 0;

                    if (!isOut) {
                        if (comp.animIn === 'none') {
                            gsap.set(item, { opacity: 1, x: 0, y: 0, scale: 1, rotation: rotation });
                        } else {
                            const fromOffset = this.getAnimOffset(comp.animIn, comp);
                            gsap.fromTo(item,
                                { x: fromOffset.x, y: fromOffset.y, scale: fromOffset.scale, opacity: 0, rotation: (fromOffset.rotationOffset !== undefined ? rotation + fromOffset.rotationOffset : rotation) },
                                { x: 0, y: 0, scale: 1, opacity: 1, rotation: rotation, duration: 1.5, ease: "back.out(1.2)" }
                            );
                        }
                    } else {
                        if (comp.animOut === 'none') {
                            gsap.set(item, { opacity: 0 });
                        } else {
                            const outOffset = this.getAnimOffset(comp.animOut || 'zoomOut', Object.assign({}, comp, { animStartX: comp.animEndX, animStartY: comp.animEndY, animStartScale: comp.animEndScale, animStartRotation: comp.animEndRotation }));
                            gsap.fromTo(item,
                                { x: 0, y: 0, scale: 1, opacity: 1, rotation: rotation },
                                { x: outOffset.x, y: outOffset.y, scale: outOffset.scale, opacity: 0, duration: 1, ease: "power2.in", onComplete: () => {
                                    gsap.set(item, { clearProps: 'all' });
                                }}
                            );
                        }
                    }
                },
                getMaskStyle(comp) {
                    if (!comp.maskType) return 'none';
                    const strength = comp.maskStrength !== undefined ? comp.maskStrength : 50;
                    const solidPoint = Math.max(0, 100 - strength);
                    
                    switch (comp.maskType) {
                        case 'bottom': return `linear-gradient(to bottom, black ${solidPoint}%, transparent 100%)`;
                        case 'top': return `linear-gradient(to top, black ${solidPoint}%, transparent 100%)`;
                        case 'left': return `linear-gradient(to left, black ${solidPoint}%, transparent 100%)`;
                        case 'right': return `linear-gradient(to right, black ${solidPoint}%, transparent 100%)`;
                        case 'radial': return `radial-gradient(circle, black ${solidPoint}%, transparent 100%)`;
                        default: return 'none';
                    }
                },

                async uploadAssetFile(event, asset) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const formData = new FormData(); formData.append('file', file); formData.append('target', 'raw');
                    try {
                        const res = await fetch('/api/upload', { method: 'POST', body: formData });
                        const data = await res.json();
                        if (data.success) { asset.url = `processed_images/${data.filename}`; }
                    } catch (e) { }
                },
                async generateDesign() {
                    if (!this.aiPrompt.trim()) return;

                    this.isGenerating = true;
                    this.showNotif("L'IA réfléchit au design...", "info");

                    try {
                        const res = await fetch('/api/designer', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                prompt: this.aiPrompt,
                                assets: this.menuData.assets
                            })
                        });

                        const data = await res.json();

                        if (data.success && data.formula) {
                            const newKey = 'gen_' + Date.now().toString().slice(-6);
                            this.menuData.formules[newKey] = data.formula;
                            this.activeFormuleKey = newKey;
                            this.currentTab = 'ecran';
                            this.aiPrompt = '';
                            this.showNotif("✨ Design généré avec succès !");

                            // Play animation shortly after Vue renders the new DOM
                            setTimeout(() => {
                                this.playPreview(newKey);
                            }, 500);
                        } else {
                            this.showNotif(data.error || "Erreur lors de la génération", "error");
                        }
                    } catch (e) {
                        this.showNotif("Erreur de connexion à l'IA", "error");
                    } finally {
                        this.isGenerating = false;
                    }
                },
                async generateDesignFromImage(event) {
                    const file = event.target.files[0];
                    if (!file) return;

                    this.isGenerating = true;
                    this.showNotif("L'IA de Vision analyse votre image...", "info");

                    try {
                        const reader = new FileReader();
                        reader.onload = async (e) => {
                            const base64Image = e.target.result;

                            const res = await fetch('/api/vision_designer', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    image: base64Image,
                                    assets: this.menuData.assets
                                })
                            });

                            const data = await res.json();

                            if (data.success && data.formula) {
                                // Upload image for background
                                let bgImagePath = null;
                                try {
                                    const formData = new FormData();
                                    formData.append('file', file);
                                    const uploadRes = await fetch('/api/upload', {
                                        method: 'POST',
                                        body: formData
                                    });
                                    const uploadData = await uploadRes.json();
                                    if (uploadData.success) {
                                        bgImagePath = uploadData.path;
                                    }
                                } catch (e) {
                                    console.error("Bg upload failed", e);
                                }

                                const newKey = 'clone_' + Date.now().toString().slice(-6);
                                if (bgImagePath) {
                                    data.formula.bgImage = bgImagePath;
                                }
                                this.menuData.formules[newKey] = data.formula;
                                this.activeFormuleKey = newKey;
                                this.currentTab = 'ecran';
                                this.showNotif("✨ Design cloné avec succès !");
                                this.saveData();

                                setTimeout(() => {
                                    this.playPreview(newKey);
                                }, 500);
                            } else {
                                this.showNotif(data.error || "Erreur lors du clonage", "error");
                            }
                            this.isGenerating = false;
                        };
                        reader.readAsDataURL(file);
                    } catch (err) {
                        this.showNotif("Erreur lors de la lecture de l'image", "error");
                        this.isGenerating = false;
                    }

                    // Reset input
                    event.target.value = '';
                },
                async processImages() {
                    this.showNotif("L'IA nettoie les images...", "success");
                    try {
                        const res = await fetch('/api/process_images', { method: 'POST' });
                        const data = await res.json();
                        if (data.success) this.showNotif("Traitement terminé !");
                    } catch (e) { }
                }
            }
        }).mount('#app')
    </script>
</body>

</html>