                        newFormule.components.push({ type: 'customText', content: 'ORDER NOW', x: 0, y: 400, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.9, rotation: 0, color: '#ff0000', fontSize: 40, fontFamily: "'Inter', sans-serif", hasShadow: false });
