                        newFormule.components.push({ type: 'customText', content: '50%', x: 350, y: -100, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.6, rotation: -10, color: '#d50000', fontSize: 70, fontFamily: "'Oswald', sans-serif", hasShadow: false });
                        newFormule.components.push({ type: 'customText', content: 'OFF', x: 350, y: -40, scale: 1, z: 15, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.7, rotation: -10, color: '#000000', fontSize: 50, fontFamily: "'Oswald', sans-serif", hasShadow: false });
                    }
                    else if (type === 'list') {
                        // Digital Board List Style: Image top, elegant list below
                        newFormule.bgColor = "#050505";

                        newFormule.components.push({ assetId: firstSandwich, type: 'main', x: 0, y: -250, scale: 1.2, z: 5, animIn: 'zoomIn', animOut: 'zoomOut', delay: 0.1, rotation: 0 });

                        newFormule.components.push({ type: 'customText', content: 'NOS SPÉCIALITÉS', x: 0, y: 50, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.3, rotation: 0, color: '#ffb300', fontSize: 70, fontFamily: "'Oswald', sans-serif", hasShadow: false });

                        newFormule.components.push({ type: 'customText', content: 'Classic Burger .................................... 35 DH', x: 0, y: 150, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.4, rotation: 0, color: '#ffffff', fontSize: 45, fontFamily: "'Inter', sans-serif", hasShadow: false });
                        newFormule.components.push({ type: 'customText', content: 'Cheese Burger .................................... 45 DH', x: 0, y: 220, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.5, rotation: 0, color: '#ffffff', fontSize: 45, fontFamily: "'Inter', sans-serif", hasShadow: false });
                        newFormule.components.push({ type: 'customText', content: 'Double Burger .................................... 60 DH', x: 0, y: 290, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.6, rotation: 0, color: '#ffffff', fontSize: 45, fontFamily: "'Inter', sans-serif", hasShadow: false });
                        newFormule.components.push({ type: 'customText', content: 'Chicken Burger ................................... 50 DH', x: 0, y: 360, scale: 1, z: 15, animIn: 'fadeUp', animOut: 'fadeDown', delay: 0.7, rotation: 0, color: '#ffffff', fontSize: 45, fontFamily: "'Inter', sans-serif", hasShadow: false });

