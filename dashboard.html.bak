                        newFormule.components.push({ type: 'customText', content: 'DELICIOUS', x: 100, y: -250, scale: 1, z: 14, animIn: 'fadeDown', animOut: 'fadeUp', delay: 0.3, rotation: 0, color: '#ffea00', fontSize: 160, fontFamily: "'Oswald', sans-serif", hasShadow: true, strokeColor: '#d50000' });

